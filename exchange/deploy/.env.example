# Піддомен для біржі (A-запис DNS має вказувати на IP сервера), напр. exchange.medluxlife.com
DOMAIN=exchange.example.com

# Пароль для /admin.html (довгий випадковий рядок)
ADMIN_TOKEN=change-me-to-a-long-random-string

# Брокер ліквідності: реальні ціни ф'ючерсів Binance + дублювання позицій на демо-рахунок Binance Futures Testnet.
# Ключі: https://testnet.binancefuture.com → зареєструватись → API Key
BROKER=binance
BINANCE_API_KEY=
BINANCE_API_SECRET=
