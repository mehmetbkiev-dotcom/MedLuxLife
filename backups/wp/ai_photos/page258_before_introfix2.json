{"id":258,"date":"2026-10-01T15:41:54","date_gmt":"2026-10-01T15:41:54","guid":{"rendered":"https:\/\/medluxlife.de\/health\/clinical-treatments\/","raw":"https:\/\/medluxlife.de\/health\/clinical-treatments\/"},"modified":"2026-10-10T11:13:49","modified_gmt":"2026-10-10T11:13:49","password":"","slug":"clinical-treatments","status":"publish","type":"page","link":"https:\/\/medluxlife.de\/health\/clinical-treatments\/","title":{"raw":"Clinical Treatments","rendered":"Clinical Treatments"},"content":{"raw":"<!-- wp:columns {\"verticalAlignment\":\"center\",\"className\":\"medlux-intro\"} -->\n<div class=\"wp-block-columns are-vertically-aligned-center medlux-intro\"><!-- wp:column {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\"><!-- wp:paragraph {\"className\":\"medlux-lead\"} -->\n<p class=\"medlux-lead\">Our clinical treatments cover aesthetic, dental and hair treatments, weight-loss surgery, health check-ups and IV therapies. Experienced partner clinics carry out each treatment, while MedLuxLife plans your appointments, travel and stay and remains your point of contact throughout.<\/p>\n<!-- \/wp:paragraph --><\/div>\n<!-- \/wp:column -->\n\n<!-- wp:column {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\"><!-- wp:image {\"id\":1082,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-intro-img\"} -->\n<figure class=\"wp-block-image size-large medlux-intro-img\"><img src=\"https:\/\/medluxlife.de\/wp-content\/uploads\/2026\/10\/medluxlife-ai-m883.jpg\" alt=\"Doctor and patient talking during a relaxed consultation in a modern clinic\" class=\"wp-image-1082\"\/><\/figure>\n<!-- \/wp:image --><\/div>\n<!-- \/wp:column --><\/div>\n<!-- \/wp:columns -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Our cl