{"id": 27, "content": {"raw": "<!-- wp:columns {\"verticalAlignment\":\"center\",\"className\":\"medlux-intro\"} -->\n<div class=\"wp-block-columns are-vertically-aligned-center medlux-intro\"><!-- wp:column {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\"><!-- wp:paragraph {\"className\":\"medlux-lead\"} -->\n<p class=\"medlux-lead\">MedLuxLife connects you with professional healthcare and carefully plans every step of your journey. Whether you are looking for an aesthetic or dental treatment or for specialist hospital care, we help you find the right specialists, prepare your treatment and organise your stay.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\"><!-- wp:image {\"id\":741,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-intro-img\"} -->\n<figure class=\"wp-block-image size-large medlux-intro-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/medluxlife-dental-consultation-1024x768.jpg\" alt=\"Smiling patient during a dental check-up\" class=\"wp-image-741\"/></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Our health services</h2>\n<!-- /wp:heading -->\n\n<!-- wp:columns {\"className\":\"medlux-hub\"} -->\n<div class=\"wp-block-columns medlux-hub\"><!-- wp:column {\"className\":\"medlux-hub-box\"} -->\n<div class=\"wp-block-column medlux-hub-box\"><!-- wp:image {\"id\":872,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-hub-img\"} -->\n<figure class=\"wp-block-image size-large medlux-hub-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/medluxlife-aesthetics-326.jpg\" alt=\"Gloved hands framing a woman&#x27;s face\" class=\"wp-image-872\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Clinical Treatments</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Aesthetic, dental and hair treatments, weight-loss surgery, check-ups and IV therapies with experienced partner clinics.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/clinical-treatments/dental-and-oral-health/\">Dental and Oral Health</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/clinical-treatments/hair-transplantation/\">Hair Transplantation</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/clinical-treatments/plastic-surgery/\">Plastic Surgery</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/clinical-treatments/medical-aesthetics/\">Medical Aesthetics</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/clinical-treatments/bariatric-surgery/\">Bariatric Surgery</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/clinical-treatments/check-up-packages/\">Check-Up Packages</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/clinical-treatments/iv-treatments/\">IV Treatments</a></li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"medlux-btn-primary\"} -->\n<div class=\"wp-block-button medlux-btn-primary\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://medluxlife.de/health/clinical-treatments/\">View all clinical treatments</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"className\":\"medlux-hub-box\"} -->\n<div class=\"wp-block-column medlux-hub-box\"><!-- wp:image {\"id\":884,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-hub-img\"} -->\n<figure class=\"wp-block-image size-large medlux-hub-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/medluxlife-photo-335.jpg\" alt=\"Medical team in a modern hospital\" class=\"wp-image-884\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Hospital &amp; Specialist Treatments</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Specialist hospital care across more than 70 departments, from oncology and cardiology to transplantation and fertility treatment.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/medical-oncology/\">Medical Oncology</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/cardiology/\">Cardiology</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/orthopedics-and-traumatology/\">Orthopedics and Traumatology</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/in-vitro-fertilization-ivf/\">In-Vitro Fertilization (IVF)</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/neurosurgery/\">Neurosurgery</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/ophthalmology/\">Ophthalmology</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/organ-transplantation-center/\">Organ Transplantation Center</a></li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"medlux-btn-primary\"} -->\n<div class=\"wp-block-button medlux-btn-primary\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://medluxlife.de/health/hospital-specialist-treatments/\">View all departments</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-why\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-why\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Why MedLuxLife</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-why-grid\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group medlux-why-grid\"><!-- wp:group {\"className\":\"medlux-why-item\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-why-item\"><!-- wp:image {\"className\":\"medlux-why-icon\"} -->\n<figure class=\"wp-block-image medlux-why-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Personal coordinator</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>One contact person who speaks your language and accompanies you from the first question to your return home.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-why-item\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-why-item\"><!-- wp:image {\"className\":\"medlux-why-icon\"} -->\n<figure class=\"wp-block-image medlux-why-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Trusted partners</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Carefully selected clinics and hospitals with experienced specialists.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-why-item\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-why-item\"><!-- wp:image {\"className\":\"medlux-why-icon\"} -->\n<figure class=\"wp-block-image medlux-why-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Treatment and travel in one plan</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Appointments, hotel, flights and airport transfers, coordinated for you.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-why-item\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-why-item\"><!-- wp:image {\"className\":\"medlux-why-icon\"} -->\n<figure class=\"wp-block-image medlux-why-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Aftercare</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>We stay in touch after your treatment and help with follow-up questions.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">How MedLuxLife supports you</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-steps\",\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"20rem\"}} -->\n<div class=\"wp-block-group medlux-steps\"><!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">1. Free consultation</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Share your wishes and, if available, recent X-rays or photos. We answer your questions and explain the options.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">2. Personal treatment plan</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Our partner specialists prepare a treatment plan and an estimated timeline tailored to you.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">3. Travel &amp; treatment</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>We coordinate your appointments, hotel and airport transfers, so you can focus on your treatment.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">4. Aftercare</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>We stay in touch after you return home and help with follow-up questions.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-cta\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-cta\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Plan your treatment with confidence</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Every treatment begins with a personal, no-obligation consultation. Contact us and we will get back to you as soon as possible.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"medlux-btn-primary\"} -->\n<div class=\"wp-block-button medlux-btn-primary\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://medluxlife.de/contact/\">Request a Free Consultation</a></div>\n<!-- /wp:button --><!-- wp:button {\"className\":\"medlux-btn-whatsapp\"} -->\n<div class=\"wp-block-button medlux-btn-whatsapp\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://wa.me/380979092326\" target=\"_blank\" rel=\"noreferrer noopener\">WhatsApp</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->\n\n<!-- wp:paragraph {\"className\":\"medlux-disclaimer\"} -->\n<p class=\"medlux-disclaimer\">The information on this page is for general guidance only and does not replace a medical consultation. Suitability for any treatment is assessed individually by a qualified doctor.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->"}}