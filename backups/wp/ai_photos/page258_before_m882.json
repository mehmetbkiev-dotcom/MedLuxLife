{"id": 258, "content": {"raw": "<!-- wp:columns {\"verticalAlignment\":\"center\",\"className\":\"medlux-intro\"} -->\n<div class=\"wp-block-columns are-vertically-aligned-center medlux-intro\"><!-- wp:column {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\"><!-- wp:paragraph {\"className\":\"medlux-lead\"} -->\n<p class=\"medlux-lead\">Our clinical treatments cover aesthetic, dental and hair treatments, weight-loss surgery, health check-ups and IV therapies. Experienced partner clinics carry out each treatment, while MedLuxLife plans your appointments, travel and stay and remains your point of contact throughout.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\"><!-- wp:image {\"id\":1094,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-intro-img\"} -->\n<figure class=\"wp-block-image size-large medlux-intro-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/medluxlife-ai-n258.jpg\" alt=\"Patient coordinator welcoming an international patient at a modern clinic reception\" class=\"wp-image-1094\"/></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Our clinical treatments</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-treatment-grid\",\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"20rem\"}} -->\n<div class=\"wp-block-group medlux-treatment-grid\"><!-- wp:group {\"className\":\"medlux-card medlux-card\\u002d\\u002dphoto\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card medlux-card--photo\"><!-- wp:image {\"id\":1074,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-card-img\"} -->\n<figure class=\"wp-block-image size-large medlux-card-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/medluxlife-ai-m741.jpg\" alt=\"Smiling patient during a dental check-up\" class=\"wp-image-1074\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Dental and Oral Health</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Hollywood Smile, implants, zirconium veneers, orthodontics and complete dental care.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-more\"} -->\n<p class=\"medlux-more\"><a href=\"https://medluxlife.de/health/clinical-treatments/dental-and-oral-health/\">Learn more \u2192</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card medlux-card\\u002d\\u002dphoto\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card medlux-card--photo\"><!-- wp:image {\"id\":1075,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-card-img\"} -->\n<figure class=\"wp-block-image size-large medlux-card-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/medluxlife-ai-m760.jpg\" alt=\"Hair transplant planning with the treatment area marked on the scalp\" class=\"wp-image-1075\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Hair Transplantation</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>FUE, Sapphire FUE and DHI hair, beard and eyebrow transplants, plus restorative hair therapies.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-more\"} -->\n<p class=\"medlux-more\"><a href=\"https://medluxlife.de/health/clinical-treatments/hair-transplantation/\">Learn more \u2192</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card medlux-card\\u002d\\u002dphoto\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card medlux-card--photo\"><!-- wp:image {\"id\":1076,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-card-img\"} -->\n<figure class=\"wp-block-image size-large medlux-card-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/medluxlife-ai-m857.jpg\" alt=\"Doctor examining a woman&#x27;s face during an aesthetic consultation\" class=\"wp-image-1076\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Plastic Surgery</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Face and body procedures, from rhinoplasty and facelift to mommy makeover and liposuction.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-more\"} -->\n<p class=\"medlux-more\"><a href=\"https://medluxlife.de/health/clinical-treatments/plastic-surgery/\">Learn more \u2192</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card medlux-card\\u002d\\u002dphoto\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card medlux-card--photo\"><!-- wp:image {\"id\":872,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-card-img\"} -->\n<figure class=\"wp-block-image size-large medlux-card-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/medluxlife-aesthetics-326.jpg\" alt=\"Gloved hands framing a woman&#x27;s face\" class=\"wp-image-872\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Medical Aesthetics</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Botox, dermal fillers, mesotherapy and exosome treatments with little or no downtime.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-more\"} -->\n<p class=\"medlux-more\"><a href=\"https://medluxlife.de/health/clinical-treatments/medical-aesthetics/\">Learn more \u2192</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card medlux-card\\u002d\\u002dphoto\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card medlux-card--photo\"><!-- wp:image {\"id\":1079,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-card-img\"} -->\n<figure class=\"wp-block-image size-large medlux-card-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/medluxlife-ai-m879.jpg\" alt=\"Nurse reviewing patient information on a tablet\" class=\"wp-image-1079\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Bariatric Surgery</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Gastric sleeve, gastric bypass and gastric balloon in a supportive, respectful setting.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-more\"} -->\n<p class=\"medlux-more\"><a href=\"https://medluxlife.de/health/clinical-treatments/bariatric-surgery/\">Learn more \u2192</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card medlux-card\\u002d\\u002dphoto\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card medlux-card--photo\"><!-- wp:image {\"id\":1081,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-card-img\"} -->\n<figure class=\"wp-block-image size-large medlux-card-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/medluxlife-ai-m881.jpg\" alt=\"Doctor measuring a patient&#x27;s blood pressure\" class=\"wp-image-1081\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Check-Up Packages</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Comprehensive health check-ups for men and women, tailored to every stage of life.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-more\"} -->\n<p class=\"medlux-more\"><a href=\"https://medluxlife.de/health/clinical-treatments/check-up-packages/\">Learn more \u2192</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card medlux-card\\u002d\\u002dphoto\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card medlux-card--photo\"><!-- wp:image {\"id\":882,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-card-img\"} -->\n<figure class=\"wp-block-image size-large medlux-card-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/medluxlife-photo-336.jpg\" alt=\"Woman relaxing during an IV infusion\" class=\"wp-image-882\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">IV Treatments</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Vitamin and nutrient infusions to support energy, regeneration and well-being.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-more\"} -->\n<p class=\"medlux-more\"><a href=\"https://medluxlife.de/health/clinical-treatments/iv-treatments/\">Learn more \u2192</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">How MedLuxLife supports you</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-steps\",\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"20rem\"}} -->\n<div class=\"wp-block-group medlux-steps\"><!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">1. Free consultation</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Share your wishes and, if available, recent X-rays or photos. We answer your questions and explain the options.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">2. Personal treatment plan</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Our partner specialists prepare a treatment plan and an estimated timeline tailored to you.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">3. Travel &amp; treatment</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>We coordinate your appointments, hotel and airport transfers, so you can focus on your treatment.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">4. Aftercare</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>We stay in touch after you return home and help with follow-up questions.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-cta\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-cta\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Plan your treatment with confidence</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Every treatment begins with a personal, no-obligation consultation. Contact us and we will get back to you as soon as possible.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"medlux-btn-primary\"} -->\n<div class=\"wp-block-button medlux-btn-primary\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://medluxlife.de/contact/\">Request a Free Consultation</a></div>\n<!-- /wp:button --><!-- wp:button {\"className\":\"medlux-btn-whatsapp\"} -->\n<div class=\"wp-block-button medlux-btn-whatsapp\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://wa.me/380979092326\" target=\"_blank\" rel=\"noreferrer noopener\">WhatsApp</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->\n\n<!-- wp:paragraph {\"className\":\"medlux-disclaimer\"} -->\n<p class=\"medlux-disclaimer\">The information on this page is for general guidance only and does not replace a medical consultation. Suitability for any treatment is assessed individually by a qualified doctor.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->"}}