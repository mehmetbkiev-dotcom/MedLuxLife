-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">3. Travel &amp; treatment</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>We coordinate your appointments, hotel and airport transfers, so you can focus on your treatment.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">4. Aftercare</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>We stay in touch after you return home and help with follow-up questions.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-cta\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-cta\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Plan your hospital treatment with confidence</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Every treatment begins with a personal, no-obligation consultation. Contact us and we will get back to you as soon as possible.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"medlux-btn-primary\"} -->\n<div class=\"wp-block-button medlux-btn-primary\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://medluxlife.de/contact/\">Request a Free Consultation</a></div>\n<!-- /wp:button --><!-- wp:button {\"className\":\"medlux-btn-whatsapp\"} -->\n<div class=\"wp-block-button medlux-btn-whatsapp\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://wa.me/380979092326\" target=\"_blank\" rel=\"noreferrer noopener\">WhatsApp</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->\n\n<!-- wp:paragraph {\"className\":\"medlux-disclaimer\"} -->\n<p class=\"medlux-disclaimer\">The information on this page is for general guidance only and does not replace a medical consultation. Suitability for any treatment is assessed individually by a qualified doctor.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->"}}