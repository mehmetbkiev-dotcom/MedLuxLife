px rgba(0, 0, 0, 0.75) !important;\"},\"fontFamily\":\"source-serif-pro\"} -->\n<h1 class=\"wp-block-heading has-text-align-center ext-animate--on has-custom-css has-text-color has-link-color has-source-serif-pro-font-family\" style=\"color:#fefefe;margin-top:10px;margin-bottom:10px;font-size:40px;line-height:1.15\">Your Health, <mark style=\"background-color:rgba(0, 0, 0, 0);color:#d4a24c\" class=\"has-inline-color\"><em>Upgraded.</em></mark> Your Journey, <mark style=\"background-color:rgba(0, 0, 0, 0);color:#d4a24c\" class=\"has-inline-color\"><em>Elevated.</em></mark></h1>\n<!-- /wp:heading -->\n\n<!-- wp:buttons {\"className\":\"ext-animate\\u002d\\u002don\",\"style\":{\"spacing\":{\"blockGap\":{\"top\":\"40px\"},\"padding\":{\"right\":\"0px\",\"left\":\"0px\",\"top\":\"10px\",\"bottom\":\"10px\"},\"margin\":{\"top\":\"8px\",\"bottom\":\"8px\"}}},\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-buttons ext-animate--on\" style=\"margin-top:8px;margin-bottom:8px;padding-top:10px;padding-right:0px;padding-bottom:10px;padding-left:0px\"><!-- wp:button {\"className\":\"is-style-ext-preset\\u002d\\u002dbutton\\u002d\\u002dnatural-1\\u002d\\u002dbutton-1 ext-animate\\u002d\\u002don\",\"style\":{\"color\":{\"background\":\"transparent\",\"text\":\"#d4a24c\"},\"elements\":{\"link\":{\"color\":{\"text\":\"#060606\"}}},\"border\":{\"color\":\"#d4a24c\",\"style\":\"solid\",\"width\":\"1px\",\"radius\":\"9999px\"},\"spacing\":{\"padding\":{\"left\":\"28px\",\"right\":\"28px\",\"top\":\"16px\",\"bottom\":\"16px\"}},\"css\":\"text-shadow: 0 1px 4px rgba(0, 0, 0, 0.75) !important;\"},\"fontFamily\":\"inter\"} -->\n<div class=\"wp-block-button is-style-ext-preset--button--natural-1--button-1 ext-animate--on has-custom-css\"><a class=\"wp-block-button__link has-text-color has-background has-link-color has-border-color has-inter-font-family wp-element-button\" href=\"https://medluxlife.de/health/\" style=\"border-color:#d4a24c;border-style:solid;border-width:1px;border-radius:9999px;color:#d4a24c;background-color:transparent;padding-top:16px;padding-right:28px;padding-bottom:16px;padding-left:28px\">EXPLORE HEALTH     &gt;</a></div>\n<!-- /wp:button -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"style\":{\"border\":{\"style\":\"solid\",\"width\":\"1px\",\"radius\":\"9999px\",\"color\":\"#d4a24c\"},\"spacing\":{\"padding\":{\"left\":\"28px\",\"right\":\"28px\",\"top\":\"16px\",\"bottom\":\"16px\"}},\"typography\":{\"lineHeight\":\"26.55px\",\"fontWeight\":\"500\"},\"shadow\":null,\"css\":\"text-shadow: 0 1px 4px rgba(0, 0, 0, 0.75) !important;\",\"color\":{\"background\":\"transparent\",\"text\":\"#d4a24c\"}}} -->\n<div class=\"wp-block-button has-custom-css\"><a class=\"wp-block-button__link has-text-color has-background has-border-color wp-element-button\" href=\"https://medluxlife.de/travel/\" style=\"border-color:#d4a24c;border-style:solid;border-width:1px;border-radius:9999px;color:#d4a24c;background-color:transparent;padding-top:16px;padding-right:28px;padding-bottom:16px;padding-left:28px;font-weight:500;line-height:26.55px\">EXPLORE TRAVEL    &gt;</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:group --></div></div>\n<!-- /wp:cover --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"metadata\":{\"name\":\"Static Products Section\"},\"align\":\"full\",\"className\":\"ext-section is-style-ext-preset\\u002d\\u002dgroup\\u002d\\u002dnatural-1\\u002d\\u002dsection has-custom-css\",\"style\":{\"spacing\":{\"margin\":{\"top\":\"0\",\"bottom\":\"0\"},\"padding\":{\"top\":\"var:preset|spacing|70\",\"bottom\":\"var:preset|spacing|70\"},\"blockGap\":\"var:preset|spacing|55\"}},\"backgroundColor\":\"background\",\"textColor\":\"secondary\",\"layout\":{\"inherit\":true,\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull ext-section is-style-ext-preset--group--natural-1--section has-custom-css has-secondary-color has-background-background-color has-text-color has-background\" style=\"margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)\"><!-- wp:group {\"metadata\":{\"name\":\"Section Intro\"},\"align\":\"wide\",\"className\":\"ext-section-intro is-style-ext-preset\\u002d\\u002dgroup\\u002d\\u002dnatural-1\\u002d\\u002dsection-intro-1 has-custom-css\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignwide ext-section-intro is-style-ext-preset--group--natural-1--section-intro-1 has-custom-css\"><!-- wp:heading {\"className\":\"ext-section-intro-heading ext-animate\\u002d\\u002don\"} -->\n<h2 class=\"wp-block-heading ext-section-intro-heading ext-animate--on\">Elevate Your Health and Travel Experiences</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"ext-section-intro-description ext-animate\\u002d\\u002don\",\"style\":{\"spacing\":{\"margin\":{\"top\":\"24px\"}}},\"textColor\":\"foreground-alt\",\"fontSize\":\"medium\"} -->\n<p class=\"ext-section-intro-description ext-animate--on has-foreground-alt-color has-text-color has-medium-font-size\" style=\"margin-top:24px\">[trp_language language=\"en_GB\"]Expert medical care and custom travel \u2014 we manage every detail from day one so your journey is completely seamless.[/trp_language][trp_language language=\"de_DE\"]Fachkundige medizinische Versorgung und ma\u00dfgeschneiderte Reisen \u2014 wir k\u00fcmmern uns vom ersten Tag an um jedes Detail, damit Ihre Reise absolut reibungslos verl\u00e4uft.[/trp_language][trp_language language=\"tr_TR\"]Uzman t\u0131bbi bak\u0131m ve ki\u015fiye \u00f6zel seyahat \u2014 yolculu\u011funuzun kusursuz ge\u00e7mesi i\u00e7in ilk g\u00fcnden itibaren her detayla biz ilgileniyoruz.[/trp_language]</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"metadata\":{\"name\":\"Static Products Section Grid\"},\"align\":\"wide\",\"className\":\"ext-grid\",\"style\":{\"spacing\":{\"blockGap\":\"32px\"}},\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"24rem\",\"columnCount\":3}} -->\n<div class=\"wp-block-group alignwide ext-grid\"><!-- wp:group {\"metadata\":{\"name\":\"Card\"},\"className\":\"ext-card ext-card-stacked is-style-ext-preset\\u002d\\u002dgroup\\u002d\\u002dnatural-1\\u002d\\u002ditem-card-1\\u002d\\u002dalign-start ext-animate\\u002d\\u002don\",\"style\":{\"spacing\":{\"blockGap\":\"24px\"},\"dimensions\":{\"minHeight\":\"100%\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\",\"justifyContent\":\"stretch\"}} -->\n<div class=\"wp-block-group ext-card ext-card-stacked is-style-ext-preset--group--natural-1--item-card-1--align-start ext-animate--on\" style=\"min-height:100%\"><!-- wp:image {\"id\":93,\"aspectRatio\":\"1\",\"scale\":\"cover\",\"metadata\":{\"name\":\"Card Image\"},\"className\":\"ext-card-image\"} -->\n<figure class=\"wp-block-image ext-card-image\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/09/2026-09-23-16-47-04-fe35aae8-61ec-4d9e-a8d6-e1c531c4f716.png\" alt=\"A dentist in a blue uniform and face mask uses dental instruments to examine a patient lying in a dental chair.\" class=\"wp-image-93\" style=\"aspect-ratio:1;object-fit:cover\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:group {\"metadata\":{\"name\":\"Card Content\"},\"className\":\"ext-card-content\",\"style\":{\"spacing\":{\"blockGap\":\"24px\"},\"layout\":{\"selfStretch\":\"fill\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\",\"justifyContent\":\"stretch\"}} -->\n<div class=\"wp-block-group ext-card-content\"><!-- wp:group {\"metadata\":{\"name\":\"Card Body\"},\"className\":\"ext-card-body\",\"style\":{\"spacing\":{\"blockGap\":\"8px\"}},\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group ext-card-body\"><!-- wp:heading {\"level\":3,\"fontSize\":\"medium\"} -->\n<h3 class=\"wp-block-heading has-medium-font-size\">Dental Treatment</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Medical Care</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"metadata\":{\"name\":\"Card\"},\"className\":\"ext-card ext-card-stacked is-style-ext-preset\\u002d\\u002dgroup\\u002d\\u002dnatural-1\\u002d\\u002ditem-card-1\\u002d\\u002dalign-start ext-animate\\u002d\\u002don\",\"style\":{\"spacing\":{\"blockGap\":\"24px\"},\"dimensions\":{\"minHeight\":\"100%\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\",\"justifyContent\":\"stretch\"}} -->\n<div class=\"wp-block-group ext-card ext-card-stacked is-style-ext-preset--group--natural-1--item-card-1--align-start ext-animate--on\" style=\"min-height:100%\"><!-- wp:image {\"id\":1738,\"aspectRatio\":\"1\",\"scale\":\"cover\",\"metadata\":{\"name\":\"Card Image\"},\"className\":\"ext-card-image\"} -->\n<figure class=\"wp-block-image ext-card-image\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/home-card-plastic-surgery.jpg\" alt=\"Plastic surgeon discussing a 3D facial model with a patient in a bright consultation room\" class=\"wp-image-1738\" style=\"aspect-ratio:1;object-fit:cover\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:group {\"metadata\":{\"name\":\"Card Content\"},\"className\":\"ext-card-content\",\"style\":{\"spacing\":{\"blockGap\":\"24px\"},\"layout\":{\"selfStretch\":\"fill\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\",\"justifyContent\":\"stretch\"}} -->\n<div class=\"wp-block-group ext-card-content\"><!-- wp:group {\"metadata\":{\"name\":\"Card Body\"},\"className\":\"ext-card-body\",\"style\":{\"spacing\":{\"blockGap\":\"8px\"}},\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group ext-card-body\"><!-- wp:heading {\"level\":3,\"fontSize\":\"medium\"} -->\n<h3 class=\"wp-block-heading has-medium-font-size\">Plastic Surgery</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Aesthetics</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"metadata\":{\"name\":\"Card\"},\"className\":\"ext-card ext-card-stacked is-style-ext-preset\\u002d\\u002dgroup\\u002d\\u002dnatural-1\\u002d\\u002ditem-card-1\\u002d\\u002dalign-start ext-animate\\u002d\\u002don\",\"style\":{\"spacing\":{\"blockGap\":\"24px\"},\"dimensions\":{\"minHeight\":\"100%\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\",\"justifyContent\":\"stretch\"}} -->\n<div class=\"wp-block-group ext-card ext-card-stacked is-style-ext-preset--group--natural-1--item-card-1--align-start ext-animate--on\" style=\"min-height:100%\"><!-- wp:image {\"id\":304,\"aspectRatio\":\"1\",\"scale\":\"cover\",\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"metadata\":{\"name\":\"Card Image\"},\"className\":\"ext-card-image\"} -->\n<figure class=\"wp-block-image size-large ext-card-image\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/Luxuriose-Tropen-Oase-am-Infinity-Pool-1024x1024.png\" alt=\"\" class=\"wp-image-304\" style=\"aspect-ratio:1;object-fit:cover\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:group {\"metadata\":{\"name\":\"Card Content\"},\"className\":\"ext-card-content\",\"style\":{\"spacing\":{\"blockGap\":\"24px\"},\"layout\":{\"selfStretch\":\"fill\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\",\"justifyContent\":\"stretch\"}} -->\n<div class=\"wp-block-group ext-card-content\"><!-- wp:group {\"metadata\":{\"name\":\"Card Body\"},\"className\":\"ext-card-body\",\"style\":{\"spacing\":{\"blockGap\":\"8px\"}},\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group ext-card-body\"><!-- wp:heading {\"level\":3,\"fontSize\":\"medium\"} -->\n<h3 class=\"wp-block-heading has-medium-font-size\">Holiday Package</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Travel Services</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"metadata\":{\"name\":\"Section\"},\"align\":\"full\",\"className\":\"is-style-ext-preset\\u002d\\u002dgroup\\u002d\\u002dnatural-1\\u002d\\u002dsection ext-section\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|70\",\"bottom\":\"var:preset|spacing|70\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"},\"blockGap\":\"var:preset|spacing|55\"}},\"backgroundColor\":\"background\",\"layout\":{\"inherit\":true,\"type\":\"constrained\"},\"anchor\":\"faq\"} -->\n<div class=\"wp-block-group alignfull is-style-ext-preset--group--natural-1--section ext-section has-background-background-color has-background\" id=\"faq\" style=\"margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)\"><!-- wp:columns {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":{\"top\":\"var:preset|spacing|30\",\"left\":\"var:preset|spacing|55\"}}}} -->\n<div class=\"wp-block-columns alignwide\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:group {\"metadata\":{\"name\":\"Section Intro\"},\"align\":\"wide\",\"className\":\"ext-section-intro is-style-ext-preset\\u002d\\u002dgroup\\u002d\\u002dnatural-1\\u002d\\u002dsection-intro-1 has-custom-css\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignwide ext-section-intro is-style-ext-preset--group--natural-1--section-intro-1 has-custom-css\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Advanced Medical Care and Travel Services</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"ext-animate\\u002d\\u002don\",\"style\":{\"spacing\":{\"margin\":{\"top\":\"24px\"}}},\"textColor\":\"foreground-alt\",\"fontSize\":\"medium\"} -->\n<p class=\"ext-animate--on has-foreground-alt-color has-text-color has-medium-font-size\" style=\"margin-top:24px\">Find quick answers regarding our medical treatments, travel packages, and multilingual support services.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|30\"}}} -->\n<div class=\"wp-block-column\"><!-- wp:accordion {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|30\"}},\"layout\":{\"type\":\"default\"}} -->\n<div role=\"group\" class=\"wp-block-accordion\"><!-- wp:accordion-item {\"openByDefault\":true,\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-accordion-item is-open\"><!-- wp:accordion-heading {\"style\":{\"typography\":{\"fontSize\":\"1.5rem\"}}} -->\n<h3 class=\"wp-block-accordion-heading\" style=\"font-size:1.5rem\"><button type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\">What medical treatments do you offer?</span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">+</span></button></h3>\n<!-- /wp:accordion-heading -->\n\n<!-- wp:accordion-panel -->\n<div role=\"region\" class=\"wp-block-accordion-panel\"><!-- wp:paragraph -->\n<p>We offer dental treatments, hair transplantation, plastic surgery, and bariatric surgery through our partners.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:accordion-panel --></div>\n<!-- /wp:accordion-item -->\n\n<!-- wp:accordion-item {\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-accordion-item\"><!-- wp:accordion-heading {\"style\":{\"typography\":{\"fontSize\":\"1.5rem\"}}} -->\n<h3 class=\"wp-block-accordion-heading has-icon has-icon-right\" style=\"font-size:1.5rem\"><button type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\">[trp_language language=\"en_GB\"]Do you provide travel and accommodation services?[/trp_language][trp_language language=\"de_DE\"]Bieten Sie Reise- und Unterkunftsleistungen an?[/trp_language][trp_language language=\"tr_TR\"]Seyahat ve konaklama hizmeti sunuyor musunuz?[/trp_language]</span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">+</span></button></h3>\n<!-- /wp:accordion-heading -->\n\n<!-- wp:accordion-panel -->\n<div role=\"region\" class=\"wp-block-accordion-panel\"><!-- wp:paragraph -->\n<p>Yes, we arrange flight and hotel services, airport transfers, and customized holiday packages.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:accordion-panel --></div>\n<!-- /wp:accordion-item -->\n\n<!-- wp:accordion-item {\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-accordion-item\"><!-- wp:accordion-heading {\"style\":{\"typography\":{\"fontSize\":\"1.5rem\"}}} -->\n<h3 class=\"wp-block-accordion-heading has-icon has-icon-right\" style=\"font-size:1.5rem\"><button type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\">Which languages do you support on your website?</span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">+</span></button></h3>\n<!-- /wp:accordion-heading -->\n\n<!-- wp:accordion-panel -->\n<div role=\"region\" class=\"wp-block-accordion-panel\"><!-- wp:paragraph -->\n<p>[trp_language language=\"en_GB\"]Our website is available in German, English, Turkish, Ukrainian and Russian. Our team speaks Turkish, Ukrainian, Russian, English and German, and native-speaking interpreters for nine languages are available at our partner clinics.[/trp_language][trp_language language=\"de_DE\"]Unsere Website ist auf Deutsch, Englisch, T\u00fcrkisch, Ukrainisch und Russisch verf\u00fcgbar. Unser Team spricht T\u00fcrkisch, Ukrainisch, Russisch, Englisch und Deutsch, und in unseren Partnerkliniken stehen muttersprachliche Dolmetscher f\u00fcr neun Sprachen zur Verf\u00fcgung.[/trp_language][trp_language language=\"tr_TR\"]Web sitemiz Almanca, \u0130ngilizce, T\u00fcrk\u00e7e, Ukraynaca ve Rus\u00e7a olarak kullan\u0131labilir. Ekibimiz T\u00fcrk\u00e7e, Ukraynaca, Rus\u00e7a, \u0130ngilizce ve Almanca konu\u015fuyor; partner kliniklerimizde ise dokuz dil i\u00e7in anadili d\u00fczeyinde terc\u00fcmanlar haz\u0131r bulunuyor.[/trp_language]</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:accordion-panel --></div>\n<!-- /wp:accordion-item -->\n\n<!-- wp:accordion-item {\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-accordion-item\"><!-- wp:accordion-heading {\"style\":{\"typography\":{\"fontSize\":\"1.5rem\"}}} -->\n<h3 class=\"wp-block-accordion-heading has-icon has-icon-right\" style=\"font-size:1.5rem\"><button type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\">How do I book a check-up package or treatment?</span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">+</span></button></h3>\n<!-- /wp:accordion-heading -->\n\n<!-- wp:accordion-panel -->\n<div role=\"region\" class=\"wp-block-accordion-panel\"><!-- wp:paragraph -->\n<p>You can easily contact our team to select your desired treatment and plan your complete journey.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:accordion-panel --></div>\n<!-- /wp:accordion-item --></div>\n<!-- /wp:accordion --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\",\"metadata\":{\"name\":\"Features\"},\"align\":\"full\",\"className\":\"ext-section is-style-ext-preset\\u002d\\u002dgroup\\u002d\\u002dnatural-1\\u002d\\u002dsection has-custom-css\",\"style\":{\"spacing\":{\"margin\":{\"top\":\"0\",\"bottom\":\"0\"},\"padding\":{\"top\":\"var:preset|spacing|70\",\"bottom\":\"var:preset|spacing|70\"},\"blockGap\":\"var:preset|spacing|55\"}},\"backgroundColor\":\"tertiary\",\"layout\":{\"inherit\":true,\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull ext-section is-style-ext-preset--group--natural-1--section has-custom-css has-tertiary-background-color has-background\" style=\"margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--70);padding-botto