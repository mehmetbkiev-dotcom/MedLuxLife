{"id": 2412, "modified": "2026-10-18T10:22:11", "content": {"raw": "<!-- wp:columns {\"verticalAlignment\":\"center\",\"className\":\"medlux-intro\"} -->\n<div class=\"wp-block-columns are-vertically-aligned-center medlux-intro\"><!-- wp:column {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\"><!-- wp:paragraph {\"className\":\"medlux-lead\"} -->\n<p class=\"medlux-lead\">Professional teeth whitening lightens the colour of the teeth and removes stains and discolouration \u2013 in the clinic with a professional gel activated by LED or laser light, or with custom take-home kits for gradual whitening. MedLuxLife arranges your online consultation with the dentist in Istanbul and organises your stay.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\"><!-- wp:image {\"id\":1321,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-intro-img\"} -->\n<figure class=\"wp-block-image size-large medlux-intro-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/chatgpt-gorseli-10-eki-2026-15-23-00-opt.jpg\" alt=\"Professional teeth whitening with a blue light\" class=\"wp-image-1321\"/></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:group {\"className\":\"medlux-section medlux-facts-sec\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section medlux-facts-sec\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Quick facts</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-facts\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group medlux-facts\"><!-- wp:group {\"className\":\"medlux-fact\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-fact\"><!-- wp:image {\"className\":\"medlux-card-icon\"} -->\n<figure class=\"wp-block-image medlux-card-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:paragraph {\"className\":\"medlux-fact-label\"} -->\n<p class=\"medlux-fact-label\">Duration</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-fact-value\"} -->\n<p class=\"medlux-fact-value\">About 45\u201360 minutes</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-fact\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-fact\"><!-- wp:image {\"className\":\"medlux-card-icon\"} -->\n<figure class=\"wp-block-image medlux-card-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:paragraph {\"className\":\"medlux-fact-label\"} -->\n<p class=\"medlux-fact-label\">Sessions</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-fact-value\"} -->\n<p class=\"medlux-fact-value\">One or more, as needed</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-fact\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-fact\"><!-- wp:image {\"className\":\"medlux-card-icon\"} -->\n<figure class=\"wp-block-image medlux-card-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:paragraph {\"className\":\"medlux-fact-label\"} -->\n<p class=\"medlux-fact-label\">Anaesthesia</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-fact-value\"} -->\n<p class=\"medlux-fact-value\">Not needed</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-fact\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-fact\"><!-- wp:image {\"className\":\"medlux-card-icon\"} -->\n<figure class=\"wp-block-image medlux-card-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:paragraph {\"className\":\"medlux-fact-label\"} -->\n<p class=\"medlux-fact-label\">Sensitivity</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-fact-value\"} -->\n<p class=\"medlux-fact-value\">Possible for 24\u201348 hours</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-fact\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-fact\"><!-- wp:image {\"className\":\"medlux-card-icon\"} -->\n<figure class=\"wp-block-image medlux-card-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:paragraph {\"className\":\"medlux-fact-label\"} -->\n<p class=\"medlux-fact-label\">Results last</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-fact-value\"} -->\n<p class=\"medlux-fact-value\">Usually 1\u20133 years</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:paragraph {\"className\":\"medlux-facts-note\"} -->\n<p class=\"medlux-facts-note\">General information; your dentist plans the details for you personally.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section medlux-suitable\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section medlux-suitable\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Who it may be suitable for</h2>\n<!-- /wp:heading -->\n\n<!-- wp:list {\"className\":\"medlux-checklist\"} -->\n<ul class=\"wp-block-list medlux-checklist\"><!-- wp:list-item -->\n<li>Your teeth are stained or discoloured \u2013 for example from coffee, tea, red wine, smoking, age or certain medication.</li>\n<!-- /wp:list-item -->\n<!-- wp:list-item -->\n<li>Your teeth and gums are healthy.</li>\n<!-- /wp:list-item -->\n<!-- wp:list-item -->\n<li>You know that the achievable shade differs from person to person.</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:paragraph {\"className\":\"medlux-suitable-note\"} -->\n<p class=\"medlux-suitable-note\">Whether the treatment is suitable for you is decided by the dentist after a personal assessment.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Options</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-treatment-grid medlux-centered-cards medlux-cols-2\",\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"14rem\"}} -->\n<div class=\"wp-block-group medlux-treatment-grid medlux-centered-cards medlux-cols-2\"><!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:image {\"className\":\"medlux-card-icon\"} -->\n<figure class=\"wp-block-image medlux-card-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">In-clinic whitening</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>A professional gel activated by LED or laser light.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:image {\"className\":\"medlux-card-icon\"} -->\n<figure class=\"wp-block-image medlux-card-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Take-home kit</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Custom trays for gradual whitening at home.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">How the treatment works</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-treatment-grid medlux-centered-cards medlux-stages\",\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"14rem\"}} -->\n<div class=\"wp-block-group medlux-treatment-grid medlux-centered-cards medlux-stages\"><!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:image {\"className\":\"medlux-card-icon\"} -->\n<figure class=\"wp-block-image medlux-card-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Consultation and cleaning</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>The dentist checks your teeth and gums, and the teeth are cleaned to prepare them for whitening.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:image {\"className\":\"medlux-card-icon\"} -->\n<figure class=\"wp-block-image medlux-card-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Whitening gel</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>A professional whitening gel is applied, often activated with a special light.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:image {\"className\":\"medlux-card-icon\"} -->\n<figure class=\"wp-block-image medlux-card-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Monitoring and sessions</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>The process is monitored for an even result; depending on the desired shade, more sessions may be recommended.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:image {\"className\":\"medlux-card-icon\"} -->\n<figure class=\"wp-block-image medlux-card-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Aftercare</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Avoid colouring food and drinks for 48 hours; touch-up kits help to keep the result.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">How it works with MedLuxLife</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-steps medlux-steps\\u002d\\u002dlist\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group medlux-steps medlux-steps--list\"><!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\"><span class=\"medlux-step-no\">1</span>Contact and online consultation</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Contact us and tell us what you are interested in. We refer you to the right dentist for an online consultation. Photos or medical documents go directly to the doctor, only on request.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\"><span class=\"medlux-step-no\">2</span>Your personal plan</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>The dentist recommends the right approach for you. We plan your dates, flights, hotel and transfers around it.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\"><span class=\"medlux-step-no\">3</span>Arrival and treatment</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>After an examination, the treatment takes place as planned. A session takes about 45\u201360 minutes.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\"><span class=\"medlux-step-no\">4</span>Your time in Istanbul</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Between the appointments you can rest in your hotel or explore the city. The dentist decides when the treatment is complete.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\"><span class=\"medlux-step-no\">5</span>Back home</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Stay in touch with us on WhatsApp \u2013 we help with follow-up questions.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">After the treatment</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-treatment-grid medlux-centered-cards medlux-timeline\",\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"14rem\"}} -->\n<div class=\"wp-block-group medlux-treatment-grid medlux-centered-cards medlux-timeline\"><!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:paragraph {\"className\":\"medlux-time-label\"} -->\n<p class=\"medlux-time-label\">Right after</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Normal activities straight away.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:paragraph {\"className\":\"medlux-time-label\"} -->\n<p class=\"medlux-time-label\">First 48 hours</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>\"White diet\": avoid coffee, tea, red wine, berries, tomato sauce and tobacco. The teeth may feel sensitive.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:paragraph {\"className\":\"medlux-time-label\"} -->\n<p class=\"medlux-time-label\">Long term</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>The result usually lasts 1\u20133 years, depending on your lifestyle and oral hygiene.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Frequently asked questions</h2>\n<!-- /wp:heading -->\n\n<!-- wp:accordion {\"className\":\"medlux-faq\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|20\"}},\"layout\":{\"type\":\"default\"}} -->\n<div role=\"group\" class=\"wp-block-accordion medlux-faq\"><!-- wp:accordion-item {\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-accordion-item\"><!-- wp:accordion-heading -->\n<h3 class=\"wp-block-accordion-heading\"><button type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\">Does whitening damage the enamel?</span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">+</span></button></h3>\n<!-- /wp:accordion-heading -->\n\n<!-- wp:accordion-panel -->\n<div role=\"region\" class=\"wp-block-accordion-panel\"><!-- wp:paragraph -->\n<p>Professional whitening by a dentist does not damage the enamel or gums. The teeth may be slightly sensitive for 24\u201348 hours.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:accordion-panel --></div>\n<!-- /wp:accordion-item -->\n\n<!-- wp:accordion-item {\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-accordion-item\"><!-- wp:accordion-heading -->\n<h3 class=\"wp-block-accordion-heading\"><button type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\">How long does a session take?</span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">+</span></button></h3>\n<!-- /wp:accordion-heading -->\n\n<!-- wp:accordion-panel -->\n<div role=\"region\" class=\"wp-block-accordion-panel\"><!-- wp:paragraph -->\n<p>About 45\u201360 minutes.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:accordion-panel --></div>\n<!-- /wp:accordion-item -->\n\n<!-- wp:accordion-item {\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-accordion-item\"><!-- wp:accordion-heading -->\n<h3 class=\"wp-block-accordion-heading\"><button type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\">How long does the result last?</span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">+</span></button></h3>\n<!-- /wp:accordion-heading -->\n\n<!-- wp:accordion-panel -->\n<div role=\"region\" class=\"wp-block-accordion-panel\"><!-- wp:paragraph -->\n<p>Usually 1\u20133 years, depending on your lifestyle, oral hygiene and diet.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:accordion-panel --></div>\n<!-- /wp:accordion-item -->\n\n<!-- wp:accordion-item {\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-accordion-item\"><!-- wp:accordion-heading -->\n<h3 class=\"wp-block-accordion-heading\"><button type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\">What should I avoid afterwards?</span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">+</span></button></h3>\n<!-- /wp:accordion-heading -->\n\n<!-- wp:accordion-panel -->\n<div role=\"region\" class=\"wp-block-accordion-panel\"><!-- wp:paragraph -->\n<p>For 48 hours avoid dark-coloured food and drinks such as coffee, tea, red wine, berries and tomato sauce, as well as tobacco.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:accordion-panel --></div>\n<!-- /wp:accordion-item -->\n\n<!-- wp:accordion-item {\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-accordion-item\"><!-- wp:accordion-heading -->\n<h3 class=\"wp-block-accordion-heading\"><button type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\">Should I send photos or medical documents to MedLuxLife?</span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">+</span></button></h3>\n<!-- /wp:accordion-heading -->\n\n<!-- wp:accordion-panel -->\n<div role=\"region\" class=\"wp-block-accordion-panel\"><!-- wp:paragraph -->\n<p>No. If the dentist needs photos or X-rays, you share them directly with the dentist in your online consultation.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:accordion-panel --></div>\n<!-- /wp:accordion-item --></div>\n<!-- /wp:accordion --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-cta\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-cta\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Plan your teeth whitening</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Contact us and tell us what you are interested in \u2013 we refer you to the right specialist for an online consultation.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"medlux-btn-primary\"} -->\n<div class=\"wp-block-button medlux-btn-primary\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://medluxlife.de/contact/\">Request a Free Consultation</a></div>\n<!-- /wp:button -->\n\n<!-- wp:button {\"className\":\"medlux-btn-whatsapp\"} -->\n<div class=\"wp-block-button medlux-btn-whatsapp\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://wa.me/380979092326\" target=\"_blank\" rel=\"noreferrer noopener\">WhatsApp</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->\n\n<!-- wp:paragraph {\"className\":\"medlux-disclaimer\"} -->\n<p class=\"medlux-disclaimer\">The information on this page is for general guidance only and does not replace a medical consultation. Suitability for any treatment is assessed individually by a qualified doctor.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n"}}