{"id": 2428, "modified": "2026-10-18T10:35:01", "content": {"raw": "<!-- wp:columns {\"verticalAlignment\":\"center\",\"className\":\"medlux-intro\"} -->\n<div class=\"wp-block-columns are-vertically-aligned-center medlux-intro\"><!-- wp:column {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\"><!-- wp:paragraph {\"className\":\"medlux-lead\"} -->\n<p class=\"medlux-lead\">A thigh lift removes excess skin and fat from the inner or outer thighs and tightens the tissue underneath \u2013 often after major weight loss or with age \u2013 for smoother, firmer contours. MedLuxLife arranges your online consultation with the surgeon in Istanbul and organises your stay.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\"><!-- wp:image {\"id\":1419,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-intro-img\"} -->\n<figure class=\"wp-block-image size-large medlux-intro-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/gemini-generated-image-s2e1tys2e1tys2e1-opt.jpg\" alt=\"Legs relaxing on a beach lounger\" class=\"wp-image-1419\"/></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:group {\"className\":\"medlux-section medlux-facts-sec\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section medlux-facts-sec\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Quick facts</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-facts\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group medlux-facts\"><!-- wp:group {\"className\":\"medlux-fact\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-fact\"><!-- wp:image {\"className\":\"medlux-card-icon\"} -->\n<figure class=\"wp-block-image medlux-card-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:paragraph {\"className\":\"medlux-fact-label\"} -->\n<p class=\"medlux-fact-label\">Anaesthesia</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-fact-value\"} -->\n<p class=\"medlux-fact-value\">General anaesthesia</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-fact\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-fact\"><!-- wp:image {\"className\":\"medlux-card-icon\"} -->\n<figure class=\"wp-block-image medlux-card-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:paragraph {\"className\":\"medlux-fact-label\"} -->\n<p class=\"medlux-fact-label\">Hospital stay</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-fact-value\"} -->\n<p class=\"medlux-fact-value\">Usually 1\u20132 nights</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-fact\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-fact\"><!-- wp:image {\"className\":\"medlux-card-icon\"} -->\n<figure class=\"wp-block-image medlux-card-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:paragraph {\"className\":\"medlux-fact-label\"} -->\n<p class=\"medlux-fact-label\">Walking</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-fact-value\"} -->\n<p class=\"medlux-fact-value\">Within hours</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-fact\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-fact\"><!-- wp:image {\"className\":\"medlux-card-icon\"} -->\n<figure class=\"wp-block-image medlux-card-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:paragraph {\"className\":\"medlux-fact-label\"} -->\n<p class=\"medlux-fact-label\">Compression garment</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-fact-value\"} -->\n<p class=\"medlux-fact-value\">In the first weeks</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-fact\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-fact\"><!-- wp:image {\"className\":\"medlux-card-icon\"} -->\n<figure class=\"wp-block-image medlux-card-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:paragraph {\"className\":\"medlux-fact-label\"} -->\n<p class=\"medlux-fact-label\">Stay in T\u00fcrkiye</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-fact-value\"} -->\n<p class=\"medlux-fact-value\">Planned individually with the clinic</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:paragraph {\"className\":\"medlux-facts-note\"} -->\n<p class=\"medlux-facts-note\">General information; your surgeon plans the details for you personally.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section medlux-suitable\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section medlux-suitable\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Who it may be suitable for</h2>\n<!-- /wp:heading -->\n\n<!-- wp:list {\"className\":\"medlux-checklist\"} -->\n<ul class=\"wp-block-list medlux-checklist\"><!-- wp:list-item -->\n<li>You have loose skin and excess fat on your thighs, for example after major weight loss or with age.</li>\n<!-- /wp:list-item -->\n<!-- wp:list-item -->\n<li>Your weight has been stable for some time.</li>\n<!-- /wp:list-item -->\n<!-- wp:list-item -->\n<li>You are in good general health.</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:paragraph {\"className\":\"medlux-suitable-note\"} -->\n<p class=\"medlux-suitable-note\">Whether the procedure is suitable for you is decided by the surgeon after a personal assessment.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Options</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-treatment-grid medlux-centered-cards medlux-cols-2\",\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"14rem\"}} -->\n<div class=\"wp-block-group medlux-treatment-grid medlux-centered-cards medlux-cols-2\"><!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:image {\"className\":\"medlux-card-icon\"} -->\n<figure class=\"wp-block-image medlux-card-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Inner thigh lift</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Incisions along the inner thighs for loose skin on the inside of the legs.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:image {\"className\":\"medlux-card-icon\"} -->\n<figure class=\"wp-block-image medlux-card-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Outer thigh lift</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Incisions along the outer thighs to tighten the outer contour.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">How the operation is performed</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-treatment-grid medlux-centered-cards medlux-stages\",\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"14rem\"}} -->\n<div class=\"wp-block-group medlux-treatment-grid medlux-centered-cards medlux-stages\"><!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:image {\"className\":\"medlux-card-icon\"} -->\n<figure class=\"wp-block-image medlux-card-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Consultation before surgery</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>The surgeon assesses the areas of concern, discusses your wishes and makes a personal surgical plan.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:image {\"className\":\"medlux-card-icon\"} -->\n<figure class=\"wp-block-image medlux-card-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Anaesthesia and preparation</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>You receive general anaesthesia. The area is marked to guide the incisions.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:image {\"className\":\"medlux-card-icon\"} -->\n<figure class=\"wp-block-image medlux-card-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Removing excess skin and fat</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Incisions are made along the inner or outer thighs; excess skin and fat are removed and the tissue underneath is tightened.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:image {\"className\":\"medlux-card-icon\"} -->\n<figure class=\"wp-block-image medlux-card-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Closure and recovery</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>The incisions are closed with sutures and compression garments are put on. You usually stay in hospital for 1\u20132 nights.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">How it works with MedLuxLife</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-steps medlux-steps\\u002d\\u002dlist\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group medlux-steps medlux-steps--list\"><!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\"><span class=\"medlux-step-no\">1</span>Contact and online consultation</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Contact us and tell us what you are interested in. We refer you to the right surgeon for an online consultation. Photos or medical documents go directly to the doctor, only on request.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\"><span class=\"medlux-step-no\">2</span>Your personal plan</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>The surgeon recommends the right approach for you. We plan your dates, flights, hotel and transfers around it.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\"><span class=\"medlux-step-no\">3</span>Arrival and surgery</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>After a pre-operative examination, the operation takes place as planned. You usually stay in hospital for 1\u20132 nights.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\"><span class=\"medlux-step-no\">4</span>Recovery in Istanbul</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>You rest in your hotel and attend the check-ups at the clinic. The surgeon decides when you are ready to fly home.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\"><span class=\"medlux-step-no\">5</span>Back home</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Stay in touch with us on WhatsApp \u2013 we help with follow-up questions.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Recovery step by step</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-treatment-grid medlux-centered-cards medlux-timeline\",\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"14rem\"}} -->\n<div class=\"wp-block-group medlux-treatment-grid medlux-centered-cards medlux-timeline\"><!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:paragraph {\"className\":\"medlux-time-label\"} -->\n<p class=\"medlux-time-label\">First days</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Walking is possible within hours, and light movement helps circulation. You usually stay in hospital for 1\u20132 nights.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:paragraph {\"className\":\"medlux-time-label\"} -->\n<p class=\"medlux-time-label\">First weeks</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Compression garments reduce swelling and support healing; strenuous activity should be avoided.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:paragraph {\"className\":\"medlux-time-label\"} -->\n<p class=\"medlux-time-label\">Later</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Sport and heavy exertion come back step by step, as advised by your surgeon.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Frequently asked questions</h2>\n<!-- /wp:heading -->\n\n<!-- wp:accordion {\"className\":\"medlux-faq\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|20\"}},\"layout\":{\"type\":\"default\"}} -->\n<div role=\"group\" class=\"wp-block-accordion medlux-faq\"><!-- wp:accordion-item {\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-accordion-item\"><!-- wp:accordion-heading -->\n<h3 class=\"wp-block-accordion-heading\"><button type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\">Do I need to wear compression garments?</span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">+</span></button></h3>\n<!-- /wp:accordion-heading -->\n\n<!-- wp:accordion-panel -->\n<div role=\"region\" class=\"wp-block-accordion-panel\"><!-- wp:paragraph -->\n<p>Yes, in the first weeks after surgery, to reduce swelling and support healing.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:accordion-panel --></div>\n<!-- /wp:accordion-item -->\n\n<!-- wp:accordion-item {\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-accordion-item\"><!-- wp:accordion-heading -->\n<h3 class=\"wp-block-accordion-heading\"><button type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\">When can I walk again?</span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">+</span></button></h3>\n<!-- /wp:accordion-heading -->\n\n<!-- wp:accordion-panel -->\n<div role=\"region\" class=\"wp-block-accordion-panel\"><!-- wp:paragraph -->\n<p>Walking is possible within hours of the operation; light movement is encouraged to aid circulation.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:accordion-panel --></div>\n<!-- /wp:accordion-item -->\n\n<!-- wp:accordion-item {\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-accordion-item\"><!-- wp:accordion-heading -->\n<h3 class=\"wp-block-accordion-heading\"><button type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\">Where are the incisions?</span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">+</span></button></h3>\n<!-- /wp:accordion-heading -->\n\n<!-- wp:accordion-panel -->\n<div role=\"region\" class=\"wp-block-accordion-panel\"><!-- wp:paragraph -->\n<p>Along the inner or outer thighs, depending on the area treated.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:accordion-panel --></div>\n<!-- /wp:accordion-item -->\n\n<!-- wp:accordion-item {\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-accordion-item\"><!-- wp:accordion-heading -->\n<h3 class=\"wp-block-accordion-heading\"><button type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\">How long should I stay in T\u00fcrkiye?</span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">+</span></button></h3>\n<!-- /wp:accordion-heading -->\n\n<!-- wp:accordion-panel -->\n<div role=\"region\" class=\"wp-block-accordion-panel\"><!-- wp:paragraph -->\n<p>This is planned individually with the clinic. We organise your flights and hotel accordingly.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:accordion-panel --></div>\n<!-- /wp:accordion-item -->\n\n<!-- wp:accordion-item {\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-accordion-item\"><!-- wp:accordion-heading -->\n<h3 class=\"wp-block-accordion-heading\"><button type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\">Should I send photos or medical documents to MedLuxLife?</span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">+</span></button></h3>\n<!-- /wp:accordion-heading -->\n\n<!-- wp:accordion-panel -->\n<div role=\"region\" class=\"wp-block-accordion-panel\"><!-- wp:paragraph -->\n<p>No. If the surgeon needs photos or documents, you share them directly with the doctor in your online consultation.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:accordion-panel --></div>\n<!-- /wp:accordion-item --></div>\n<!-- /wp:accordion --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-cta\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-cta\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Plan your thigh lift</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Contact us and tell us what you are interested in \u2013 we refer you to the right specialist for an online consultation.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"medlux-btn-primary\"} -->\n<div class=\"wp-block-button medlux-btn-primary\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://medluxlife.de/contact/\">Request a Free Consultation</a></div>\n<!-- /wp:button -->\n\n<!-- wp:button {\"className\":\"medlux-btn-whatsapp\"} -->\n<div class=\"wp-block-button medlux-btn-whatsapp\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://wa.me/380979092326\" target=\"_blank\" rel=\"noreferrer noopener\">WhatsApp</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->\n\n<!-- wp:paragraph {\"className\":\"medlux-disclaimer\"} -->\n<p class=\"medlux-disclaimer\">The information on this page is for general guidance only and does not replace a medical consultation. Suitability for any treatment is assessed individually by a qualified doctor.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n"}}