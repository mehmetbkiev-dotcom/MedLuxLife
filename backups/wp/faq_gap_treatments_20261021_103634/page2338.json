{"id": 2338, "modified": "2026-10-18T10:35:00", "content": {"raw": "<!-- wp:columns {\"verticalAlignment\":\"center\",\"className\":\"medlux-intro\"} -->\n<div class=\"wp-block-columns are-vertically-aligned-center medlux-intro\"><!-- wp:column {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\"><!-- wp:paragraph {\"className\":\"medlux-lead\"} -->\n<p class=\"medlux-lead\">Otoplasty reshapes or repositions prominent or asymmetric ears. It is possible for adults and for children from about 5\u20136 years of age, once the ears have finished growing. MedLuxLife arranges your online consultation with the surgeon in Istanbul and organises your stay.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\"><!-- wp:image {\"id\":1423,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-intro-img\"} -->\n<figure class=\"wp-block-image size-large medlux-intro-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/gemini-generated-image-qxu2efqxu2efqxu2-opt.jpg\" alt=\"Ear marked for otoplasty\" class=\"wp-image-1423\"/></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:group {\"className\":\"medlux-section medlux-facts-sec\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section medlux-facts-sec\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Quick facts</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-facts\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group medlux-facts\"><!-- wp:group {\"className\":\"medlux-fact\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-fact\"><!-- wp:image {\"className\":\"medlux-card-icon\"} -->\n<figure class=\"wp-block-image medlux-card-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:paragraph {\"className\":\"medlux-fact-label\"} -->\n<p class=\"medlux-fact-label\">Anaesthesia</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-fact-value\"} -->\n<p class=\"medlux-fact-value\">Local (adults), general (children)</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-fact\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-fact\"><!-- wp:image {\"className\":\"medlux-card-icon\"} -->\n<figure class=\"wp-block-image medlux-card-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:paragraph {\"className\":\"medlux-fact-label\"} -->\n<p class=\"medlux-fact-label\">Operation time</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-fact-value\"} -->\n<p class=\"medlux-fact-value\">About 1\u20131.5 hours</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-fact\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-fact\"><!-- wp:image {\"className\":\"medlux-card-icon\"} -->\n<figure class=\"wp-block-image medlux-card-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:paragraph {\"className\":\"medlux-fact-label\"} -->\n<p class=\"medlux-fact-label\">Daily activities</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-fact-value\"} -->\n<p class=\"medlux-fact-value\">After about 3\u20135 days</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-fact\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-fact\"><!-- wp:image {\"className\":\"medlux-card-icon\"} -->\n<figure class=\"wp-block-image medlux-card-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:paragraph {\"className\":\"medlux-fact-label\"} -->\n<p class=\"medlux-fact-label\">Headband</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-fact-value\"} -->\n<p class=\"medlux-fact-value\">For about 1\u20132 weeks</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-fact\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-fact\"><!-- wp:image {\"className\":\"medlux-card-icon\"} -->\n<figure class=\"wp-block-image medlux-card-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:paragraph {\"className\":\"medlux-fact-label\"} -->\n<p class=\"medlux-fact-label\">Stay in T\u00fcrkiye</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-fact-value\"} -->\n<p class=\"medlux-fact-value\">Planned individually with the clinic</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:paragraph {\"className\":\"medlux-facts-note\"} -->\n<p class=\"medlux-facts-note\">General information; your surgeon plans the details for you personally.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section medlux-suitable\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section medlux-suitable\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Who it may be suitable for</h2>\n<!-- /wp:heading -->\n\n<!-- wp:list {\"className\":\"medlux-checklist\"} -->\n<ul class=\"wp-block-list medlux-checklist\"><!-- wp:list-item -->\n<li>Your ears \u2013 or your child's ears \u2013 stick out or are asymmetric.</li>\n<!-- /wp:list-item -->\n<!-- wp:list-item -->\n<li>Adults and children from about 5\u20136 years of age, once the ears have finished growing.</li>\n<!-- /wp:list-item -->\n<!-- wp:list-item -->\n<li>Good general health.</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:paragraph {\"className\":\"medlux-suitable-note\"} -->\n<p class=\"medlux-suitable-note\">Whether the procedure is suitable for you is decided by the surgeon after a personal assessment.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">How the operation is performed</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-treatment-grid medlux-centered-cards medlux-stages\",\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"14rem\"}} -->\n<div class=\"wp-block-group medlux-treatment-grid medlux-centered-cards medlux-stages\"><!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:image {\"className\":\"medlux-card-icon\"} -->\n<figure class=\"wp-block-image medlux-card-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Consultation and planning</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>The surgeon examines the ears, discusses your wishes and plans the correction \u2013 for adults and for children from about 5\u20136 years.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:image {\"className\":\"medlux-card-icon\"} -->\n<figure class=\"wp-block-image medlux-card-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Anaesthesia</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Adults usually receive local anaesthesia, children general anaesthesia.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:image {\"className\":\"medlux-card-icon\"} -->\n<figure class=\"wp-block-image medlux-card-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Reshaping the cartilage</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Through an incision in the natural crease behind the ear, the cartilage is reshaped and the ear is set closer to the head with internal sutures.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:image {\"className\":\"medlux-card-icon\"} -->\n<figure class=\"wp-block-image medlux-card-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Closure and recovery</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>The incision is closed and a protective headband is put on; it is worn for about 1\u20132 weeks.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">How it works with MedLuxLife</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-steps medlux-steps\\u002d\\u002dlist\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group medlux-steps medlux-steps--list\"><!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\"><span class=\"medlux-step-no\">1</span>Contact and online consultation</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Contact us and tell us what you are interested in. We refer you to the right surgeon for an online consultation. Photos or medical documents go directly to the doctor, only on request.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\"><span class=\"medlux-step-no\">2</span>Your personal plan</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>The surgeon recommends the right approach for you. We plan your dates, flights, hotel and transfers around it.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\"><span class=\"medlux-step-no\">3</span>Arrival and surgery</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>After a pre-operative examination, the operation takes place as planned. Your surgeon tells you when you can return to your hotel.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\"><span class=\"medlux-step-no\">4</span>Recovery in Istanbul</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>You rest in your hotel and attend the check-ups at the clinic. The surgeon decides when you are ready to fly home.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\"><span class=\"medlux-step-no\">5</span>Back home</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Stay in touch with us on WhatsApp \u2013 we help with follow-up questions.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Recovery step by step</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-treatment-grid medlux-centered-cards medlux-timeline\",\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"14rem\"}} -->\n<div class=\"wp-block-group medlux-treatment-grid medlux-centered-cards medlux-timeline\"><!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:paragraph {\"className\":\"medlux-time-label\"} -->\n<p class=\"medlux-time-label\">First days</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>A protective headband is worn; mild swelling is normal.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:paragraph {\"className\":\"medlux-time-label\"} -->\n<p class=\"medlux-time-label\">Days 3\u20135</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Most people return to work, school and daily activities after about 3\u20135 days.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:paragraph {\"className\":\"medlux-time-label\"} -->\n<p class=\"medlux-time-label\">Weeks 1\u20132</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>The supportive headband is recommended for about 1\u20132 weeks to protect the new shape.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Frequently asked questions</h2>\n<!-- /wp:heading -->\n\n<!-- wp:accordion {\"className\":\"medlux-faq\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|20\"}},\"layout\":{\"type\":\"default\"}} -->\n<div role=\"group\" class=\"wp-block-accordion medlux-faq\"><!-- wp:accordion-item {\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-accordion-item\"><!-- wp:accordion-heading -->\n<h3 class=\"wp-block-accordion-heading\"><button type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\">From what age is otoplasty possible?</span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">+</span></button></h3>\n<!-- /wp:accordion-heading -->\n\n<!-- wp:accordion-panel -->\n<div role=\"region\" class=\"wp-block-accordion-panel\"><!-- wp:paragraph -->\n<p>For adults and for children from about 5\u20136 years of age, once the ears have finished growing.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:accordion-panel --></div>\n<!-- /wp:accordion-item -->\n\n<!-- wp:accordion-item {\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-accordion-item\"><!-- wp:accordion-heading -->\n<h3 class=\"wp-block-accordion-heading\"><button type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\">How long does it take?</span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">+</span></button></h3>\n<!-- /wp:accordion-heading -->\n\n<!-- wp:accordion-panel -->\n<div role=\"region\" class=\"wp-block-accordion-panel\"><!-- wp:paragraph -->\n<p>About 1\u20131.5 hours \u2013 under local anaesthesia for adults, general anaesthesia for children.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:accordion-panel --></div>\n<!-- /wp:accordion-item -->\n\n<!-- wp:accordion-item {\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-accordion-item\"><!-- wp:accordion-heading -->\n<h3 class=\"wp-block-accordion-heading\"><button type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\">Where is the incision?</span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">+</span></button></h3>\n<!-- /wp:accordion-heading -->\n\n<!-- wp:accordion-panel -->\n<div role=\"region\" class=\"wp-block-accordion-panel\"><!-- wp:paragraph -->\n<p>In the natural crease behind the ear.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:accordion-panel --></div>\n<!-- /wp:accordion-item -->\n\n<!-- wp:accordion-item {\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-accordion-item\"><!-- wp:accordion-heading -->\n<h3 class=\"wp-block-accordion-heading\"><button type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\">How long should I stay in T\u00fcrkiye?</span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">+</span></button></h3>\n<!-- /wp:accordion-heading -->\n\n<!-- wp:accordion-panel -->\n<div role=\"region\" class=\"wp-block-accordion-panel\"><!-- wp:paragraph -->\n<p>This is planned individually with the clinic. We organise your flights and hotel accordingly.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:accordion-panel --></div>\n<!-- /wp:accordion-item -->\n\n<!-- wp:accordion-item {\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-accordion-item\"><!-- wp:accordion-heading -->\n<h3 class=\"wp-block-accordion-heading\"><button type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\">Should I send photos or medical documents to MedLuxLife?</span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">+</span></button></h3>\n<!-- /wp:accordion-heading -->\n\n<!-- wp:accordion-panel -->\n<div role=\"region\" class=\"wp-block-accordion-panel\"><!-- wp:paragraph -->\n<p>No. If the surgeon needs photos or documents, you share them directly with the doctor in your online consultation.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:accordion-panel --></div>\n<!-- /wp:accordion-item --></div>\n<!-- /wp:accordion --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-cta\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-cta\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Plan your ear correction</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Contact us and tell us what you are interested in \u2013 we refer you to the right specialist for an online consultation.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"medlux-btn-primary\"} -->\n<div class=\"wp-block-button medlux-btn-primary\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://medluxlife.de/contact/\">Request a Free Consultation</a></div>\n<!-- /wp:button -->\n\n<!-- wp:button {\"className\":\"medlux-btn-whatsapp\"} -->\n<div class=\"wp-block-button medlux-btn-whatsapp\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://wa.me/380979092326\" target=\"_blank\" rel=\"noreferrer noopener\">WhatsApp</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->\n\n<!-- wp:paragraph {\"className\":\"medlux-disclaimer\"} -->\n<p class=\"medlux-disclaimer\">The information on this page is for general guidance only and does not replace a medical consultation. Suitability for any treatment is assessed individually by a qualified doctor.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n"}}