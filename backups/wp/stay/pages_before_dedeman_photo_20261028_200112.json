[{"id": 258, "content": "<!-- wp:columns {\"verticalAlignment\":\"center\",\"className\":\"medlux-intro\"} -->\n<div class=\"wp-block-columns are-vertically-aligned-center medlux-intro\"><!-- wp:column {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\"><!-- wp:paragraph {\"className\":\"medlux-lead\"} -->\n<p class=\"medlux-lead\">Our clinical treatments cover aesthetic, dental and hair treatments, weight-loss surgery, health check-ups and IV therapies. Experienced partner clinics carry out each treatment, while MedLuxLife plans your appointments, travel and stay and remains your point of contact throughout.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\"><!-- wp:image {\"id\":1094,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-intro-img\"} -->\n<figure class=\"wp-block-image size-large medlux-intro-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/medluxlife-ai-n258.jpg\" alt=\"Patient coordinator welcoming an international patient at a modern clinic reception\" class=\"wp-image-1094\"/></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Our clinical treatments</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-treatment-grid\",\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"20rem\"}} -->\n<div class=\"wp-block-group medlux-treatment-grid\"><!-- wp:group {\"className\":\"medlux-card medlux-card\\u002d\\u002dphoto\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card medlux-card--photo\"><!-- wp:image {\"id\":1074,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-card-img\"} -->\n<figure class=\"wp-block-image size-large medlux-card-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/medluxlife-ai-m741.jpg\" alt=\"Smiling patient during a dental check-up\" class=\"wp-image-1074\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Dental and Oral Health</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Hollywood Smile, implants, zirconium veneers, orthodontics and complete dental care.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-more\"} -->\n<p class=\"medlux-more\"><a href=\"https://medluxlife.de/health/clinical-treatments/dental-and-oral-health/\">Learn more →</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card medlux-card\\u002d\\u002dphoto\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card medlux-card--photo\"><!-- wp:image {\"id\":1392,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-card-img\"} -->\n<figure class=\"wp-block-image size-large medlux-card-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/hair-transplantation-patient.jpg\" alt=\"Smiling man with full, natural hair in a bright clinic\" class=\"wp-image-1392\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Hair Transplantation</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>FUE, Sapphire FUE and DHI hair, beard and eyebrow transplants, plus restorative hair therapies.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-more\"} -->\n<p class=\"medlux-more\"><a href=\"https://medluxlife.de/health/clinical-treatments/hair-transplantation/\">Learn more →</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card medlux-card\\u002d\\u002dphoto\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card medlux-card--photo\"><!-- wp:image {\"id\":1326,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-card-img\"} -->\n<figure class=\"wp-block-image size-large medlux-card-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/kosmetische-gesichtsmarkierungen-beim-vorgesprach-opt.jpg\" alt=\"Doctor marking a woman&#x27;s face before a facelift consultation\" class=\"wp-image-1326\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Plastic Surgery</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Face and body procedures, from rhinoplasty and facelift to mommy makeover and liposuction.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-more\"} -->\n<p class=\"medlux-more\"><a href=\"https://medluxlife.de/health/clinical-treatments/plastic-surgery/\">Learn more →</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card medlux-card\\u002d\\u002dphoto\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card medlux-card--photo\"><!-- wp:image {\"id\":1408,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-card-img\"} -->\n<figure class=\"wp-block-image size-large medlux-card-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/gemini-generated-image-91hl6a91hl6a91hl-opt.jpg\" alt=\"Woman with smooth skin and facial lifting lines on a light background\" class=\"wp-image-1408\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Medical Aesthetics</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Botox, dermal fillers, mesotherapy and exosome treatments with little or no downtime.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-more\"} -->\n<p class=\"medlux-more\"><a href=\"https://medluxlife.de/health/clinical-treatments/medical-aesthetics/\">Learn more →</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card medlux-card\\u002d\\u002dphoto\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card medlux-card--photo\"><!-- wp:image {\"id\":1352,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-card-img\"} -->\n<figure class=\"wp-block-image size-large medlux-card-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/beratung-zu-bariatrischen-operationsoptionen-2-opt.jpg\" alt=\"Surgeon explaining gastric surgery options with stomach models\" class=\"wp-image-1352\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Bariatric Surgery</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Gastric sleeve, gastric bypass and gastric balloon in a supportive, respectful setting.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-more\"} -->\n<p class=\"medlux-more\"><a href=\"https://medluxlife.de/health/clinical-treatments/bariatric-surgery/\">Learn more →</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card medlux-card\\u002d\\u002dphoto\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card medlux-card--photo\"><!-- wp:image {\"id\":1081,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-card-img\"} -->\n<figure class=\"wp-block-image size-large medlux-card-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/medluxlife-ai-m881.jpg\" alt=\"Doctor measuring a patient's blood pressure\" class=\"wp-image-1081\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Check-Up Packages</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Comprehensive health check-ups for men and women, tailored to every stage of life.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-more\"} -->\n<p class=\"medlux-more\"><a href=\"https://medluxlife.de/health/clinical-treatments/check-up-packages/\">Learn more →</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card medlux-card\\u002d\\u002dphoto\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card medlux-card--photo\"><!-- wp:image {\"id\":1096,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-card-img\"} -->\n<figure class=\"wp-block-image size-large medlux-card-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/medluxlife-ai-m882.jpg\" alt=\"Woman relaxing during an IV infusion\" class=\"wp-image-1096\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">IV Treatments</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Vitamin and nutrient infusions to support energy, regeneration and well-being.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-more\"} -->\n<p class=\"medlux-more\"><a href=\"https://medluxlife.de/health/clinical-treatments/iv-treatments/\">Learn more →</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">How MedLuxLife supports you</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-steps\",\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"20rem\"}} -->\n<div class=\"wp-block-group medlux-steps\"><!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">1. Free consultation</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Contact us and tell us what you are interested in. We advise you and refer you to the right specialist in Türkiye for an online consultation. Medical documents go directly to the doctor, only on request.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">2. Personal treatment plan</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Our partner specialists prepare a treatment plan and an estimated timeline tailored to you.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">3. Travel &amp; treatment</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>We coordinate your appointments, your stay at the five-star Dedeman Kozyatağı and your transfers in a VIP vehicle, so you can focus on your treatment.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">4. Aftercare</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>We stay in touch after you return home and help with follow-up questions.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section medlux-stay\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section medlux-stay\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Your stay and transfers</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"medlux-stay-intro\"} -->\n<p class=\"medlux-stay-intro\">For clinic treatments, accommodation and transfers are part of your treatment package.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\":\"medlux-treatment-grid medlux-stay-grid\",\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"20rem\"}} -->\n<div class=\"wp-block-group medlux-treatment-grid medlux-stay-grid\"><!-- wp:group {\"className\":\"medlux-card medlux-card\\u002d\\u002dphoto\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card medlux-card--photo\"><!-- wp:image {\"id\":2605,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-card-img\"} -->\n<figure class=\"wp-block-image size-large medlux-card-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/medluxlife-hotel-room-symbolic.jpg\" alt=\"Hotel room with a large bed and a city view at night (symbolic image)\" class=\"wp-image-2605\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Five-star hotel: Dedeman Kozyatağı</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>You stay at the five-star Dedeman Kozyatağı hotel in Istanbul. Your treatment package includes accommodation for you and one companion, with breakfast.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card medlux-card\\u002d\\u002dphoto\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card medlux-card--photo\"><!-- wp:image {\"id\":3265,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-card-img\"} -->\n<figure class=\"wp-block-image size-large medlux-card-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/medluxlife-vip-transfer-vehicle.jpg\" alt=\"Black VIP vehicle for patient transfers in front of a modern building\" class=\"wp-image-3265\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">VIP Transfer Service</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>All transfers – from the airport to your hotel, between the hotel and the clinic, and back to the airport – are made in a VIP vehicle.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n</div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-cta\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-cta\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Plan your treatment with confidence</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Every treatment begins with a personal, no-obligation consultation. Contact us and we will get back to you as soon as possible.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"medlux-btn-primary\"} -->\n<div class=\"wp-block-button medlux-btn-primary\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://medluxlife.de/contact/\">Request a Free Consultation</a></div>\n<!-- /wp:button -->\n\n<!-- wp:button {\"className\":\"medlux-btn-whatsapp\"} -->\n<div class=\"wp-block-button medlux-btn-whatsapp\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://wa.me/380979092326\" target=\"_blank\" rel=\"noreferrer noopener\">WhatsApp</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->\n\n<!-- wp:paragraph {\"className\":\"medlux-disclaimer\"} -->\n<p class=\"medlux-disclaimer\">The information on this page is for general guidance only and does not replace a medical consultation. Suitability for any treatment is assessed individually by a qualified doctor.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->"}, {"id": 2918, "content": "<!-- wp:columns {\"verticalAlignment\":\"center\",\"className\":\"medlux-intro\"} -->\n<div class=\"wp-block-columns are-vertically-aligned-center medlux-intro\"><!-- wp:column {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\"><!-- wp:paragraph {\"className\":\"medlux-lead\"} -->\n<p class=\"medlux-lead\">Celyxmed is a clinic in Ataşehir, Istanbul, for plastic surgery, hair transplantation, dental treatments and medical aesthetics. Surgical procedures take place in JCI-accredited partner hospitals. MedLuxLife coordinates clinical treatments with Celyxmed.</p>\n<!-- /wp:paragraph -->\n\n</div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\"><!-- wp:image {\"id\":2577,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-intro-img\"} -->\n<figure class=\"wp-block-image size-large medlux-intro-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/partner-celyxmed-clinic-atasehir.jpg\" alt=\"Entrance of the Celyxmed clinic building in Ataşehir, Istanbul\" class=\"wp-image-2577\"/></figure>\n<!-- /wp:image -->\n\n</div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:group {\"className\":\"medlux-section medlux-partner-certs\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section medlux-partner-certs\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Certificates</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-cert-group\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group medlux-cert-group\"><!-- wp:group {\"className\":\"medlux-cert-grid\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group medlux-cert-grid\"><!-- wp:group {\"className\":\"medlux-cert\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group medlux-cert\"><!-- wp:image {\"id\":2595,\"sizeSlug\":\"full\",\"linkDestination\":\"media\",\"className\":\"medlux-cert-img\"} -->\n<figure class=\"wp-block-image size-full medlux-cert-img\"><a href=\"https://medluxlife.de/wp-content/uploads/2026/10/cert-celyxmed-ushas.png\" target=\"_blank\" rel=\"noopener\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/cert-celyxmed-ushas.png\" alt=\"USHAŞ – International Health Services logo\" class=\"wp-image-2595\"/></a></figure>\n<!-- /wp:image -->\n\n<!-- wp:paragraph {\"className\":\"medlux-cert-title\"} -->\n<p class=\"medlux-cert-title\">USHAŞ certificate</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-cert-sub\"} -->\n<p class=\"medlux-cert-sub\">International health tourism · Turkish Ministry of Health</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-cert\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group medlux-cert\"><!-- wp:image {\"id\":2596,\"sizeSlug\":\"full\",\"linkDestination\":\"media\",\"className\":\"medlux-cert-img\"} -->\n<figure class=\"wp-block-image size-full medlux-cert-img\"><a href=\"https://medluxlife.de/wp-content/uploads/2026/10/cert-celyxmed-iso-9001.png\" target=\"_blank\" rel=\"noopener\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/cert-celyxmed-iso-9001.png\" alt=\"ISO 9001:2015 quality management seal\" class=\"wp-image-2596\"/></a></figure>\n<!-- /wp:image -->\n\n<!-- wp:paragraph {\"className\":\"medlux-cert-title\"} -->\n<p class=\"medlux-cert-title\">ISO 9001:2015</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-cert-sub\"} -->\n<p class=\"medlux-cert-sub\">Quality management system</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-cert\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group medlux-cert\"><!-- wp:image {\"id\":2597,\"sizeSlug\":\"full\",\"linkDestination\":\"media\",\"className\":\"medlux-cert-img\"} -->\n<figure class=\"wp-block-image size-full medlux-cert-img\"><a href=\"https://medluxlife.de/wp-content/uploads/2026/10/cert-celyxmed-iso-13485.png\" target=\"_blank\" rel=\"noopener\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/cert-celyxmed-iso-13485.png\" alt=\"ISO 13485:2016 quality management seal\" class=\"wp-image-2597\"/></a></figure>\n<!-- /wp:image -->\n\n<!-- wp:paragraph {\"className\":\"medlux-cert-title\"} -->\n<p class=\"medlux-cert-title\">ISO 13485:2016</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-cert-sub\"} -->\n<p class=\"medlux-cert-sub\">Quality management – medical devices</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n</div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Clinic and doctors</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-treatment-grid\",\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"20rem\"}} -->\n<div class=\"wp-block-group medlux-treatment-grid\"><!-- wp:group {\"className\":\"medlux-card medlux-card\\u002d\\u002dphoto\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card medlux-card--photo\"><!-- wp:image {\"id\":2911,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-card-img\"} -->\n<figure class=\"wp-block-image size-large medlux-card-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/medluxlife-celyxmed-clinic-c1.jpg\" alt=\"Building of the Celyxmed clinic in Ataşehir\" class=\"wp-image-2911\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Clinic</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Location, facilities and photos of the Celyxmed clinic in Ataşehir.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-more\"} -->\n<p class=\"medlux-more\"><a href=\"https://medluxlife.de/partners/celyxmed/clinic/\">Learn more →</a></p>\n<!-- /wp:paragraph -->\n\n</div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card medlux-card\\u002d\\u002dphoto\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card medlux-card--photo\"><!-- wp:image {\"id\":3462,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-card-img\"} -->\n<figure class=\"wp-block-image size-large medlux-card-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/medluxlife-celyxmed-doctors-team.jpg\" alt=\"Doctors of the Celyxmed clinic\" class=\"wp-image-3462\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Doctors</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>The doctors and dentists of Celyxmed with their education and areas of interest.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-more\"} -->\n<p class=\"medlux-more\"><a href=\"https://medluxlife.de/partners/celyxmed/doctors/\">Meet the doctors →</a></p>\n<!-- /wp:paragraph -->\n\n</div>\n<!-- /wp:group -->\n\n</div>\n<!-- /wp:group -->\n\n</div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section medlux-stay\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section medlux-stay\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Your stay and transfers</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"medlux-stay-intro\"} -->\n<p class=\"medlux-stay-intro\">For clinic treatments, accommodation and transfers are part of your treatment package.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\":\"medlux-treatment-grid medlux-stay-grid\",\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"20rem\"}} -->\n<div class=\"wp-block-group medlux-treatment-grid medlux-stay-grid\"><!-- wp:group {\"className\":\"medlux-card medlux-card\\u002d\\u002dphoto\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card medlux-card--photo\"><!-- wp:image {\"id\":2605,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-card-img\"} -->\n<figure class=\"wp-block-image size-large medlux-card-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/medluxlife-hotel-room-symbolic.jpg\" alt=\"Hotel room with a large bed and a city view at night (symbolic image)\" class=\"wp-image-2605\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Five-star hotel: Dedeman Kozyatağı</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>You stay at the five-star Dedeman Kozyatağı hotel in Istanbul. Your treatment package includes accommodation for you and one companion, with breakfast.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card medlux-card\\u002d\\u002dphoto\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card medlux-card--photo\"><!-- wp:image {\"id\":3265,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-card-img\"} -->\n<figure class=\"wp-block-image size-large medlux-card-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/medluxlife-vip-transfer-vehicle.jpg\" alt=\"Black VIP vehicle for patient transfers in front of a modern building\" class=\"wp-image-3265\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">VIP Transfer Service</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>All transfers – from the airport to your hotel, between the hotel and the clinic, and back to the airport – are made in a VIP vehicle.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n</div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-cta\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-cta\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Plan your treatment with confidence</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Every treatment begins with a personal, no-obligation consultation. Contact us and we will get back to you as soon as possible.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"medlux-btn-primary\"} -->\n<div class=\"wp-block-button medlux-btn-primary\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://medluxlife.de/contact/\">Request a Free Consultation</a></div>\n<!-- /wp:button -->\n\n<!-- wp:button {\"className\":\"medlux-btn-whatsapp\"} -->\n<div class=\"wp-block-button medlux-btn-whatsapp\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://wa.me/380979092326\" target=\"_blank\" rel=\"noreferrer noopener\">WhatsApp</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->\n\n<!-- wp:paragraph {\"className\":\"medlux-disclaimer\"} -->\n<p class=\"medlux-disclaimer\">The information on this page is for general guidance only and does not replace a medical consultation. Suitability for any treatment is assessed individually by a qualified doctor.</p>\n<!-- /wp:paragraph -->\n\n</div>\n<!-- /wp:group -->\n"}]