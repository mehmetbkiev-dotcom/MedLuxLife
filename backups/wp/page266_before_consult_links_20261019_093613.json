{"id": 266, "date": "2026-10-01T15:41:58", "date_gmt": "2026-10-01T15:41:58", "guid": {"rendered": "https://medluxlife.de/health/clinical-treatments/check-up-packages/", "raw": "https://medluxlife.de/health/clinical-treatments/check-up-packages/"}, "modified": "2026-10-18T08:05:18", "modified_gmt": "2026-10-18T08:05:18", "password": "", "slug": "check-up-packages", "status": "publish", "type": "page", "link": "https://medluxlife.de/health/clinical-treatments/check-up-packages/", "title": {"raw": "Check-Up Packages", "rendered": "Check-Up Packages"}, "content": {"raw": "<!-- wp:columns {\"verticalAlignment\":\"center\",\"className\":\"medlux-intro\"} -->\n<div class=\"wp-block-columns are-vertically-aligned-center medlux-intro\"><!-- wp:column {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\"><!-- wp:paragraph {\"className\":\"medlux-lead\"} -->\n<p class=\"medlux-lead\">Regular check-ups help healthy people stay healthy. Many conditions can be detected before they cause any symptoms, when treatment is often simpler and more effective. Our check-up packages are tailored to your age and the health needs of your stage of life and are carried out at partner hospitals.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\"><!-- wp:image {\"id\":1300,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-intro-img\"} -->\n<figure class=\"wp-block-image size-large medlux-intro-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/gesundheitscheck-infografik-auf-klemmbrett-1-opt.jpg\" alt=\"Health check-up overview on a clipboard\" class=\"wp-image-1300\"/></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Check-up packages</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-treatment-grid\",\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"20rem\"}} -->\n<div class=\"wp-block-group medlux-treatment-grid\"><!-- wp:group {\"className\":\"medlux-card medlux-card\\u002d\\u002dphoto\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card medlux-card--photo\"><!-- wp:image {\"id\":1082,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-card-img\"} -->\n<figure class=\"wp-block-image size-large medlux-card-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/medluxlife-ai-m883.jpg\" alt=\"Doctors walking in a hospital corridor\" class=\"wp-image-1082\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Check-ups for Men</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Packages tailored to each stage of life:</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>Under 40</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Over 40</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Over 50</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Over 65</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card medlux-card\\u002d\\u002dphoto\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card medlux-card--photo\"><!-- wp:image {\"id\":1083,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-card-img\"} -->\n<figure class=\"wp-block-image size-large medlux-card-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/medluxlife-ai-m884.jpg\" alt=\"Medical team in a modern hospital\" class=\"wp-image-1083\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Check-ups for Women</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Packages tailored to each stage of life:</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>Under 40</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Over 40</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Over 50</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Over 65</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:paragraph -->\n<p>The exact content of each package (laboratory tests, imaging and specialist consultations) is shared with you during your consultation, so you can choose the package that suits you best.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">How MedLuxLife supports you</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-steps\",\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"20rem\"}} -->\n<div class=\"wp-block-group medlux-steps\"><!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">1. Free consultation</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Contact us and tell us what you are interested in. We advise you and refer you to the right specialist in T\u00fcrkiye for an online consultation. Medical documents go directly to the doctor, only on request.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">2. Personal treatment plan</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Our partner specialists prepare a treatment plan and an estimated timeline tailored to you.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">3. Travel &amp; treatment</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>We coordinate your appointments, hotel and airport transfers, so you can focus on your treatment.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">4. Aftercare</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>We stay in touch after you return home and help with follow-up questions.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-cta\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-cta\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Plan your check-up with confidence</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Every treatment begins with a personal, no-obligation consultation. Contact us and we will get back to you as soon as possible.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"medlux-btn-primary\"} -->\n<div class=\"wp-block-button medlux-btn-primary\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://medluxlife.de/contact/\">Request a Free Consultation</a></div>\n<!-- /wp:button -->\n\n<!-- wp