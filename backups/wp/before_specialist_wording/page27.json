{"id": 27, "content": {"raw": "<!-- wp:columns {\"verticalAlignment\":\"center\",\"className\":\"medlux-intro\"} -->\n<div class=\"wp-block-columns are-vertically-aligned-center medlux-intro\"><!-- wp:column {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\"><!-- wp:paragraph {\"className\":\"medlux-lead\"} -->\n<p class=\"medlux-lead\">MedLuxLife connects you with professional healthcare and carefully plans every step of your journey. Whether you are looking for an aesthetic or dental treatment or for specialist hospital care, we help you find the right specialists, prepare your treatment and organise your stay.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\"><!-- wp:image {\"id\":1327,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-intro-img\"} -->\n<figure class=\"wp-block-image size-large medlux-intro-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/chatgpt-gorseli-11-eki-2026-11-22-44-opt.jpg\" alt=\"Doctor welcoming an international patient couple\" class=\"wp-image-1327\"/></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Our health services</h2>\n<!-- /wp:heading -->\n\n<!-- wp:columns {\"className\":\"medlux-hub\"} -->\n<div class=\"wp-block-columns medlux-hub\"><!-- wp:column {\"className\":\"medlux-hub-box\"} -->\n<div class=\"wp-block-column medlux-hub-box\"><!-- wp:image {\"id\":1328,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-hub-img\"} -->\n<figure class=\"wp-block-image size-large medlux-hub-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/chatgpt-gorseli-11-eki-2026-15-15-14-opt.jpg\" alt=\"Modern private clinic treatment room\" class=\"wp-image-1328\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Clinical Treatments</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Aesthetic, dental and hair treatments, weight-loss surgery, check-ups and IV therapies with experienced partner clinics.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/clinical-treatments/dental-and-oral-health/\">Dental and Oral Health</a></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/clinical-treatments/hair-transplantation/\">Hair Transplantation</a></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/clinical-treatments/plastic-surgery/\">Plastic Surgery</a></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/clinical-treatments/medical-aesthetics/\">Medical Aesthetics</a></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/clinical-treatments/bariatric-surgery/\">Bariatric Surgery</a></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/clinical-treatments/check-up-packages/\">Check-Up Packages</a></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/clinical-treatments/iv-treatments/\">IV Treatments</a></li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"medlux-btn-primary\"} -->\n<div class=\"wp-block-button medlux-btn-primary\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://medluxlife.de/health/clinical-treatments/\">View all clinical treatments</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"className\":\"medlux-hub-box\"} -->\n<div class=\"wp-block-column medlux-hub-box\"><!-- wp:image {\"id\":1329,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-hub-img\"} -->\n<figure class=\"wp-block-image size-large medlux-hub-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/lachelndes-op-team-im-modernen-operationssaal-opt.jpg\" alt=\"Friendly medical team in a modern operating room\" class=\"wp-image-1329\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Hospital &amp; Specialist Treatments</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Specialist hospital care across more than 70 departments, from oncology and cardiology to transplantation and fertility treatment.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/ophthalmology/\">Ophthalmology</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/orthopedics-and-traumatology/\">Orthopedics and Traumatology</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/cardiology/\">Cardiology</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/medical-oncology/\">Medical Oncology</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/in-vitro-fertilization-ivf/\">In-Vitro Fertilization (IVF)</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/organ-transplantation-center/\">Organ Transplantation Center</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/neurosurgery/\">Neurosurgery</a></li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"medlux-btn-primary\"} -->\n<div class=\"wp-block-button medlux-btn-primary\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://medluxlife.de/health/hospital-specialist-treatments/\">View all departments</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-why\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-why\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Why MedLuxLife</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-why-grid\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group medlux-why-grid\"><!-- wp:group {\"className\":\"medlux-why-item\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-why-item\"><!-- wp:image {\"className\":\"medlux-why-icon\"} -->\n<figure class=\"wp-block-image medlux-why-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Personal coordinator</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>[trp_language language=\"en_GB\"]One contact person who speaks your language \u2014 Turkish, Ukrainian, Russian, English or German \u2014 and accompanies you from the first question to your return home.[/trp_language][trp_language language=\"de_DE\"]Eine feste Ansprechperson, die Ihre Sprache spricht \u2013 T\u00fcrkisch, Ukrainisch, Russisch, Englisch oder Deutsch \u2013 und Sie von der ersten Frage bis zur Heimreise begleitet.[/trp_language][trp_language language=\"tr_TR\"]Dilinizi konu\u015fan \u2014 T\u00fcrk\u00e7e, Ukraynaca, Rus\u00e7a, \u0130ngilizce veya Almanca \u2014 ve ilk sorunuzdan eve d\u00f6n\u00fc\u015f\u00fcn\u00fcze kadar size e\u015flik eden tek bir irtibat ki\u015fisi.[/trp_language]</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-why-item\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-why-item\"><!-- wp:image {\"className\":\"medlux-why-icon\"} -->\n<figure class=\"wp-block-image medlux-why-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Trusted partners</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Carefully selected clinics and hospitals with experienced specialists.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-why-item\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-why-item\"><!-- wp:image {\"className\":\"medlux-why-icon\"} -->\n<figure class=\"wp-block-image medlux-why-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Treatment and travel in one plan</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Appointments, hotel, flights and airport transfers, coordinated for you.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-why-item\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-why-item\"><!-- wp:image {\"className\":\"medlux-why-icon\"} -->\n<figure class=\"wp-block-image medlux-why-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Aftercare</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>We stay in touch after your treatment and help with follow-up questions.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:paragraph {\"className\":\"medlux-why-note\"} -->\n<p class=\"medlux-why-note\">[trp_language language=\"en_GB\"]Native-speaking interpreters for English, German, French, Italian, Spanish, Arabic, Turkish, Russian and Ukrainian are available at our partner clinics whenever you need them.[/trp_language][trp_language language=\"de_DE\"]In unseren Partnerkliniken stehen bei Bedarf muttersprachliche Dolmetscherinnen und Dolmetscher f\u00fcr Englisch, Deutsch, Franz\u00f6sisch, Italienisch, Spanisch, Arabisch, T\u00fcrkisch, Russisch und Ukrainisch zur Verf\u00fcgung.[/trp_language][trp_language language=\"tr_TR\"]Partner kliniklerimizde \u0130ngilizce, Almanca, Frans\u0131zca, \u0130talyanca, \u0130spanyolca, Arap\u00e7a, T\u00fcrk\u00e7e, Rus\u00e7a ve Ukraynaca i\u00e7in anadili d\u00fczeyinde terc\u00fcmanlar ihtiya\u00e7 duydu\u011funuz her an haz\u0131rd\u0131r.[/trp_language]</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">How MedLuxLife supports you</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-steps\",\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"20rem\"}} -->\n<div class=\"wp-block-group medlux-steps\"><!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">1. Free consultation</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Tell us your wishes \u2013 we answer your questions, explain the options and arrange an online consultation with a specialist in T\u00fcrkiye. Medical documents go directly to the doctor, only on request.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">2. Personal treatment plan</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Our partner specialists prepare a treatment plan and an estimated timeline tailored to you.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">3. Travel &amp; treatment</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>We coordinate your appointments, hotel and airport transfers, so you can focus on your treatment.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">4. Aftercare</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>We stay in touch after you return home and help with follow-up questions.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-cta\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-cta\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Plan your treatment with confidence</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Every treatment begins with a personal, no-obligation consultation. Contact us and we will get back to you as soon as possible.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"medlux-btn-primary\"} -->\n<div class=\"wp-block-button medlux-btn-primary\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://medluxlife.de/contact/\">Request a Free Consultation</a></div>\n<!-- /wp:button -->\n\n<!-- wp:button {\"className\":\"medlux-btn-whatsapp\"} -->\n<div class=\"wp-block-button medlux-btn-whatsapp\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://wa.me/380979092326\" target=\"_blank\" rel=\"noreferrer noopener\">WhatsApp</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->\n\n<!-- wp:paragraph {\"className\":\"medlux-disclaimer\"} -->\n<p class=\"medlux-disclaimer\">The information on this page is for general guidance only and does not replace a medical consultation. Suitability for any treatment is assessed individually by a qualified doctor.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->"}}