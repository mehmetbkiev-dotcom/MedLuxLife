{"id": 259, "content": {"raw": "<!-- wp:columns {\"verticalAlignment\":\"center\",\"className\":\"medlux-intro\"} -->\n<div class=\"wp-block-columns are-vertically-aligned-center medlux-intro\"><!-- wp:column {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\"><!-- wp:paragraph {\"className\":\"medlux-lead\"} -->\n<p class=\"medlux-lead\">Beyond our clinical treatments, MedLuxLife coordinates access to specialist hospital care across a wide range of medical fields, from cardiology and oncology to transplantation and fertility treatment. We help you obtain a medical opinion, plan your treatment with partner hospitals and organise your travel and stay.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\"><!-- wp:image {\"id\":1329,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-intro-img\"} -->\n<figure class=\"wp-block-image size-large medlux-intro-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/lachelndes-op-team-im-modernen-operationssaal-opt.jpg\" alt=\"Friendly medical team in a modern operating room\" class=\"wp-image-1329\"/></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Most requested specialties</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-treatment-grid\",\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"20rem\"}} -->\n<div class=\"wp-block-group medlux-treatment-grid\"><!-- wp:group {\"className\":\"medlux-card medlux-card\\u002d\\u002dphoto\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card medlux-card--photo\"><!-- wp:image {\"id\":1794,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-card-img\"} -->\n<figure class=\"wp-block-image size-large medlux-card-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/ophthalmology-intro-1.jpg\" alt=\"Ophthalmologist examining a patient&#x27;s eyes with a slit lamp in a modern eye clinic\" class=\"wp-image-1794\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Ophthalmology</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Cataract, refractive (laser) surgery, retina and other eye treatments.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-more\"} -->\n<p class=\"medlux-more\"><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/ophthalmology/\">Learn more \u2192</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card medlux-card\\u002d\\u002dphoto\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card medlux-card--photo\"><!-- wp:image {\"id\":1791,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-card-img\"} -->\n<figure class=\"wp-block-image size-large medlux-card-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/orthopedics-and-traumatology-intro-1.jpg\" alt=\"Orthopaedic specialist examining a patient&#x27;s knee, with knee X-rays on the monitors\" class=\"wp-image-1791\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Orthopedics and Traumatology</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Joint replacement, arthroscopy, spine and sports injuries, with rehabilitation.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-more\"} -->\n<p class=\"medlux-more\"><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/orthopedics-and-traumatology/\">Learn more \u2192</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card medlux-card\\u002d\\u002dphoto\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card medlux-card--photo\"><!-- wp:image {\"id\":1486,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-card-img\"} -->\n<figure class=\"wp-block-image size-large medlux-card-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/cardiology-intro.jpg\" alt=\"Cardiologist measuring a patient&#x27;s blood pressure in a bright consultation room\" class=\"wp-image-1486\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Cardiology</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Heart check-ups, diagnostics and interventional procedures for heart and vascular conditions.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-more\"} -->\n<p class=\"medlux-more\"><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/cardiology/\">Learn more \u2192</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card medlux-card\\u002d\\u002dphoto\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card medlux-card--photo\"><!-- wp:image {\"id\":1583,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-card-img\"} -->\n<figure class=\"wp-block-image size-large medlux-card-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/medical-oncology-intro.jpg\" alt=\"Nurse caring for a smiling patient in a bright infusion centre\" class=\"wp-image-1583\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Medical Oncology</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Diagnosis, second opinions and modern cancer treatment planned by multidisciplinary teams.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-more\"} -->\n<p class=\"medlux-more\"><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/medical-oncology/\">Learn more \u2192</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card medlux-card\\u002d\\u002dphoto\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card medlux-card--photo\"><!-- wp:image {\"id\":1586,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-card-img\"} -->\n<figure class=\"wp-block-image size-large medlux-card-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/in-vitro-fertilization-ivf-intro.jpg\" alt=\"Fertility specialist explaining embryo images to a couple\" class=\"wp-image-1586\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">In-Vitro Fertilization (IVF)</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Fertility assessment and assisted reproduction with personal, discreet care.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-more\"} -->\n<p class=\"medlux-more\"><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/in-vitro-fertilization-ivf/\">Learn more \u2192</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card medlux-card\\u002d\\u002dphoto\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card medlux-card--photo\"><!-- wp:image {\"id\":1489,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-card-img\"} -->\n<figure class=\"wp-block-image size-large medlux-card-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/organ-transplantation-center-intro-1.jpg\" alt=\"Transplant team discussing a treatment plan on a tablet in a hospital corridor\" class=\"wp-image-1489\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Organ Transplantation Center</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Kidney and liver transplantation, including living-donor programmes.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-more\"} -->\n<p class=\"medlux-more\"><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/organ-transplantation-center/\">Learn more \u2192</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card medlux-card\\u002d\\u002dphoto\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card medlux-card--photo\"><!-- wp:image {\"id\":1530,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-card-img\"} -->\n<figure class=\"wp-block-image size-large medlux-card-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/neurosurgery-intro.jpg\" alt=\"Neurosurgical team operating with a surgical microscope in a modern operating room\" class=\"wp-image-1530\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Neurosurgery</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Surgery of the brain, spine and nerves using modern, minimally invasive techniques.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-more\"} -->\n<p class=\"medlux-more\"><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/neurosurgery/\">Learn more \u2192</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">All departments</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Our partner hospitals cover the following departments. If you do not find your condition here, contact us and we will check the options for you.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\":\"medlux-treatment-grid medlux-dept-grid\",\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"20rem\"}} -->\n<div class=\"wp-block-group medlux-treatment-grid medlux-dept-grid\"><!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Cancer care</h3>\n<!-- /wp:heading -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/adult-bone-marrow-transplantation/\">Adult Bone Marrow Transplantation</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/gynaecological-oncology/\">Gynaecological Oncology</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/haematology/\">Haematology</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/medical-oncology/\">Medical Oncology</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/nuclear-medicine/\">Nuclear Medicine</a></li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Heart and vascular</h3>\n<!-- /wp:heading -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/cardiology/\">Cardiology</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/cardiovascular-surgery/\">Cardiovascular Surgery</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/interventional-radiology/\">Interventional Radiology</a></li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Brain, nerves and mental health</h3>\n<!-- /wp:heading -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/algology-pain-medicine/\">Algology (Pain Medicine)</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/neurology/\">Neurology</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/neurosurgery/\">Neurosurgery</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/psychiatry/\">Psychiatry</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/psychology/\">Psychology</a></li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Bones, joints and rehabilitation</h3>\n<!-- /wp:heading -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/orthopedics-and-traumatology/\">Orthopedics and Traumatology</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/physical-therapy-and-rehabilitation/\">Physical Therapy and Rehabilitation</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/rheumatology/\">Rheumatology</a></li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Transplantation</h3>\n<!-- /wp:heading -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/kidney-transplant-clinic/\">Kidney Transplant Clinic</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/liver-transplant-clinic/\">Liver Transplant Clinic</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/organ-transplantation-center/\">Organ Transplantation Center</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/parathyroid-transplant-clinic/\">Parathyroid Transplant Clinic</a></li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Women's health and fertility</h3>\n<!-- /wp:heading -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/breast-surgery/\">Breast Surgery</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/hirsutism-clinic/\">Hirsutism Clinic</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/in-vitro-fertilization-ivf/\">In-Vitro Fertilization (IVF)</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/obstetrics-and-gynaecology/\">Obstetrics and Gynaecology</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/pcos-and-hirsutism-clinic/\">PCOS and Hirsutism Clinic</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/pelvic-pain-and-endometriosis-clinic/\">Pelvic Pain and Endometriosis Clinic</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/perinatology/\">Perinatology</a></li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Eye, ear, nose and throat</h3>\n<!-- /wp:heading -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/audiology/\">Audiology</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/ophthalmology/\">Ophthalmology</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/otolaryngology-ent/\">Otolaryngology (ENT)</a></li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Surgery</h3>\n<!-- /wp:heading -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/endocrine-surgery/\">Endocrine Surgery</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/gastroenterological-surgery/\">Gastroenterological Surgery</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/general-surgery/\">General Surgery</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/clinical-treatments/bariatric-surgery/\">Obesity Surgery</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/clinical-treatments/plastic-surgery/\">Plastic, Reconstructive and Aesthetic Surgery</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/thoracic-surgery/\">Thoracic Surgery</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/urology/\">Urology</a></li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Internal medicine</h3>\n<!-- /wp:heading -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/chest-diseases-pulmonology/\">Chest Diseases (Pulmonology)</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/dermatology/\">Dermatology</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/endocrinology-and-metabolic-diseases/\">Endocrinology and Metabolic Diseases</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/gastroenterology/\">Gastroenterology</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/immunology/\">Immunology</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/infectious-diseases-and-clinical-microbiology/\">Infectious Diseases and Clinical Microbiology</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/internal-medicine/\">Internal Medicine</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/nephrology/\">Nephrology</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/nutrition-and-dietetics/\">Nutrition and Dietetics</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/pituitary-clinic/\">Pituitary Clinic</a></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https://medluxlife.de/health/hospital-specialist-treatments/thyroid-and-parathyroid-diseases-and-surgery-clinic/\">Thyroid and Parathyroid Diseases and Surgery Clinic</a></li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Children's health</h3>\n<!-- /wp:heading -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-