{"id": 529, "slug": "paediatric-nephrology", "content": {"raw": "<!-- wp:columns {\"verticalAlignment\":\"center\",\"className\":\"medlux-intro\"} -->\n<div class=\"wp-block-columns are-vertically-aligned-center medlux-intro\"><!-- wp:column {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\"><!-- wp:paragraph {\"className\":\"medlux-lead\"} -->\n<p class=\"medlux-lead\">Paediatric nephrology deals with diseases of the kidneys, urinary tract, bladder and urethra in children from birth to 18 years. Signs such as swelling of the hands, feet or eyes, blood in the urine or pain when passing urine should be assessed without delay. MedLuxLife arranges specialist consultations at our partner hospital, where care is multidisciplinary and families are supported at every stage.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\"><!-- wp:image {\"id\":1533,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-intro-img\"} -->\n<figure class=\"wp-block-image size-large medlux-intro-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/paediatric-nephrology-intro.jpg\" alt=\"Paediatrician listening to a smiling boy with a stethoscope while his mother watches\" class=\"wp-image-1533\"/></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Treatments and services</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-treatment-grid\",\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"20rem\"}} -->\n<div class=\"wp-block-group medlux-treatment-grid\"><!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Kidney failure</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Diagnosis and management of acute and chronic kidney failure in children.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Dialysis in children</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Dialysis care for children who need kidney replacement therapy.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Kidney transplantation</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Care for children before and after kidney transplantation.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Urinary tract infections and reflux</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Evaluation and treatment of urinary tract infections and vesicoureteral reflux.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Congenital anomalies</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Follow-up of antenatal hydronephrosis and abnormalities of the urinary system.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Bedwetting and kidney stones</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Assessment and treatment of enuresis and kidney stone disease in children.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section medlux-columns\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section medlux-columns\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Conditions treated</h2>\n<!-- /wp:heading -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>Acute kidney failure</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Antenatal hydronephrosis</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Other kidney diseases in children</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Kidney transplantation</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Dialysis</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Enuresis (urinary incontinence)</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Urinary tract infection</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Chronic kidney failure</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Kidney stone disease</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Urinary system abnormalities</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Vesicoureteral reflux</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Before you travel</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>To get a reliable medical opinion quickly, please prepare:</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>Recent medical reports and discharge summaries</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Imaging (MRI, CT, X-ray) on CD or as DICOM files, with the radiology reports</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Recent laboratory results</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>A list of your current medications and any allergies</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Recent urine and kidney function test results</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Previous kidney ultrasound reports</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">How MedLuxLife supports you</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-steps\",\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"20rem\"}} -->\n<div class=\"wp-block-group medlux-steps\"><!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">1. Free consultation</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Share your wishes and, if available, recent X-rays or photos. We answer your questions and explain the options.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">2. Personal treatment plan</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Our partner specialists prepare a treatment plan and an estimated timeline tailored to you.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">3. Travel &amp; treatment</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>We coordinate your appointments, hotel and airport transfers, so you can focus on your treatment.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">4. Aftercare</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>We stay in touch after you return home and help with follow-up questions.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-cta\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-cta\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Plan your Paediatric Nephrology consultation with confidence</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Every treatment begins with a personal, no-obligation consultation. Contact us and we will get back to you as soon as possible.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"medlux-btn-primary\"} -->\n<div class=\"wp-block-button medlux-btn-primary\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://medluxlife.de/contact/\">Request a Free Consultation</a></div>\n<!-- /wp:button --><!-- wp:button {\"className\":\"medlux-btn-whatsapp\"} -->\n<div class=\"wp-block-button medlux-btn-whatsapp\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://wa.me/380979092326\" target=\"_blank\" rel=\"noreferrer noopener\">WhatsApp</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->\n\n<!-- wp:paragraph {\"className\":\"medlux-disclaimer\"} -->\n<p class=\"medlux-disclaimer\">The information on this page is for general guidance only and does not replace a medical consultation. Suitability for any treatment is assessed individually by a qualified doctor.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->"}}