{"id": 269, "modified": "2026-10-08T15:30:23", "content": {"raw": "<!-- wp:columns {\"verticalAlignment\":\"center\",\"className\":\"medlux-intro\"} -->\n<div class=\"wp-block-columns are-vertically-aligned-center medlux-intro\"><!-- wp:column {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\"><!-- wp:paragraph {\"className\":\"medlux-lead\"} -->\n<p class=\"medlux-lead\">Cardiology covers the evaluation, diagnosis, treatment and follow-up of heart conditions. Our partner hospital's cardiology department includes a cardiology outpatient clinic, a coronary intensive care unit, cardiac catheterisation and angiography laboratories, an electrophysiology unit and cardiology laboratories, and works closely with cardiovascular surgery.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\"><!-- wp:image {\"id\":895,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-intro-img\"} -->\n<figure class=\"wp-block-image size-large medlux-intro-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/medluxlife-photo-407.jpg\" alt=\"Cardiologist measuring a patient&#x27;s blood pressure\" class=\"wp-image-895\"/></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Treatments and services</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-treatment-grid\",\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"20rem\"}} -->\n<div class=\"wp-block-group medlux-treatment-grid\"><!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Echocardiography</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Transthoracic and transoesophageal echocardiography to assess the structure and function of the heart.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Stress and rhythm tests</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Treadmill stress test, rhythm Holter, event recorder and tilt-table test.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Blood pressure monitoring</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>24-hour ambulatory blood pressure monitoring.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Coronary angiography and catheterisation</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Coronary angiography, haemodynamic studies and right and left heart catheterisation.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Coronary angioplasty and stents</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Percutaneous transluminal coronary angioplasty (PTCA) and intracoronary stent placement.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Pacemakers and ICDs</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Implantation of permanent pacemakers and implantable cardioverter-defibrillators (ICD).</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Electrophysiology and RF ablation</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Electrophysiological studies and radiofrequency ablation to treat heart rhythm disorders.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Balloon valvuloplasty</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Mitral and pulmonary balloon valvuloplasty to widen narrowed heart valves.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Catheter closure of heart defects</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Percutaneous closure of atrial septal defects (ASD) and patent ductus arteriosus (PDA).</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Other interventional procedures</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Septal ablation, pericardiocentesis and endomyocardial biopsy.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Before you travel</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>To get a reliable medical opinion quickly, please prepare:</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>Recent medical reports and discharge summaries</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Imaging (MRI, CT, X-ray) on CD or as DICOM files, with the radiology reports</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Recent laboratory results</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>A list of your current medications and any allergies</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Previous ECGs, echocardiography or angiography reports</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">How MedLuxLife supports you</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-steps\",\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"20rem\"}} -->\n<div class=\"wp-block-group medlux-steps\"><!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">1. Free consultation</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Share your wishes and, if available, recent X-rays or photos. We answer your questions and explain the options.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">2. Personal treatment plan</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Our partner specialists prepare a treatment plan and an estimated timeline tailored to you.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">3. Travel &amp; treatment</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>We coordinate your appointments, hotel and airport transfers, so you can focus on your treatment.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">4. Aftercare</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>We stay in touch after you return home and help with follow-up questions.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-cta\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-cta\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Plan your cardiology consultation with confidence</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Every treatment begins with a personal, no-obligation consultation. Contact us and we will get back to you as soon as possible.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"medlux-btn-primary\"} -->\n<div class=\"wp-block-button medlux-btn-primary\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://medluxlife.de/contact/\">Request a Free Consultation</a></div>\n<!-- /wp:button --><!-- wp:button {\"className\":\"medlux-btn-whatsapp\"} -->\n<div class=\"wp-block-button medlux-btn-whatsapp\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://wa.me/380979092326\" target=\"_blank\" rel=\"noreferrer noopener\">WhatsApp</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->\n\n<!-- wp:paragraph {\"className\":\"medlux-disclaimer\"} -->\n<p class=\"medlux-disclaimer\">The information on this page is for general guidance only and does not replace a medical consultation. Suitability for any treatment is assessed individually by a qualified doctor.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->"}}