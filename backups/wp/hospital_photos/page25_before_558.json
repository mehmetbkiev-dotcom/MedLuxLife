{"id": 25, "modified": "2026-10-07T18:20:47", "content": {"raw": "<!-- wp:paragraph {\"className\":\"medlux-lead\"} -->\n<p class=\"medlux-lead\">Whether you are planning a holiday, a city break, a business trip or a pilgrimage, MedLuxLife takes care of the details: holiday packages, hotels, flight tickets, airport transfers and Hajj and Umrah journeys, all planned around you.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\":\"medlux-section medlux-rows\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section medlux-rows\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Our travel services</h2>\n<!-- /wp:heading -->\n\n<!-- wp:columns {\"className\":\"medlux-row\"} -->\n<div class=\"wp-block-columns medlux-row\"><!-- wp:column {\"className\":\"medlux-row-media\"} -->\n<div class=\"wp-block-column medlux-row-media\"><!-- wp:image {\"id\":557,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-row-img\"} -->\n<figure class=\"wp-block-image size-large medlux-row-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/medluxlife-travel-holiday-packages.jpg\" alt=\"Infinity pool and beach cabanas overlooking the sea\" class=\"wp-image-557\"/></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"verticalAlignment\":\"center\",\"className\":\"medlux-row-text\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center medlux-row-text\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Holiday Packages</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Tailor-made holidays at the coast, in historic cities or in quiet resorts, planned around your wishes and travel dates.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>Tailor-made itineraries</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Seaside, city and wellness holidays</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Packages for couples, families and groups</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"medlux-btn-primary\"} -->\n<div class=\"wp-block-button medlux-btn-primary\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://medluxlife.de/travel/holiday-packages/\">Discover Holiday Packages</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:columns {\"className\":\"medlux-row medlux-row\\u002d\\u002dreverse\"} -->\n<div class=\"wp-block-columns medlux-row medlux-row--reverse\"><!-- wp:column {\"className\":\"medlux-row-media\"} -->\n<div class=\"wp-block-column medlux-row-media\"><!-- wp:image {\"id\":558,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-row-img\"} -->\n<figure class=\"wp-block-image size-large medlux-row-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/medluxlife-travel-hotel-reservation-577x1024.jpg\" alt=\"Guest enjoying the view from a hotel room\" class=\"wp-image-558\"/></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"verticalAlignment\":\"center\",\"className\":\"medlux-row-text\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center medlux-row-text\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Hotel Reservation</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Carefully selected hotels in the city or region of your choice, from comfortable city hotels to five-star resorts.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>City hotels, resorts and boutique hotels</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Rooms and suites for families and groups</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Special requests passed on to the hotel</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"medlux-btn-primary\"} -->\n<div class=\"wp-block-button medlux-btn-primary\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://medluxlife.de/travel/hotel-reservation/\">Discover Hotel Reservation</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:columns {\"className\":\"medlux-row\"} -->\n<div class=\"wp-block-columns medlux-row\"><!-- wp:column {\"className\":\"medlux-row-media\"} -->\n<div class=\"wp-block-column medlux-row-media\"><!-- wp:image {\"id\":559,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-row-img\"} -->\n<figure class=\"wp-block-image size-large medlux-row-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/medluxlife-travel-flight-tickets.jpg\" alt=\"Passenger aircraft flying over the sea\" class=\"wp-image-559\"/></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"verticalAlignment\":\"center\",\"className\":\"medlux-row-text\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center medlux-row-text\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Flight Tickets</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Domestic and international flight tickets for holidays, business trips and family visits, with personal advice and support.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>Domestic and international flights</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>One-way, return and multi-city tickets</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Group bookings, changes and rebooking</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"medlux-btn-primary\"} -->\n<div class=\"wp-block-button medlux-btn-primary\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://medluxlife.de/travel/flight-tickets/\">Discover Flight Tickets</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:columns {\"className\":\"medlux-row medlux-row\\u002d\\u002dreverse\"} -->\n<div class=\"wp-block-columns medlux-row medlux-row--reverse\"><!-- wp:column {\"className\":\"medlux-row-media\"} -->\n<div class=\"wp-block-column medlux-row-media\"><!-- wp:image {\"id\":560,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-row-img\"} -->\n<figure class=\"wp-block-image size-large medlux-row-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/medluxlife-travel-airport-transfer-1024x892.jpg\" alt=\"Chauffeur handing over car keys\" class=\"wp-image-560\"/></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"verticalAlignment\":\"center\",\"className\":\"medlux-row-text\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center medlux-row-text\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Airport Transfer</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>A private driver meets you at the airport and takes you to your hotel, and we arrange transfers for excursions and back to the airport.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>Private meet-and-greet at arrival</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Hotel, city and excursion transfers</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Comfortable vehicles for every group size</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"medlux-btn-primary\"} -->\n<div class=\"wp-block-button medlux-btn-primary\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://medluxlife.de/travel/airport-transfer/\">Discover Airport Transfer</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:columns {\"className\":\"medlux-row\"} -->\n<div class=\"wp-block-columns medlux-row\"><!-- wp:column {\"className\":\"medlux-row-media\"} -->\n<div class=\"wp-block-column medlux-row-media\"><!-- wp:image {\"id\":561,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-row-img\"} -->\n<figure class=\"wp-block-image size-large medlux-row-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/medluxlife-travel-hajj-umrah.jpg\" alt=\"Pilgrims at the Kaaba in Mecca\" class=\"wp-image-561\"/></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"verticalAlignment\":\"center\",\"className\":\"medlux-row-text\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center medlux-row-text\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Hajj &amp; Umrah</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Calm, well-organised Umrah and Hajj journeys with licensed partners, including visa guidance, flights, hotels near the holy sites and transfers.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>Umrah journeys throughout the year</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Hajj with licensed partners, subject to quotas</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Hotels near the holy mosques</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"medlux-btn-primary\"} -->\n<div class=\"wp-block-button medlux-btn-primary\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://medluxlife.de/travel/hajj-umrah/\">Discover Hajj &amp; Umrah</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">How it works</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-steps\",\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"20rem\"}} -->\n<div class=\"wp-block-group medlux-steps\"><!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">1. Tell us your plans</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Share your dates, destination and wishes, and who will travel with you.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">2. Personal offer</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>We prepare a tailored proposal for flights, hotel and transfers, without obligation.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">3. Booking and documents</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Once you agree, we make the bookings and send you all travel documents.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">4. Support during your trip</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>We are available for you before and during your journey.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-cta\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-cta\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Plan your journey with us</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Tell us what you have in mind and we will prepare a personal, no-obligation offer for you.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"medlux-btn-primary\"} -->\n<div class=\"wp-block-button medlux-btn-primary\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://medluxlife.de/contact/\">Request an Offer</a></div>\n<!-- /wp:button --><!-- wp:button {\"className\":\"medlux-btn-whatsapp\"} -->\n<div class=\"wp-block-button medlux-btn-whatsapp\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://wa.me/380979092326\" target=\"_blank\" rel=\"noreferrer noopener\">WhatsApp</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:group -->"}}