e\" class=\"wp-block-spacer\"><\/div>\n<!-- \/wp:spacer --><\/div><\/div>\n<!-- \/wp:cover --><\/div>\n<!-- \/wp:column --><\/div>\n<!-- \/wp:columns --><\/section>\n<!-- \/wp:group --><!-- wp:group {\"metadata\":{\"name\":\"Section\"},\"align\":\"full\",\"className\":\"is-style-ext-preset\\u002d\\u002dgroup\\u002d\\u002dnatural-1\\u002d\\u002dsection ext-section\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|70\",\"bottom\":\"var:preset|spacing|70\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"},\"blockGap\":\"var:preset|spacing|55\"}},\"backgroundColor\":\"background\",\"layout\":{\"inherit\":true,\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull is-style-ext-preset--group--natural-1--section ext-section has-background-background-color has-background\" id=\"faq\" style=\"margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)\"><!-- wp:group {\"metadata\":{\"name\":\"Section Intro\"},\"align\":\"wide\",\"className\":\"ext-section-intro is-style-ext-preset\\u002d\\u002dgroup\\u002d\\u002dnatural-1\\u002d\\u002dsection-intro-1\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignwide ext-section-intro is-style-ext-preset--group--natural-1--section-intro-1 has-custom-css\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Frequently Asked Questions about MedLuxLife.<\/h2>\n<!-- \/wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"ext-animate\\u002d\\u002don\",\"style\":{\"spacing\":{\"margin\":{\"top\":\"24px\"}}},\"textColor\":\"foreground-alt\",\"fontSize\":\"medium\"} -->\n<p class=\"ext-animate--on has-foreground-alt-color has-text-color has-medium-font-size\" style=\"margin-top:24px\">Find essential details regarding our medical travel, dental treatments, plastic surgery, and holiday packages.<\/p>\n<!-- \/wp:paragraph --><\/div>\n<!-- \/wp:group -->\n\n<!-- wp:columns {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":{\"top\":\"var:preset|spacing|40\",\"left\":\"var:preset|spacing|40\"}}}} -->\n<div class=\"wp-block-columns alignwide\"><!-- wp:column {\"className\":\"ext-animate\\u002d\\u002don\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|40\"}}} -->\n<div class=\"wp-block-column ext-animate--on\"><!-- wp:accordion {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|30\"}},\"layout\":{\"type\":\"default\"}} -->\n<div role=\"group\" class=\"wp-block-accordion\"><!-- wp:accordion-item {\"openByDefault\":true,\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-accordion-item is-open\"><!-- wp:accordion-heading {\"style\":{\"typography\":{\"fontSize\":\"1.5rem\"}}} -->\n<h3 class=\"wp-block-accordion-heading\" style=\"font-size:1.5rem\"><button type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\">How do I book medical treatments and travel?<\/span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">\u00fe<\/span><\/button><\/h3>\n<!-- \/wp:accordion-heading -->\n\n<!-- wp:accordion-panel -->\n<div role=\"region\" class=\"wp-block-accordion-panel\"><!-- wp:paragraph -->\n<p>Contact our team to discuss your medical care plan and we will coordinate flights, hotels, and hospital appointments.<\/p>\n<!-- \/wp:paragraph --><\/div>\n<!-- \/wp:accordion-panel --><\/div>\n<!-- \/wp:accordion-item -->\n\n<!-- wp:accordion-item {\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-accordion-item\"><!-- wp:accordion-heading {\"style\":{\"typography\":{\"fontSize\":\"1.5rem\"}}} -->\n<h3 class=\"wp-block-accordion-heading\" style=\"font-size:1.5rem\"><button type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\">What languages do your support staff speak?<\/span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">\u00fe<\/span><\/button><\/h3>\n<!-- \/wp:accordion-heading -->\n\n<!-- wp:accordion-panel -->\n<div role=\"region\" class=\"wp-block-accordion-panel\"><!-- wp:paragraph -->\n<p>We support five languages including German, English, Turkish, Ukrainian, and Russian for all international patients.<\/p>\n<!-- \/wp:paragraph --><\/div>\n<!-- \/wp:accordion-panel --><\/div>\n<!-- \/wp:accordion-item -->\n\n<!-- wp:accordion-item {\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-accordion-item\"><!-- wp:accordion-heading {\"style\":{\"typography\":{\"fontSize\":\"1.5rem\"}}} -->\n<h3 class=\"wp-block-accordion-heading\" style=\"font-size:1.5rem\"><button type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\">Do you offer airport transfers and hotels?<\/span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">\u00fe<\/span><\/button><\/h3>\n<!-- \/wp:accordion-heading -->\n\n<!-- wp:accordion-panel -->\n<div role=\"region\" class=\"wp-block-accordion-panel\"><!-- wp:paragraph -->\n<p>Yes, our packages include seamless airport transfers, accommodation services, and complete holiday arrangements.<\/p>\n<!-- \/wp:paragraph --><\/div>\n<!-- \/wp:accordion-panel --><\/div>\n<!-- \/wp:accordion-item --><\/div>\n<!-- \/wp:accordion --><\/div>\n<!-- \/wp:column -->\n\n<!-- wp:column {\"className\":\"ext-animate\\u002d\\u002don\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|40\"}}} -->\n<div class=\"wp-block-column ext-animate--on\"><!-- wp:accordion {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|30\"}},\"layout\":{\"type\":\"default\"}} -->\n<div role=\"group\" class=\"wp-block-accordion\"><!-- wp:accordion-item {\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-accordion-item\"><!-- wp:accordion-heading {\"style\":{\"typography\":{\"fontSize\":\"1.5rem\"}}} -->\n<h3 class=\"wp-block-accordion-heading\" style=\"font-size:1.5rem\"><button type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\">Are Hajj and Umrah packages available?<\/span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">\u00fe<\/span><\/button><\/h3>\n<!-- \/wp:accordion-heading -->\n\n<!-- wp:accordion-panel -->\n<div role=\"region\" class=\"wp-block-accordion-panel\"><!-- wp:paragraph -->\n<p>Yes, we provide specialized pilgrimage packages alongside our comprehensive health tourism and travel services.<\/p>\n<!-- \/wp:paragraph --><\/div>\n<!-- \/wp:accordion-panel --><\/div>\n<!-- \/wp:accordion-item -->\n\n<!-- wp:accordion-item {\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-accordion-item\"><!-- wp:accordion-heading {\"style\":{\"typography\":{\"fontSize\":\"1.5rem\"}}} -->\n<h3 class=\"wp-block-accordion-heading\" style=\"font-size:1.5rem\"><button type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\">What medical services can I access?<\/span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">\u00fe<\/span><\/button><\/h3>\n<!-- \/wp:accordion-heading -->\n\n<!-- wp:accordion-panel -->\n<div role=\"region\" class=\"wp-block-accordion-panel\"><!-- wp:paragraph -->\n<p>We offer dental treatments, hair transplantation, plastic surgery, bariatric surgery, check-ups, and IV treatments.<\/p>\n<!-- \/wp:paragraph --><\/div>\n<!-- \/wp:accordion-panel --><\/div>\n<!-- \/wp:accordion-item -->\n\n<!-- wp:accordion-item {\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-accordion-item\"><!-- wp:accordion-heading {\"style\":{\"typography\":{\"fontSize\":\"1.5rem\"}}} -->\n<h3 class=\"wp-block-accordion-heading\" style=\"font-size:1.5rem\"><button type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\">Where is MedLuxLife based?<\/span><span class=\"wp-block-accordion-heading__toggle-icon\" ar