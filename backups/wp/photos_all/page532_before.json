{"id": 532, "date": "2026-10-05T18:22:40", "date_gmt": "2026-10-05T18:22:40", "guid": {"rendered": "https://medluxlife.de/health/hospital-specialist-treatments/paediatric-allergy-and-immunology/", "raw": "https://medluxlife.de/health/hospital-specialist-treatments/paediatric-allergy-and-immunology/"}, "modified": "2026-10-07T18:20:07", "modified_gmt": "2026-10-07T18:20:07", "password": "", "slug": "paediatric-allergy-and-immunology", "status": "publish", "type": "page", "link": "https://medluxlife.de/health/hospital-specialist-treatments/paediatric-allergy-and-immunology/", "title": {"raw": "Paediatric Allergy and Immunology", "rendered": "Paediatric Allergy and Immunology"}, "content": {"raw": "<!-- wp:columns {\"verticalAlignment\":\"center\",\"className\":\"medlux-intro\"} -->\n<div class=\"wp-block-columns are-vertically-aligned-center medlux-intro\"><!-- wp:column {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\"><!-- wp:paragraph {\"className\":\"medlux-lead\"} -->\n<p class=\"medlux-lead\">This department diagnoses and treats allergic conditions in children and adolescents from birth to 18 years. A range of skin, blood, breathing and provocation tests helps identify triggers so a suitable treatment plan can be made. MedLuxLife organises testing and consultations at our partner hospital and supports families throughout the visit.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\"><!-- wp:image {\"id\":458,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-intro-img\"} -->\n<figure class=\"wp-block-image size-large medlux-intro-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/medluxlife-dept-pediatric-allergy-and-immunology-1024x683.jpg\" alt=\"Pediatric Allergy and Immunology - specialist hospital care\" class=\"wp-image-458\"/></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Treatments and services</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-treatment-grid\",\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"20rem\"}} -->\n<div class=\"wp-block-group medlux-treatment-grid\"><!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Allergy skin tests</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Skin testing to identify substances that may trigger allergic reactions.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Blood allergy tests</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Laboratory tests to measure allergic sensitisation.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Lung function tests</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Respiratory function testing for children with asthma, wheezing or chronic cough.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Provocation testing</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Allergen provocation, food tests and anaesthetic drug tests carried out under medical supervision.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Allergy vaccination</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Allergen immunotherapy may be offered where suitable.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section medlux-columns\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section medlux-columns\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Conditions treated</h2>\n<!-- /wp:heading -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>Asthma</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Allergic bronchitis</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Allergic rhinitis (hay fever)</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Atopic dermatitis (eczema)</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Urticaria (hives)</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Food allergy</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Drug allergy, including allergy to anaesthetic agents</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Chronic cough</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Wheezing in babies</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Frequent respiratory tract infections</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Allergic skin rashes</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Before you travel</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>To get a reliable medical opinion quickly, please prepare:</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>Recent medical reports and discharge summaries</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Imaging (MRI, CT, X-ray) on CD or as DICOM files, with the radiology reports</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Recent laboratory results</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>A list of your current medications and any allergies</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Previous allergy test results</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>A list of the child's current medicines and known reactions</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">How MedLuxLife supports you</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-steps\",\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"20rem\"}} -->\n<div class=\"wp-block-group medlux-steps\"><!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">1. Free consultation</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Share your wishes and, if available, recent X-rays or photos. We answer your questions and explain the options.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">2. Personal treatment plan</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Our partner specialists prepare a treatment plan and an estimated timeline tailored to you.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">3. Travel &amp; treatment</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>We coordinate your appointments, hotel and airport transfers, so you can focus on your treatment.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">4. Aftercare</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>We stay in touch after you return home and help with follow-up questions.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-cta\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-cta\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Plan your Paediatric Allergy and Immunology consultation with confidence</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Every treatment begins with a personal, no-obligation consultation. Contact us and we will get back to you as soon as possible.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"medlux-btn-primary\"} -->\n<div class=\"wp-block-button medlux-btn-primary\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://medluxlife.de/contact/\">Request a Free Consultation</a></div>\n<!-- /wp:button --><!-- wp:button {\"className\":\"medlux-btn-whatsapp\"} -->\n<div class=\"wp-block-button medlux-btn-whatsapp\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://wa.me/380979092326\" target=\"_blank\" rel=\"noreferrer noopener\">WhatsApp</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->\n\n<!-- wp:paragraph {\"className\":\"medlux-disclaimer\"} -->\n<p class=\"medlux-disclaimer\">The information on this page is for general guidance only and does not replace a medical consultation. Suitability for any treatment is assessed individually by a qualified doctor.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->", "rendered": "\n<div class=\"wp-block-columns are-vertically-aligned-center medlux-intro is-layout-flex wp-container-core-columns-is-layout-e35d3e13 wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-vertically-aligned-center is-layout-flow wp-block-column-is-layout-flow\">\n<p class=\"medlux-lead wp-block-paragraph\">This department diagnoses and treats allergic conditions in children and adolescents from birth to 18 years. A range of skin, blood, breathing and provocation tests helps identify triggers so a suitable treatment plan can be made. MedLuxLife organises testing and consultations at our partner hospital and supports families throughout the visit.</p>\n</div>\n\n\n\n<div class=\"wp-block-column is-vertically-aligned-center is-layout-flow wp-block-column-is-layout-flow\">\n<figure class=\"wp-block-image size-large medlux-intro-img\"><img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"683\" src=\"https://medluxlife.de/wp-content/uploads/2026/10/medluxlife-dept-pediatric-allergy-and-immunology-1024x683.jpg\" alt=\"Pediatric Allergy and Immunology - specialist hospital care\" class=\"wp-image-458\" srcset=\"https://medluxlife.de/wp-content/uploads/2026/10/medluxlife-dept-pediatric-allergy-and-immunology-1024x683.jpg 1024w, https://medluxlife.de/wp-content/uploads/2026/10/medluxlife-dept-pediatric-allergy-and-immunology-300x200.jpg 300w, https://medluxlife.de/wp-content/uploads/2026/10/medluxlife-dept-pediatric-allergy-and-immunology-768x512.jpg 768w, https://medluxlife.de/wp-content/uploads/2026/10/medluxlife-dept-pediatric-allergy-and-immunology-18x12.jpg 18w, https://medluxlife.de/wp-content/uploads/2026/10/medluxlife-dept-pediatric-allergy-and-immunology.jpg 1500w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" /></figure>\n</div>\n</div>\n\n\n\n<div class=\"wp-block-group medlux-section has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h2 class=\"wp-block-heading\">Treatments and services</h2>\n\n\n\n<div class=\"wp-block-group medlux-treatment-grid is-layout-grid wp-container-core-group-is-layout-5e4b10ce wp-block-group-is-layout-grid\">\n<div class=\"wp-block-group medlux-card has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h3 class=\"wp-block-heading\">Allergy skin tests</h3>\n\n\n\n<p class=\"wp-block-paragraph\">Skin testing to identify substances that may trigger allergic reactions.</p>\n</div>\n\n\n\n<div class=\"wp-block-group medlux-card has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h3 class=\"wp-block-heading\">Blood allergy tests</h3>\n\n\n\n<p class=\"wp-block-paragraph\">Laboratory tests to measure allergic sensitisation.</p>\n</div>\n\n\n\n<div class=\"wp-block-group medlux-card has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h3 class=\"wp-block-heading\">Lung function tests</h3>\n\n\n\n<p class=\"wp-block-paragraph\">Respiratory function testing for children with asthma, wheezing or chronic cough.</p>\n</div>\n\n\n\n<div class=\"wp-block-group medlux-card has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h3 class=\"wp-block-heading\">Provocation testing</h3>\n\n\n\n<p class=\"wp-block-paragraph\">Allergen provocation, food tests and anaesthetic drug tests carried out under medical supervision.</p>\n</div>\n\n\n\n<div class=\"wp-block-group medlux-card has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h3 class=\"wp-block-heading\">Allergy vaccination</h3>\n\n\n\n<p class=\"wp-block-paragraph\">Allergen immunotherapy may be offered where suitable.</p>\n</div>\n</div>\n</div>\n\n\n\n<div class=\"wp-block-group medlux-section medlux-columns has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h2 class=\"wp-block-heading\">Conditions treated</h2>\n\n\n\n<ul class=\"wp-block-list\">\n<li>Asthma</li>\n\n<li>Allergic bronchitis</li>\n\n<li>Allergic rhinitis (hay fever)</li>\n\n<li>Atopic dermatitis (eczema)</li>\n\n<li>Urticaria (hives)</li>\n\n<li>Food allergy</li>\n\n<li>Drug allergy, including allergy to anaesthetic agents</li>\n\n<li>Chronic cough</li>\n\n<li>Wheezing in babies</li>\n\n<li>Frequent respiratory tract infections</li>\n\n<li>Allergic skin rashes</li>\n</ul>\n</div>\n\n\n\n<div class=\"wp-block-group medlux-section has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h2 class=\"wp-block-heading\">Before you travel</h2>\n\n\n\n<p class=\"wp-block-paragraph\">To get a reliable medical opinion quickly, please prepare:</p>\n\n\n\n<ul class=\"wp-block-list\">\n<li>Recent medical reports and discharge summaries</li>\n\n<li>Imaging (MRI, CT, X-ray) on CD or as DICOM files, with the radiology reports</li>\n\n<li>Recent laboratory results</li>\n\n<li>A list of your current medications and any allergies</li>\n\n<li>Previous allergy test results</li>\n\n<li>A list of the child&#8217;s current medicines and known reactions</li>\n</ul>\n</div>\n\n\n\n<div class=\"wp-block-group medlux-section has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h2 class=\"wp-block-heading\">How MedLuxLife supports you</h2>\n\n\n\n<div class=\"wp-block-group medlux-steps is-layout-grid wp-container-core-group-is-layout-5e4b10ce wp-block-group-is-layout-grid\">\n<div class=\"wp-block-group medlux-card has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h3 class=\"wp-block-heading\">1. Free consultation</h3>\n\n\n\n<p class=\"wp-block-paragraph\">Share your wishes and, if available, recent X-rays or photos. We answer your questions and explain the options.</p>\n</div>\n\n\n\n<div class=\"wp-block-group medlux-card has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h3 class=\"wp-block-heading\">2. Personal treatment plan</h3>\n\n\n\n<p class=\"wp-block-paragraph\">Our partner specialists prepare a treatment plan and an estimated timeline tailored to you.</p>\n</div>\n\n\n\n<div class=\"wp-block-group medlux-card has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h3 class=\"wp-block-heading\">3. Travel &amp; treatment</h3>\n\n\n\n<p class=\"wp-block-paragraph\">We coordinate your appointments, hotel and airport transfers, so you can focus on your treatment.</p>\n</div>\n\n\n\n<div class=\"wp-block-group medlux-card has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h3 class=\"wp-block-heading\">4. Aftercare</h3>\n\n\n\n<p class=\"wp-block-paragraph\">We stay in touch after you return home and help with follow-up questions.</p>\n</div>\n</div>\n</div>\n\n\n\n<div class=\"wp-block-group medlux-cta has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h2 class=\"wp-block-heading\">Plan your Paediatric Allergy and Immunology consultation with confidence</h2>\n\n\n\n<p class=\"wp-block-paragraph\">Every treatment begins with a personal, no-obligation consultation. Contact us and we will get back to you as soon as possible.</p>\n\n\n\n<div class=\"wp-block-buttons is-layout-flex wp-block-buttons-is-layout-flex\">\n<div class=\"wp-block-button medlux-btn-primary\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://medluxlife.de/contact/\">Request a Free Consultation</a></div>\n\n<div class=\"wp-block-button medlux-btn-whatsapp\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://wa.me/380979092326\" target=\"_blank\" rel=\"noreferrer noopener\">WhatsApp</a></div>\n</div>\n\n\n\n<p class=\"medlux-disclaimer wp-block-paragraph\">The information on this page is for general guidance only and does not replace a medical consultation. Suitability for any treatment is assessed individually by a qualified doctor.</p>\n</div>\n", "protected": false, "block_version": 1}, "excerpt": {"raw": "", "rendered": "<p>This department diagnoses and treats allergic conditions in children and adolescents from birth to 18 years. A range of skin, blood, breathing and provocation tests helps identify triggers so a suitable treatment plan can be made. MedLuxLife organises testing and consultations at our partner hospital and supports families throughout the visit. Treatments and services Allergy [&hellip;]</p>\n", "protected": false}, "author": 2, "featured_media": 0, "parent": 259, "menu_order": 59, "comment_status": "closed", "ping_status": "closed", "template": "page-with-title", "meta": {"footnotes": ""}, "permalink_template": "https://medluxlife.de/health/hospital-specialist-treatments/%pagename%/", "generated_slug": "paediatric-allergy-and-immunology", "class_list": ["post-532", "page", "type-page", "status-publish", "hentry"], "_links": {"self": [{"href": "https://medluxlife.de/wp-json/wp/v2/pages/532", "targetHints": {"allow": ["GET", "POST", "PUT", "PATCH", "DELETE"]}}], "collection": [{"href": "https://medluxlife.de/wp-json/wp/v2/pages"}], "about": [{"href": "https://medluxlife.de/wp-json/wp/v2/types/page"}], "author": [{"embeddable": true, "href": "https://medluxlife.de/wp-json/wp/v2/users/2"}], "replies": [{"embeddable": true, "href": "https://medluxlife.de/wp-json/wp/v2/comments?post=532"}], "version-history": [{"count": 1, "href": "https://medluxlife.de/wp-json/wp/v2/pages/532/revisions"}], "predecessor-version": [{"id": 674, "href": "https://medluxlife.de/wp-json/wp/v2/pages/532/revisions/674"}], "up": [{"embeddable": true, "href": "https://medluxlife.de/wp-json/wp/v2/pages/259"}], "