{"id": 266, "date": "2026-10-01T15:41:58", "date_gmt": "2026-10-01T15:41:58", "guid": {"rendered": "https://medluxlife.de/health/clinical-treatments/check-up-packages/", "raw": "https://medluxlife.de/health/clinical-treatments/check-up-packages/"}, "modified": "2026-10-07T18:20:41", "modified_gmt": "2026-10-07T18:20:41", "password": "", "slug": "check-up-packages", "status": "publish", "type": "page", "link": "https://medluxlife.de/health/clinical-treatments/check-up-packages/", "title": {"raw": "Check-Up Packages", "rendered": "Check-Up Packages"}, "content": {"raw": "<!-- wp:columns {\"verticalAlignment\":\"center\",\"className\":\"medlux-intro\"} -->\n<div class=\"wp-block-columns are-vertically-aligned-center medlux-intro\"><!-- wp:column {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\"><!-- wp:paragraph {\"className\":\"medlux-lead\"} -->\n<p class=\"medlux-lead\">Regular check-ups help healthy people stay healthy. Many conditions can be detected before they cause any symptoms, when treatment is often simpler and more effective. Our check-up packages are tailored to your age and the health needs of your stage of life and are carried out at partner hospitals.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\"><!-- wp:image {\"id\":333,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-intro-img\"} -->\n<figure class=\"wp-block-image size-large medlux-intro-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/medluxlife-check-up-1024x746.jpg\" alt=\"Doctor measuring a patient&#x27;s blood pressure\" class=\"wp-image-333\"/></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Check-up packages</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-treatment-grid\",\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"20rem\"}} -->\n<div class=\"wp-block-group medlux-treatment-grid\"><!-- wp:group {\"className\":\"medlux-card medlux-card\\u002d\\u002dphoto\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card medlux-card--photo\"><!-- wp:image {\"id\":334,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-card-img\"} -->\n<figure class=\"wp-block-image size-large medlux-card-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/medluxlife-check-up-men-1024x968.jpg\" alt=\"Doctors walking in a hospital corridor\" class=\"wp-image-334\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Check-ups for Men</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Packages tailored to each stage of life:</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>Under 40</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Over 40</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Over 50</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Over 65</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card medlux-card\\u002d\\u002dphoto\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card medlux-card--photo\"><!-- wp:image {\"id\":335,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-card-img\"} -->\n<figure class=\"wp-block-image size-large medlux-card-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/medluxlife-check-up-women-1020x1024.jpg\" alt=\"Medical team in a modern hospital\" class=\"wp-image-335\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Check-ups for Women</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Packages tailored to each stage of life:</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>Under 40</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Over 40</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Over 50</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Over 65</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:paragraph -->\n<p>The exact content of each package (laboratory tests, imaging and specialist consultations) is shared with you during your consultation, so you can choose the package that suits you best.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">How MedLuxLife supports you</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-steps\",\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"20rem\"}} -->\n<div class=\"wp-block-group medlux-steps\"><!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">1. Free consultation</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Share your wishes and, if available, recent X-rays or photos. We answer your questions and explain the options.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 clas