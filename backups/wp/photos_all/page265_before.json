 "collection": [{"href": "https://medluxlife.de/wp-json/wp/v2/pages"}], "about": [{"href": "https://medluxlife.de/wp-json/wp/v2/types/page"}], "author": [{"embeddable": true, "href": "https://medluxlife.de/wp-json/wp/v2/users/2"}], "replies": [{"embeddable": true, "href": "https://medluxlife.de/wp-json/wp/v2/comments?post=265"}], "version-history": [{"count": 2, "href": "https://medluxlife.de/wp-json/wp/v2/pages/265/revisions"}], "predecessor-version": [{"id": 353, "href": "https://medluxlife.de/wp-json/wp/v2/pages/265/revisions/353"}], "up": [{"embeddable": true, "href": "https://medluxlife.de/wp-json/wp/v2/pages/258"}], "wp:attachment": [{"href": "https://medluxlife.de/wp-json/wp/v2/media?parent=265"}], "wp:action-publish": [{"href": "https://medluxlife.de/wp-json/wp/v2/pages/265"}], "wp:action-unfiltered-html": [{"href": "https://medluxlife.de/wp-json/wp/v2/pages/265"}], "wp:action-assign-author": [{"href": "https://medluxlife.de/wp-json/wp/v2/pages/265"}], "curies": [{"name": "wp", "href": "https://api.w.org/{rel}", "templated": true}]}}