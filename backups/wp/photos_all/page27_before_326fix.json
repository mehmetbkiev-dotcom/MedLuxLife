{"id":27,"date":"2026-09-23T13:29:48","date_gmt":"2026-09-23T13:29:48","guid":{"rendered":"https:\/\/medluxlife.de\/services\/","raw":"https:\/\/medluxlife.de\/services\/"},"modified":"2026-10-08T15:30:12","modified_gmt":"2026-10-08T15:30:12","password":"","slug":"health","status":"publish","type":"page","link":"https:\/\/medluxlife.de\/health\/","title":{"raw":"Health","rendered":"Health"},"content":{"raw":"<!-- wp:columns {\"verticalAlignment\":\"center\",\"className\":\"medlux-intro\"} -->\n<div class=\"wp-block-columns are-vertically-aligned-center medlux-intro\"><!-- wp:column {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\"><!-- wp:paragraph {\"className\":\"medlux-lead\"} -->\n<p class=\"medlux-lead\">MedLuxLife connects you with professional healthcare and carefully plans every step of your journey. Whether you are looking for an aesthetic or dental treatment or for specialist hospital care, we help you find the right specialists, prepare your treatment and organise your stay.<\/p>\n<!-- \/wp:paragraph --><\/div>\n<!-- \/wp:column -->\n\n<!-- wp:column {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\"><!-- wp:image {\"id\":741,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-intro-img\"} -->\n<figure class=\"wp-block-image size-large medlux-intro-img\"><img src=\"https:\/\/medluxlife.de\/wp-content\/uploads\/2026\/10\/medluxlife-dental-consultation-1024x768.jpg\" alt=\"Smiling patient during a dental check-up\" class=\"wp-image-741\"\/><\/figure>\n<!-- \/wp:image --><\/div>\n<!-- \/wp:column --><\/div>\n<!-- \/wp:columns -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Our health services<\/h2>\n<!-- \/wp:heading -->\n\n<!-- wp:columns {\"className\":\"medlux-hub\"} -->\n<div class=\"wp-bl