:list-item --><\/ul>\n<!-- \/wp:list -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"medlux-btn-primary\"} -->\n<div class=\"wp-block-button medlux-btn-primary\"><a class=\"wp-block-button__link wp-element-button\" href=\"https:\/\/medluxlife.de\/health\/clinical-treatments\/\">View all clinical treatments<\/a><\/div>\n<!-- \/wp:button --><\/div>\n<!-- \/wp:buttons --><\/div>\n<!-- \/wp:column -->\n\n<!-- wp:column {\"className\":\"medlux-hub-box\"} -->\n<div class=\"wp-block-column medlux-hub-box\"><!-- wp:image {\"id\":884,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-hub-img\"} -->\n<figure class=\"wp-block-image size-large medlux-hub-img\"><img src=\"https:\/\/medluxlife.de\/wp-content\/uploads\/2026\/10\/medluxlife-photo-335.jpg\" alt=\"Medical team in a modern hospital\" class=\"wp-image-884\"\/><\/figure>\n<!-- \/wp:image -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Hospital &amp; Specialist Treatments<\/h2>\n<!-- \/wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Specialist hospital care across more than 70 departments, from oncology and cardiology to transplantation and fertility treatment.<\/p>\n<!-- \/wp:paragraph -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li><a href=\"https:\/\/medluxlife.de\/health\/hospital-specialist-treatments\/medical-oncology\/\">Medical Oncology<\/a><\/li>\n<!-- \/wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https:\/\/medluxlife.de\/health\/hospital-specialist-treatments\/cardiology\/\">Cardiology<\/a><\/li>\n<!-- \/wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https:\/\/medluxlife.de\/health\/hospital-specialist-treatments\/orthopedics-and-traumatology\/\">Orthopedics and Traumatology<\/a><\/li>\n<!-- \/wp:list-item --><!-- wp:list-item -->\n<li><a href=\"https:\/\/medluxlife.de\/health\/hospital-specialist-treatments\/in-vitro-fertilization-ivf\/\">In-Vitro Fertilization (IVF)<\/a><\/li>\n<!-- \/wp:l