{"id": 520, "date": "2026-10-05T18:22:34", "date_gmt": "2026-10-05T18:22:34", "guid": {"rendered": "https://medluxlife.de/health/hospital-specialist-treatments/dermatology/", "raw": "https://medluxlife.de/health/hospital-specialist-treatments/dermatology/"}, "modified": "2026-10-07T18:20:13", "modified_gmt": "2026-10-07T18:20:13", "password": "", "slug": "dermatology", "status": "publish", "type": "page", "link": "https://medluxlife.de/health/hospital-specialist-treatments/dermatology/", "title": {"raw": "Dermatology", "rendered": "Dermatology"}, "content": {"raw": "<!-- wp:columns {\"verticalAlignment\":\"center\",\"className\":\"medlux-intro\"} -->\n<div class=\"wp-block-columns are-vertically-aligned-center medlux-intro\"><!-- wp:column {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\"><!-- wp:paragraph {\"className\":\"medlux-lead\"} -->\n<p class=\"medlux-lead\">Dermatology covers the diagnosis, treatment and follow-up of conditions affecting the skin, hair and nails. Alongside medical dermatology, the department at our partner hospital offers dermatosurgery, cosmetic dermatology and care for certain genital skin conditions. MedLuxLife arranges consultations and helps combine dermatology appointments with any other treatment you are planning during your stay.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\"><!-- wp:image {\"id\":430,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-intro-img\"} -->\n<figure class=\"wp-block-image size-large medlux-intro-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/medluxlife-dept-dermatology.jpg\" alt=\"Dermatology - specialist hospital care\" class=\"wp-image-430\"/></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Treatments and services</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-treatment-grid\",\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"20rem\"}} -->\n<div class=\"wp-block-group medlux-treatment-grid\"><!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Medical dermatology</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Diagnosis, treatment and follow-up of a wide range of skin, hair and nail diseases.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Dermatosurgery</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Surgical procedures on the skin, for example for moles or skin lesions that need removal or examination.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Cosmetic dermatology</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Dermatocosmetic procedures including laser applications, botulinum toxin (Botox) and chemical peels.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Genital skin conditions</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Diagnosis and treatment of genital warts, molluscum, genital herpes, external genital fungal infections and syphilis.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Skin cancer and mole assessment</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Examination of moles and suspicious lesions, and treatment planning for skin cancers.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section medlux-columns\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section medlux-columns\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Conditions treated</h2>\n<!-- /wp:heading -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>Acne</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Psoriasis</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Eczema</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Skin allergies</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Nappy rash in babies</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Hives (urticaria)</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Warts</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Fungal diseases</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Moles</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Skin cancers</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Oral ulcers</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Hair loss</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Nail diseases</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Beh\u00e7et's disease</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Genital warts and molluscum</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Genital herpes</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>External genital fungal infections</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Syphilis</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Before you travel</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>To get a reliable medical opinion quickly, please prepare:</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>Recent medical reports and discharge summaries</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Imaging (MRI, CT, X-ray) on CD or as DICOM files, with the radiology reports</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Recent laboratory results</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>A list of your current medications and any allergies</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Photographs showing how the skin condition has changed over time</li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li>Previous skin biopsy or pathology reports</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">How MedLuxLife supports you</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-steps\",\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"20rem\"}} -->\n<div class=\"wp-block-group medlux-steps\"><!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">1. Free consultation</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Share your wishes and, if available, recent X-rays or photos. We answer your questions and explain the options.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">2. Personal treatment plan</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Our partner specialists prepare a treatment plan and an estimated timeline tailored to you.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">3. Travel &amp; treatment</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>We coordinate your appointments, hotel and airport transfers, so you can focus on your treatment.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">4. Aftercare</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>We stay in touch after you return home and help with follow-up questions.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-cta\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-cta\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Plan your Dermatology consultation with confidence</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Every treatment begins with a personal, no-obligation consultation. Contact us and we will get back to you as soon as possible.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"medlux-btn-primary\"} -->