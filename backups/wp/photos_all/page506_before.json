block-group-is-layout-constrained\">\n<h3 class=\"wp-block-heading\">3. Travel &amp; treatment</h3>\n\n\n\n<p class=\"wp-block-paragraph\">We coordinate your appointments, hotel and airport transfers, so you can focus on your treatment.</p>\n</div>\n\n\n\n<div class=\"wp-block-group medlux-card has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h3 class=\"wp-block-heading\">4. Aftercare</h3>\n\n\n\n<p class=\"wp-block-paragraph\">We stay in touch after you return home and help with follow-up questions.</p>\n</div>\n</div>\n</div>\n\n\n\n<div class=\"wp-block-group medlux-cta has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h2 class=\"wp-block-heading\">Plan your General Surgery consultation with confidence</h2>\n\n\n\n<p class=\"wp-block-paragraph\">Every treatment begins with a personal, no-obligation consultation. Contact us and we will get back to you as soon as possible.</p>\n\n\n\n<div class=\"wp-block-buttons is-layout-flex wp-block-buttons-is-layout-flex\">\n<div class=\"wp-block-button medlux-btn-primary\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://medluxlife.de/contact/\">Request a Free Consultation</a></div>\n\n<div class=\"wp-block-button medlux-btn-whatsapp\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://wa.me/380979092326\" target=\"_blank\" rel=\"noreferrer noopener\">WhatsApp</a></div>\n</div>\n\n\n\n<p class=\"medlux-disclaimer wp-block-paragraph\">The information on this page is for general guidance only and does not replace a medical consultation. Suitability for any treatment is assessed individually by a qualified doctor.</p>\n</div>\n", "protected": false, "block_version": 1}, "excerpt": {"raw": "", "rendered": "<p>General surgery covers the evaluation and operative treatment of a broad range of conditions affecting the digestive tract, abdominal organs, breast, endocrine glands and soft tissues. The general surgery team at our partner hospital uses modern techniques, including laparoscopic (keyhole) surgery where suitable. MedLuxLife coordinates a surgical review of your records before travel and supports [&hellip;]</p>\n", "protected": false}, "author": 2, "featured_media": 0, "parent": 259, "menu_order": 33, "comment_status": "closed", "ping_status": "closed", "template": "page-with-title", "meta": {"footnotes": ""}, "permalink_template": "https://medluxlife.de/health/hospital-specialist-treatments/%pagename%/", "generated_slug": "general-surgery", "class_list": ["post-506", "page", "type-page", "status-publish", "hentry"], "_links": {"self": [{"href": "https://medluxlife.de/wp-json/wp/v2/pages/506", "targetHints": {"allow": ["GET", "POST", "PUT", "PATCH", "DELETE"]}}], "collection": [{"href": "https://medluxlife.de/wp-json/wp/v2/pages"}], "about": [{"href": "https://medluxlife.de/wp-json/wp/v2/types/page"}], "author": [{"embeddable": true, "href": "https://medluxlife.de/wp-json/wp/v2/users/2"}], "replies": [{"embeddable": true, "href": "https://medluxlife.de/wp-json/wp/v2/comments?post=506"}], "version-history": [{"count": 1, "href": "https://medluxlife.de/wp-json/wp/v2/pages/506/revisions"}], "predecessor-version": [{"id": 699, "href": "https://medluxlife.de/wp-json/wp/v2/pages/506/revisions/699"}], "up": [{"embeddable": true, "href": "https://medluxlife.de/wp-json/wp/v2/pages/259"}], "wp:attachment": [{"href": "https://medluxlife.de/wp-json/wp/v2/media?parent=506"}], "wp:action-publish": [{"href": "https://medluxlife.de/wp-json/wp/v2/pages/506"}], "wp:action-unfiltered-html": [{"href": "https://medluxlife.de/wp-json/wp/v2/pages/506"}], "wp:action-assign-author": [{"href": "https://medluxlife.de/wp-json/wp/v2/pages/506"}], "curies": [{"name": "wp", "href": "https://api.w.org/{rel}", "templated": true}]}}