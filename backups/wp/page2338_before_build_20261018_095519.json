{"id": 2338, "date": "2026-10-18T09:51:02", "date_gmt": "2026-10-18T09:51:02", "guid": {"rendered": "https://medluxlife.de/health/clinical-treatments/plastic-surgery/otoplasty/", "raw": "https://medluxlife.de/health/clinical-treatments/plastic-surgery/otoplasty/"}, "modified": "2026-10-18T09:51:02", "modified_gmt": "2026-10-18T09:51:02", "password": "", "slug": "otoplasty", "status": "publish", "type": "page", "link": "https://medluxlife.de/health/clinical-treatments/plastic-surgery/otoplasty/", "title": {"raw": "Otoplasty (Ear Correction)", "rendered": "Otoplasty (Ear Correction)"}, "content": {"raw": "<!-- wp:columns {\"verticalAlignment\":\"center\",\"className\":\"medlux-intro\"} -->\n<div class=\"wp-block-columns are-vertically-aligned-center medlux-intro\"><!-- wp:column {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\"><!-- wp:paragraph {\"className\":\"medlux-lead\"} -->\n<p class=\"medlux-lead\">Otoplasty reshapes or repositions prominent or asymmetric ears. It is possible for adults and for children from about five years of age. MedLuxLife arranges your online consultation with the surgeon in Istanbul and organises your stay.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"verticalAlignment\":\"center\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\"><!-- wp:image {\"id\":1423,\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"medlux-intro-img\"} -->\n<figure class=\"wp-block-image size-large medlux-intro-img\"><img src=\"https://medluxlife.de/wp-content/uploads/2026/10/gemini-generated-image-qxu2efqxu2efqxu2-opt.jpg\" alt=\"Ear marked for otoplasty\" class=\"wp-image-1423\"/></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:group {\"className\":\"medlux-section medlux-facts-sec\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section medlux-facts-sec\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Quick facts</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-facts\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group medlux-facts\"><!-- wp:group {\"className\":\"medlux-fact\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-fact\"><!-- wp:image {\"className\":\"medlux-card-icon\"} -->\n<figure class=\"wp-block-image medlux-card-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:paragraph {\"className\":\"medlux-fact-label\"} -->\n<p class=\"medlux-fact-label\">Anaesthesia</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-fact-value\"} -->\n<p class=\"medlux-fact-value\">Local (adults), general (children)</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-fact\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-fact\"><!-- wp:image {\"className\":\"medlux-card-icon\"} -->\n<figure class=\"wp-block-image medlux-card-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:paragraph {\"className\":\"medlux-fact-label\"} -->\n<p class=\"medlux-fact-label\">Operation time</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-fact-value\"} -->\n<p class=\"medlux-fact-value\">About 1\u20131.5 hours</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-fact\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-fact\"><!-- wp:image {\"className\":\"medlux-card-icon\"} -->\n<figure class=\"wp-block-image medlux-card-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:paragraph {\"className\":\"medlux-fact-label\"} -->\n<p class=\"medlux-fact-label\">Daily activities</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-fact-value\"} -->\n<p class=\"medlux-fact-value\">After about 3\u20135 days</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-fact\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-fact\"><!-- wp:image {\"className\":\"medlux-card-icon\"} -->\n<figure class=\"wp-block-image medlux-card-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:paragraph {\"className\":\"medlux-fact-label\"} -->\n<p class=\"medlux-fact-label\">Headband</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-fact-value\"} -->\n<p class=\"medlux-fact-value\">For about 1\u20132 weeks</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-fact\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-fact\"><!-- wp:image {\"className\":\"medlux-card-icon\"} -->\n<figure class=\"wp-block-image medlux-card-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:paragraph {\"className\":\"medlux-fact-label\"} -->\n<p class=\"medlux-fact-label\">Stay in T\u00fcrkiye</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-fact-value\"} -->\n<p class=\"medlux-fact-value\">Planned individually with the clinic</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:paragraph {\"className\":\"medlux-facts-note\"} -->\n<p class=\"medlux-facts-note\">General information; your surgeon plans the details for you personally.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section medlux-suitable\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section medlux-suitable\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Who it may be suitable for</h2>\n<!-- /wp:heading -->\n\n<!-- wp:list {\"className\":\"medlux-checklist\"} -->\n<ul class=\"wp-block-list medlux-checklist\"><!-- wp:list-item -->\n<li>Your ears \u2013 or your child's ears \u2013 stick out or are asymmetric.</li>\n<!-- /wp:list-item -->\n<!-- wp:list-item -->\n<li>Adults and children from about five years of age.</li>\n<!-- /wp:list-item -->\n<!-- wp:list-item -->\n<li>Good general health.</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:paragraph {\"className\":\"medlux-suitable-note\"} -->\n<p class=\"medlux-suitable-note\">Whether the procedure is suitable for you is decided by the surgeon after a personal assessment.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">How the operation is performed</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-treatment-grid medlux-centered-cards medlux-stages\",\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"14rem\"}} -->\n<div class=\"wp-block-group medlux-treatment-grid medlux-centered-cards medlux-stages\"><!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:image {\"className\":\"medlux-card-icon\"} -->\n<figure class=\"wp-block-image medlux-card-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Consultation with the surgeon</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Before the operation, the surgeon examines you in person, discusses your wishes and confirms the final plan.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:image {\"className\":\"medlux-card-icon\"} -->\n<figure class=\"wp-block-image medlux-card-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Anaesthesia and preparation</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Adults usually receive local anaesthesia, children general anaesthesia. The team prepares the area to be treated.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:image {\"className\":\"medlux-card-icon\"} -->\n<figure class=\"wp-block-image medlux-card-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">The procedure</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>The surgeon reshapes the cartilage of the ear and sets it closer to the head, through a small incision behind the ear.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:image {\"className\":\"medlux-card-icon\"} -->\n<figure class=\"wp-block-image medlux-card-icon\"><img src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Closure and first care</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>The incision is closed and a protective headband is put on.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">How it works with MedLuxLife</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-steps medlux-steps\\u002d\\u002dlist\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group medlux-steps medlux-steps--list\"><!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\"><span class=\"medlux-step-no\">1</span>Contact and online consultation</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Contact us and tell us what you are interested in. We refer you to the right surgeon for an online consultation. Photos or medical documents go directly to the doctor, only on request.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\"><span class=\"medlux-step-no\">2</span>Your personal plan</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>The surgeon recommends the right approach for you. We plan your dates, flights, hotel and transfers around it.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\"><span class=\"medlux-step-no\">3</span>Arrival and surgery</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>After a pre-operative examination, the operation takes place as planned. Your surgeon tells you when you can return to your hotel.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\"><span class=\"medlux-step-no\">4</span>Recovery in Istanbul</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>You rest in your hotel and attend the check-ups at the clinic. The surgeon decides when you are ready to fly home.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\"><span class=\"medlux-step-no\">5</span>Back home</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Stay in touch with us on WhatsApp \u2013 we help with follow-up questions.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Recovery step by step</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"medlux-treatment-grid medlux-centered-cards medlux-timeline\",\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"14rem\"}} -->\n<div class=\"wp-block-group medlux-treatment-grid medlux-centered-cards medlux-timeline\"><!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:paragraph {\"className\":\"medlux-time-label\"} -->\n<p class=\"medlux-time-label\">First days</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>A protective headband is worn; mild swelling is normal.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:paragraph {\"className\":\"medlux-time-label\"} -->\n<p class=\"medlux-time-label\">Days 3\u20135</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Most people return to work, school and daily activities after about 3\u20135 days.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:paragraph {\"className\":\"medlux-time-label\"} -->\n<p class=\"medlux-time-label\">Weeks 1\u20132</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>The supportive headband is recommended for about 1\u20132 weeks to protect the new shape.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-section\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-section\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Frequently asked questions</h2>\n<!-- /wp:heading -->\n\n<!-- wp:accordion {\"className\":\"medlux-faq\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|20\"}},\"layout\":{\"type\":\"default\"}} -->\n<div role=\"group\" class=\"wp-block-accordion medlux-faq\"><!-- wp:accordion-item {\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-accordion-item\"><!-- wp:accordion-heading -->\n<h3 class=\"wp-block-accordion-heading\"><button type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\">From what age is otoplasty possible?</span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">+</span></button></h3>\n<!-- /wp:accordion-heading -->\n\n<!-- wp:accordion-panel -->\n<div role=\"region\" class=\"wp-block-accordion-panel\"><!-- wp:paragraph -->\n<p>For adults and for children from about five years of age.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:accordion-panel --></div>\n<!-- /wp:accordion-item -->\n\n<!-- wp:accordion-item {\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-accordion-item\"><!-- wp:accordion-heading -->\n<h3 class=\"wp-block-accordion-heading\"><button type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\">How long does it take?</span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">+</span></button></h3>\n<!-- /wp:accordion-heading -->\n\n<!-- wp:accordion-panel -->\n<div role=\"region\" class=\"wp-block-accordion-panel\"><!-- wp:paragraph -->\n<p>About 1\u20131.5 hours \u2013 under local anaesthesia for adults, general anaesthesia for children.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:accordion-panel --></div>\n<!-- /wp:accordion-item -->\n\n<!-- wp:accordion-item {\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-accordion-item\"><!-- wp:accordion-heading -->\n<h3 class=\"wp-block-accordion-heading\"><button type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\">How long should I stay in T\u00fcrkiye?</span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">+</span></button></h3>\n<!-- /wp:accordion-heading -->\n\n<!-- wp:accordion-panel -->\n<div role=\"region\" class=\"wp-block-accordion-panel\"><!-- wp:paragraph -->\n<p>This is planned individually with the clinic. We organise your flights and hotel accordingly.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:accordion-panel --></div>\n<!-- /wp:accordion-item -->\n\n<!-- wp:accordion-item {\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-accordion-item\"><!-- wp:accordion-heading -->\n<h3 class=\"wp-block-accordion-heading\"><button type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\">Should I send photos or medical documents to MedLuxLife?</span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">+</span></button></h3>\n<!-- /wp:accordion-heading -->\n\n<!-- wp:accordion-panel -->\n<div role=\"region\" class=\"wp-block-accordion-panel\"><!-- wp:paragraph -->\n<p>No. If the surgeon needs photos or documents, you share them directly with the doctor in your online consultation.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:accordion-panel --></div>\n<!-- /wp:accordion-item --></div>\n<!-- /wp:accordion --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-cta\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-cta\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Plan your ear correction</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Contact us and tell us what you are interested in \u2013 we refer you to the right specialist for an online consultation.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"medlux-btn-primary\"} -->\n<div class=\"wp-block-button medlux-btn-primary\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://medluxlife.de/contact/\">Request a Free Consultation</a></div>\n<!-- /wp:button -->\n\n<!-- wp:button {\"className\":\"medlux-btn-whatsapp\"} -->\n<div class=\"wp-block-button medlux-btn-whatsapp\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://wa.me/380979092326\" target=\"_blank\" rel=\"noreferrer noopener\">WhatsApp</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->\n\n<!-- wp:paragraph {\"className\":\"medlux-disclaimer\"} -->\n<p class=\"medlux-disclaimer\">The information on this page is for general guidance only and does not replace a medical consultation. Suitability for any treatment is assessed individually by a qualified doctor.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n", "rendered": "\n<div class=\"wp-block-columns are-vertically-aligned-center medlux-intro is-layout-flex wp-container-core-columns-is-layout-e35d3e13 wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-vertically-aligned-center is-layout-flow wp-block-column-is-layout-flow\">\n<p class=\"medlux-lead wp-block-paragraph\">Otoplasty reshapes or repositions prominent or asymmetric ears. It is possible for adults and for children from about five years of age. MedLuxLife arranges your online consultation with the surgeon in Istanbul and organises your stay.</p>\n</div>\n\n\n\n<div class=\"wp-block-column is-vertically-aligned-center is-layout-flow wp-block-column-is-layout-flow\">\n<figure class=\"wp-block-image size-large medlux-intro-img\"><img loading=\"lazy\" decoding=\"async\" width=\"1600\" height=\"893\" src=\"https://medluxlife.de/wp-content/uploads/2026/10/gemini-generated-image-qxu2efqxu2efqxu2-opt.jpg\" alt=\"Ear marked for otoplasty\" class=\"wp-image-1423\" srcset=\"https://medluxlife.de/wp-content/uploads/2026/10/gemini-generated-image-qxu2efqxu2efqxu2-opt.jpg 1600w, https://medluxlife.de/wp-content/uploads/2026/10/gemini-generated-image-qxu2efqxu2efqxu2-opt-300x167.jpg 300w, https://medluxlife.de/wp-content/uploads/2026/10/gemini-generated-image-qxu2efqxu2efqxu2-opt-1024x572.jpg 1024w, https://medluxlife.de/wp-content/uploads/2026/10/gemini-generated-image-qxu2efqxu2efqxu2-opt-768x429.jpg 768w, https://medluxlife.de/wp-content/uploads/2026/10/gemini-generated-image-qxu2efqxu2efqxu2-opt-1536x857.jpg 1536w, https://medluxlife.de/wp-content/uploads/2026/10/gemini-generated-image-qxu2efqxu2efqxu2-opt-18x10.jpg 18w\" sizes=\"auto, (max-width: 1600px) 100vw, 1600px\" /></figure>\n</div>\n</div>\n\n\n\n<div class=\"wp-block-group medlux-section medlux-facts-sec has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h2 class=\"wp-block-heading\">Quick facts</h2>\n\n\n\n<div class=\"wp-block-group medlux-facts is-layout-flow wp-block-group-is-layout-flow\">\n<div class=\"wp-block-group medlux-fact has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<figure class=\"wp-block-image medlux-card-icon\"><img decoding=\"async\" src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n\n\n\n<p class=\"medlux-fact-label wp-block-paragraph\">Anaesthesia</p>\n\n\n\n<p class=\"medlux-fact-value wp-block-paragraph\">Local (adults), general (children)</p>\n</div>\n\n\n\n<div class=\"wp-block-group medlux-fact has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<figure class=\"wp-block-image medlux-card-icon\"><img decoding=\"async\" src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n\n\n\n<p class=\"medlux-fact-label wp-block-paragraph\">Operation time</p>\n\n\n\n<p class=\"medlux-fact-value wp-block-paragraph\">About 1\u20131.5 hours</p>\n</div>\n\n\n\n<div class=\"wp-block-group medlux-fact has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<figure class=\"wp-block-image medlux-card-icon\"><img decoding=\"async\" src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n\n\n\n<p class=\"medlux-fact-label wp-block-paragraph\">Daily activities</p>\n\n\n\n<p class=\"medlux-fact-value wp-block-paragraph\">After about 3\u20135 days</p>\n</div>\n\n\n\n<div class=\"wp-block-group medlux-fact has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<figure class=\"wp-block-image medlux-card-icon\"><img decoding=\"async\" src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n\n\n\n<p class=\"medlux-fact-label wp-block-paragraph\">Headband</p>\n\n\n\n<p class=\"medlux-fact-value wp-block-paragraph\">For about 1\u20132 weeks</p>\n</div>\n\n\n\n<div class=\"wp-block-group medlux-fact has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<figure class=\"wp-block-image medlux-card-icon\"><img decoding=\"async\" src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n\n\n\n<p class=\"medlux-fact-label wp-block-paragraph\">Stay in T\u00fcrkiye</p>\n\n\n\n<p class=\"medlux-fact-value wp-block-paragraph\">Planned individually with the clinic</p>\n</div>\n</div>\n\n\n\n<p class=\"medlux-facts-note wp-block-paragraph\">General information; your surgeon plans the details for you personally.</p>\n</div>\n\n\n\n<div class=\"wp-block-group medlux-section medlux-suitable has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h2 class=\"wp-block-heading\">Who it may be suitable for</h2>\n\n\n\n<ul class=\"wp-block-list medlux-checklist\">\n<li>Your ears \u2013 or your child&#8217;s ears \u2013 stick out or are asymmetric.</li>\n\n\n<li>Adults and children from about five years of age.</li>\n\n\n<li>Good general health.</li>\n</ul>\n\n\n\n<p class=\"medlux-suitable-note wp-block-paragraph\">Whether the procedure is suitable for you is decided by the surgeon after a personal assessment.</p>\n</div>\n\n\n\n<div class=\"wp-block-group medlux-section has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h2 class=\"wp-block-heading\">How the operation is performed</h2>\n\n\n\n<div class=\"wp-block-group medlux-treatment-grid medlux-centered-cards medlux-stages is-layout-grid wp-container-core-group-is-layout-3d9eeadc wp-block-group-is-layout-grid\">\n<div class=\"wp-block-group medlux-card has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<figure class=\"wp-block-image medlux-card-icon\"><img decoding=\"async\" src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n\n\n\n<h3 class=\"wp-block-heading\">Consultation with the surgeon</h3>\n\n\n\n<p class=\"wp-block-paragraph\">Before the operation, the surgeon examines you in person, discusses your wishes and confirms the final plan.</p>\n</div>\n\n\n\n<div class=\"wp-block-group medlux-card has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<figure class=\"wp-block-image medlux-card-icon\"><img decoding=\"async\" src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n\n\n\n<h3 class=\"wp-block-heading\">Anaesthesia and preparation</h3>\n\n\n\n<p class=\"wp-block-paragraph\">Adults usually receive local anaesthesia, children general anaesthesia. The team prepares the area to be treated.</p>\n</div>\n\n\n\n<div class=\"wp-block-group medlux-card has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<figure class=\"wp-block-image medlux-card-icon\"><img decoding=\"async\" src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n\n\n\n<h3 class=\"wp-block-heading\">The procedure</h3>\n\n\n\n<p class=\"wp-block-paragraph\">The surgeon reshapes the cartilage of the ear and sets it closer to the head, through a small incision behind the ear.</p>\n</div>\n\n\n\n<div class=\"wp-block-group medlux-card has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<figure class=\"wp-block-image medlux-card-icon\"><img decoding=\"async\" src=\"data:image/svg+xml;base64,\" alt=\"\"/></figure>\n\n\n\n<h3 class=\"wp-block-heading\">Closure and first care</h3>\n\n\n\n<p class=\"wp-block-paragraph\">The incision is closed and a protective headband is put on.</p>\n</div>\n</div>\n</div>\n\n\n\n<div class=\"wp-block-group medlux-section has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h2 class=\"wp-block-heading\">How it works with MedLuxLife</h2>\n\n\n\n<div class=\"wp-block-group medlux-steps medlux-steps--list is-layout-flow wp-block-group-is-layout-flow\">\n<div class=\"wp-block-group medlux-card has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h3 class=\"wp-block-heading\"><span class=\"medlux-step-no\">1</span>Contact and online consultation</h3>\n\n\n\n<p class=\"wp-block-paragraph\">Contact us and tell us what you are interested in. We refer you to the right surgeon for an online consultation. Photos or medical documents go directly to the doctor, only on request.</p>\n</div>\n\n\n\n<div class=\"wp-block-group medlux-card has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h3 class=\"wp-block-heading\"><span class=\"medlux-step-no\">2</span>Your personal plan</h3>\n\n\n\n<p class=\"wp-block-paragraph\">The surgeon recommends the right approach for you. We plan your dates, flights, hotel and transfers around it.</p>\n</div>\n\n\n\n<div class=\"wp-block-group medlux-card has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h3 class=\"wp-block-heading\"><span class=\"medlux-step-no\">3</span>Arrival and surgery</h3>\n\n\n\n<p class=\"wp-block-paragraph\">After a pre-operative examination, the operation takes place as planned. Your surgeon tells you when you can return to your hotel.</p>\n</div>\n\n\n\n<div class=\"wp-block-group medlux-card has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h3 class=\"wp-block-heading\"><span class=\"medlux-step-no\">4</span>Recovery in Istanbul</h3>\n\n\n\n<p class=\"wp-block-paragraph\">You rest in your hotel and attend the check-ups at the clinic. The surgeon decides when you are ready to fly home.</p>\n</div>\n\n\n\n<div class=\"wp-block-group medlux-card has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h3 class=\"wp-block-heading\"><span class=\"medlux-step-no\">5</span>Back home</h3>\n\n\n\n<p class=\"wp-block-paragraph\">Stay in touch with us on WhatsApp \u2013 we help with follow-up questions.</p>\n</div>\n</div>\n</div>\n\n\n\n<div class=\"wp-block-group medlux-section has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h2 class=\"wp-block-heading\">Recovery step by step</h2>\n\n\n\n<div class=\"wp-block-group medlux-treatment-grid medlux-centered-cards medlux-timeline is-layout-grid wp-container-core-group-is-layout-3d9eeadc wp-block-group-is-layout-grid\">\n<div class=\"wp-block-group medlux-card has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<p class=\"medlux-time-label wp-block-paragraph\">First days</p>\n\n\n\n<p class=\"wp-block-paragraph\">A protective headband is worn; mild swelling is normal.</p>\n</div>\n\n\n\n<div class=\"wp-block-group medlux-card has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<p class=\"medlux-time-label wp-block-paragraph\">Days 3\u20135</p>\n\n\n\n<p class=\"wp-block-paragraph\">Most people return to work, school and daily activities after about 3\u20135 days.</p>\n</div>\n\n\n\n<div class=\"wp-block-group medlux-card has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<p class=\"medlux-time-label wp-block-paragraph\">Weeks 1\u20132</p>\n\n\n\n<p class=\"wp-block-paragraph\">The supportive headband is recommended for about 1\u20132 weeks to protect the new shape.</p>\n</div>\n</div>\n</div>\n\n\n\n<div class=\"wp-block-group medlux-section has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h2 class=\"wp-block-heading\">Frequently asked questions</h2>\n\n\n\n<div data-wp-context=\"{ &quot;autoclose&quot;: false, &quot;accordionItems&quot;: [] }\" data-wp-interactive=\"core/accordion\" role=\"group\" class=\"wp-block-accordion medlux-faq is-layout-flow wp-container-core-accordion-is-layout-9d106e0c wp-block-accordion-is-layout-flow\">\n<div data-wp-class--is-open=\"state.isOpen\" data-wp-context=\"{ &quot;id&quot;: &quot;accordion-item-5&quot;, &quot;openByDefault&quot;: false }\" data-wp-init=\"callbacks.initAccordionItems\" data-wp-on-window--hashchange=\"callbacks.hashChange\" class=\"wp-block-accordion-item is-layout-flow wp-container-core-accordion-item-is-layout-1ff0f1e1 wp-block-accordion-item-is-layout-flow\">\n<h3 class=\"wp-block-accordion-heading\"><button aria-expanded=\"false\" aria-controls=\"accordion-item-5-panel\" data-wp-bind--aria-expanded=\"state.isOpen\" data-wp-on--click=\"actions.toggle\" id=\"accordion-item-5\" type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\">From what age is otoplasty possible?</span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">+</span></button></h3>\n\n\n\n<div aria-labelledby=\"accordion-item-5\" data-wp-bind--hidden=\"state.isHidden\" data-wp-on--beforematch=\"actions.handleBeforeMatch\" id=\"accordion-item-5-panel\" role=\"region\" class=\"wp-block-accordion-panel is-layout-flow wp-block-accordion-panel-is-layout-flow\">\n<p class=\"wp-block-paragraph\">For adults and for children from about five years of age.</p>\n</div>\n</div>\n\n\n\n<div data-wp-class--is-open=\"state.isOpen\" data-wp-context=\"{ &quot;id&quot;: &quot;accordion-item-6&quot;, &quot;openByDefault&quot;: false }\" data-wp-init=\"callbacks.initAccordionItems\" data-wp-on-window--hashchange=\"callbacks.hashChange\" class=\"wp-block-accordion-item is-layout-flow wp-container-core-accordion-item-is-layout-1ff0f1e1 wp-block-accordion-item-is-layout-flow\">\n<h3 class=\"wp-block-accordion-heading\"><button aria-expanded=\"false\" aria-controls=\"accordion-item-6-panel\" data-wp-bind--aria-expanded=\"state.isOpen\" data-wp-on--click=\"actions.toggle\" id=\"accordion-item-6\" type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\">How long does it take?</span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">+</span></button></h3>\n\n\n\n<div aria-labelledby=\"accordion-item-6\" data-wp-bind--hidden=\"state.isHidden\" data-wp-on--beforematch=\"actions.handleBeforeMatch\" id=\"accordion-item-6-panel\" role=\"region\" class=\"wp-block-accordion-panel is-layout-flow wp-block-accordion-panel-is-layout-flow\">\n<p class=\"wp-block-paragraph\">About 1\u20131.5 hours \u2013 under local anaesthesia for adults, general anaesthesia for children.</p>\n</div>\n</div>\n\n\n\n<div data-wp-class--is-open=\"state.isOpen\" data-wp-context=\"{ &quot;id&quot;: &quot;accordion-item-7&quot;, &quot;openByDefault&quot;: false }\" data-wp-init=\"callbacks.initAccordionItems\" data-wp-on-window--hashchange=\"callbacks.hashChange\" class=\"wp-block-accordion-item is-layout-flow wp-container-core-accordion-item-is-layout-1ff0f1e1 wp-block-accordion-item-is-layout-flow\">\n<h3 class=\"wp-block-accordion-heading\"><button aria-expanded=\"false\" aria-controls=\"accordion-item-7-panel\" data-wp-bind--aria-expanded=\"state.isOpen\" data-wp-on--click=\"actions.toggle\" id=\"accordion-item-7\" type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\">How long should I stay in T\u00fcrkiye?</span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">+</span></button></h3>\n\n\n\n<div aria-labelledby=\"accordion-item-7\" data-wp-bind--hidden=\"state.isHidden\" data-wp-on--beforematch=\"actions.handleBeforeMatch\" id=\"accordion-item-7-panel\" role=\"region\" class=\"wp-block-accordion-panel is-layout-flow wp-block-accordion-panel-is-layout-flow\">\n<p class=\"wp-block-paragraph\">This is planned individually with the clinic. We organise your flights and hotel accordingly.</p>\n</div>\n</div>\n\n\n\n<div data-wp-class--is-open=\"state.isOpen\" data-wp-context=\"{ &quot;id&quot;: &quot;accordion-item-8&quot;, &quot;openByDefault&quot;: false }\" data-wp-init=\"callbacks.initAccordionItems\" data-wp-on-window--hashchange=\"callbacks.hashChange\" class=\"wp-block-accordion-item is-layout-flow wp-container-core-accordion-item-is-layout-1ff0f1e1 wp-block-accordion-item-is-layout-flow\">\n<h3 class=\"wp-block-accordion-heading\"><button aria-expanded=\"false\" aria-controls=\"accordion-item-8-panel\" data-wp-bind--aria-expanded=\"state.isOpen\" data-wp-on--click=\"actions.toggle\" id=\"accordion-item-8\" type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\">Should I send photos or medical documents to MedLuxLife?</span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">+</span></button></h3>\n\n\n\n<div aria-labelledby=\"accordion-item-8\" data-wp-bind--hidden=\"state.isHidden\" data-wp-on--beforematch=\"actions.handleBeforeMatch\" id=\"accordion-item-8-panel\" role=\"region\" class=\"wp-block-accordion-panel is-layout-flow wp-block-accordion-panel-is-layout-flow\">\n<p class=\"wp-block-paragraph\">No. If the surgeon needs photos or documents, you share them directly with the doctor in your online consultation.</p>\n</div>\n</div>\n</div>\n</div>\n\n\n\n<div class=\"wp-block-group medlux-cta has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h2 class=\"wp-block-heading\">Plan your ear correction</h2>\n\n\n\n<p class=\"wp-block-paragraph\">Contact us and tell us what you are interested in \u2013 we refer you to the right specialist for an online consultation.</p>\n\n\n\n<div class=\"wp-block-buttons is-layout-flex wp-block-buttons-is-layout-flex\">\n<div class=\"wp-block-button medlux-btn-primary\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://medluxlife.de/contact/\">Request a Free Consultation</a></div>\n\n\n\n<div class=\"wp-block-button medlux-btn-whatsapp\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://wa.me/380979092326\" target=\"_blank\" rel=\"noreferrer noopener\">WhatsApp</a></div>\n</div>\n\n\n\n<p class=\"medlux-disclaimer wp-block-paragraph\">The information on this page is for general guidance only and does not replace a medical consultation. Suitability for any treatment is assessed individually by a qualified doctor.</p>\n</div>\n\n", "protected": false, "block_version": 1}, "excerpt": {"raw": "", "rendered": "<p>Otoplasty reshapes or repositions prominent or asymmetric ears. It is possible for adults and for children from about five years of age. MedLuxLife arranges your online consultation with the surgeon in Istanbul and organises your stay. Quick facts Anaesthesia Local (adults), general (children) Operation time About 1\u20131.5 hours Daily activities After about 3\u20135 days Headband [&hellip;]</p>\n", "protected": false}, "author": 2, "featured_media": 0, "parent": 263, "menu_order": 0, "comment_status": "closed", "ping_status": "closed", "template": "page-with-title", "meta": {"footnotes": ""}, "permalink_template": "https://medluxlife.de/health/clinical-treatments/plastic-surgery/%pagename%/", "generated_slug": "otoplasty-ear-correction", "class_list": ["post-2338", "page", "type-page", "status-publish", "hentry"], "_links": {"self": [{"href": "https://medluxlife.de/wp-json/wp/v2/pages/2338", "targetHints": {"allow": ["GET", "POST", "PUT", "PATCH", "DELETE"]}}], "collection": [{"href": "https://medluxlife.de/wp-json/wp/v2/pages"}], "about": [{"href": "https://medluxlife.de/wp-json/wp/v2/types/page"}], "author": [{"embeddable": true, "href": "https://medluxlife.de/wp-json/wp/v2/users/2"}], "replies": [{"embeddable": true, "href": "https://medluxlife.de/wp-json/wp/v2/comments?post=2338"}], "version-history": [{"count": 0, "href": "https://medluxlife.de/wp-json/wp/v2/pages/2338/revisions"}], "up": [{"embeddable": true, "href": "https://medluxlife.de/wp-json/wp/v2/pages/263"}], "wp:attachment": [{"href": "https://medluxlife.de/wp-json/wp/v2/media?parent=2338"}], "wp:action-publish": [{"href": "https://medluxlife.de/wp-json/wp/v2/pages/2338"}], "wp:action-unfiltered-html": [{"href": "https://medluxlife.de/wp-json/wp/v2/pages/2338"}], "wp:action-assign-author": [{"href": "https://medluxlife.de/wp-json/wp/v2/pages/2338"}], "curies": [{"name": "wp", "href": "https://api.w.org/{rel}", "templated": true}]}}