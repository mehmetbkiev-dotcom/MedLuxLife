!-- \/wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Joint replacement, arthroscopy, spine and sports injuries, with rehabilitation.<\/p>\n<!-- \/wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-more\"} -->\n<p class=\"medlux-more\"><a href=\"https:\/\/medluxlife-6j8sz55bpn.live-website.com\/health\/hospital-specialist-treatments\/orthopedics-and-traumatology\/\">Learn more \u2192<\/a><\/p>\n<!-- \/wp:paragraph --><\/div>\n<!-- \/wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">In-Vitro Fertilization (IVF)<\/h3>\n<!-- \/wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Fertility assessment and assisted reproduction with personal, discreet care.<\/p>\n<!-- \/wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-more\"} -->\n<p class=\"medlux-more\"><a href=\"https:\/\/medluxlife-6j8sz55bpn.live-website.com\/health\/hospital-specialist-treatments\/in-vitro-fertilization-ivf\/\">Learn more \u2192<\/a><\/p>\n<!-- \/wp:paragraph --><\/div>\n<!-- \/wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Neurosurgery<\/h3>\n<!-- \/wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Surgery of the brain, spine and nerves using modern, minimally invasive techniques.<\/p>\n<!-- \/wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"medlux-more\"} -->\n<p class=\"medlux-more\"><a href=\"https:\/\/medluxlife-6j8sz55bpn.live-website.com\/health\/hospital-specialist-treatments\/neurosurgery\/\">Learn more \u2192<\/a><\/p>\n<!-- \/wp:paragraph --><\/div>\n<!-- \/wp:group -->\n\n<!-- wp:group {\"className\":\"medlux-card\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group medlux-card\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-bloc