{"id":"extendable\/\/footer","theme":"extendable","content":{"raw":"<!-- wp:group {\"align\":\"full\",\"className\":\"is-style-ext-preset\\u002d\\u002dgroup\\u002d\\u002dnatural-1\\u002d\\u002dfooter-1\",\"style\":{\"spacing\":{\"padding\":{\"bottom\":\"var:preset|spacing|60\",\"top\":\"var:preset|spacing|60\"}}},\"layout\":{\"inherit\":true,\"type\":\"constrained\"}} -->\n<div\n\tclass=\"wp-block-group alignfull is-style-ext-preset--group--natural-1--footer-1\"\n\tstyle=\"\n\t\tpadding-top: var(--wp--preset--spacing--60);\n\t\tpadding-bottom: var(--wp--preset--spacing--60);\n\t\"\n>\n\t<!-- wp:group {\"className\":\"ext-animate\\u002d\\u002don\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|30\"}}} -->\n\t<div class=\"wp-block-group ext-animate--on\">\n\t\t<!-- wp:social-links {\"iconColor\":\"foreground\",\"iconColorValue\":\"#0B0620\",\"size\":\"has-normal-icon-size\",\"style\":{\"spacing\":{\"blockGap\":{\"top\":\"10px\",\"left\":\"10px\"}}},\"className\":\"is-style-logos-only\",\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} -->\n\t\t<ul\n\t\t\tclass=\"wp-block-social-links has-normal-icon-size has-icon-color is-style-logos-only\"\n\t\t>\n\t\t\t<!-- wp:social-link {\"url\":\"https:\/\/www.instagram.com\/medluxlife\/\",\"service\":\"instagram\",\"label\":\"MedLuxLife on Instagram\"} \/-->\n\t\t\t<!-- wp:social-link {\"url\":\"https:\/\/www.facebook.com\/profile.php?id=61594715669578\",\"service\":\"facebook\",\"label\":\"MedLuxLife on Facebook\"} \/-->\n\t\t<\/ul>\n\t\t<!-- \/wp:social-links -->\n\n\t\t<!-- wp:site-title {\"level\":0,\"textAlign\":\"center\",\"style\":{\"typography\":{\"fontStyle\":\"normal\",\"fontWeight\":\"400\"}},\"fontSize\":\"medium\"} \/-->\n\n\t\t<!-- wp:paragraph {\"align\":\"center\",\"className\":\"medlux-footer-legal\"} -->\n\t\t<p class=\"has-text-align-center medlux-footer-legal\"><a href=\"https:\/\/medluxlife.de\/impressum\/\">Impressum<\/a> <span aria-hidden=\"true\">|<\/span> <a href=\"https:\/\/medluxlife.de\/privacy-policy\/\">Datenschutz<\/a> <span aria-hidden=\"true\">|<\/span> <a href=\"https:\/\/medluxlife.de\/terms\/\">AGB<\/a> <span aria-hidden=\"true\">|<\/span> <a href=\"https:\/\/medluxlife.de\/widerrufsbelehrung\/\">Widerrufsbelehrung<\/a> <span aria-hidden=\"true\">|<\/span> <a href=\"https:\/\/medluxlife.de\/stornierungsbedingungen\/\">Stornierungsbedingungen<\/a><\/p>\n\t\t<!-- \/wp:paragraph -->\n\t<\/div>\n\t<!-- \/wp:group -->\n<\/div>\n<!-- \/wp:group -->\n\n<!-- wp:html -->\n<div id=\"mlx-assistant\" class=\"mlx-a\" data-wa=\"380979092326\">\n<style>\n.mlx-a{--gold:#d4a24c;--gold2:#e8b75c;--ink:#0b0620;--navy:#1b1530;font-family:inherit}\n.mlx-a *{box-sizing:border-box}\n.mlx-a-fab{position:fixed;right:20px;bottom:20px;z-index:9998;display:flex;align-items:center;gap:10px;background:var(--navy);color:#fff;border:2px solid var(--gold);border-radius:999px;padding:7px 18px 7px 8px;box-shadow:0 8px 24px rgba(11,6,32,.35);cursor:pointer;font:600 15px\/1.2 inherit;letter-spacing:.02em}\n.mlx-a-fab:hover{background:#2a2245}\n.mlx-a-fab svg{width:40px;height:40px;flex:none}\n.mlx-a-lbl{display:flex;flex-direction:column;align-items:flex-start;line-height:1.15}\n.mlx-a-lbl b{font-size:15px}\n.mlx-a-lbl small{font-size:11.5px;font-weight:500;opacity:.8;margin-top:2px}\n.mlx-a[data-live=\"0\"] .mlx-a-dot{background:#9aa0a6;box-shadow:0 0 0 3px rgba(154,160,166,.25)}\n.mlx-a-head .mlx-a-av svg{width:44px;height:44px}\n.mlx-a-fab .mlx-a-dot{width:9px;height:9px;border-radius:50%;background:#3ccf6e;box-shadow:0 0 0 3px rgba(60,207,110,.25)}\n.mlx-a[data-open=\"1\"] .mlx-a-fab{display:none}\n.mlx-a-panel{position:fixed;right:20px;bottom:20px;z-index:9999;width:370px;max-width:calc(100vw - 24px);max-height:min(640px,calc(100vh - 40px));display:none;flex-direction:column;background:#fff;border-radius:18px;box-shadow:0 18px 48px rgba(11,6,32,.35);overflow:hidden}\n.mlx-a[data-open=\"1\"] .mlx-a-panel{display:flex}\n.mlx-a-head{background:var(--navy);color:#fff;padding:16px 18px;display:flex;align-items:center;gap:12px;border-bottom:2px solid var(--gold)}\n.mlx-a-head .mlx-a-av{width:44px;height:44px;border-radius:50%;display:flex;flex:none}\n.mlx-a-head strong{display:block;font-size:16px}\n.mlx-a-head small{display:block;font-size:12px;opacity:.75;margin-top:2px}\n.mlx-a-x{margin-left:auto;background:none;border:0;color:#fff;font-size:26px;line-height:1;cursor:pointer;opacity:.8;padding:4px}\n.mlx-a-x:hover{opacity:1}\n.mlx-a-body{padding:16px;overflow-y:auto;background:#f7f5fb;flex:1}\n.mlx-a-msg{background:#fff;border-radius:4px 14px 14px 14px;padding:11px 14px;margin:0 0 10px;font-size:14.5px;line-height:1.5;color:var(--ink);box-shadow:0 1px 2px rgba(11,6,32,.08);max-width:92%}\n.mlx-a-you{background:var(--gold);color:var(--ink);border-radius:14px 4px 14px 14px;margin-left:auto;font-weight:600;width:fit-content}\n.mlx-a-step{display:none}\n.mlx-a-step.on{display:block;animation:mlxIn .25s ease}\n@keyframes mlxIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}\n.mlx-a-opts{display:flex;flex-wrap:wrap;gap:8px;margin:4px 0 12px}\n.mlx-a-opt{background:#fff;border:1.5px solid var(--gold);color:var(--ink);border-radius:999px;padding:8px 14px;font:600 13.5px\/1.2 inherit;cursor:pointer}\n.mlx-a-opt:hover,.mlx-a-opt:focus-visible{background:var(--gold);outline:none}\n.mlx-a-big .mlx-a-opt{flex:1 1 45%;border-radius:12px;padding:14px 10px;font-size:15px;text-align:center}\n.mlx-a-consent{display:flex;gap:10px;align-items:flex-start;background:#fff;border:1px solid rgba(212,162,76,.5);border-radius:12px;padding:12px;font-size:13px;line-height:1.5;color:var(--ink);cursor:pointer}\n.mlx-a-consent input{width:18px;height:18px;margin-top:2px;accent-color:var(--gold);flex:none}\n.mlx-a-consent a,.mlx-a-note a{color:#9a6c1d;font-weight:600}\n.mlx-a-note{font-size:12.5px;color:rgba(11,6,32,.7);line-height:1.5;margin:8px 2px}\n.mlx-a-next{width:100%;margin-top:12px;background:var(--gold);color:var(--ink);border:0;border-radius:999px;padding:12px;font:700 14px\/1 inherit;letter-spacing:.03em;cursor:pointer}\n.mlx-a-next:disabled{opacity:.45;cursor:not-allowed}\n.mlx-a-ch{display:flex;align-items:center;gap:12px;width:100%;background:#fff;border:1.5px solid rgba(11,6,32,.12);border-radius:12px;padding:12px 14px;margin-bottom:8px;color:var(--ink);text-decoration:none;font:600 14.5px\/1.3 inherit;cursor:pointer;text-align:left}\n.mlx-a-ch:hover{border-color:var(--gold);background:#fffaf0}\n.mlx-a-ch svg{width:24px;height:24px;flex:none}\n.mlx-a-ch small{display:block;font-weight:400;font-size:12px;color:rgba(11,6,32,.6)}\n.mlx-a-back{background:none;border:0;color:rgba(11,6,32,.6);font:600 12.5px\/1 inherit;cursor:pointer;padding:6px 0;margin-top:4px}\n.mlx-a-back:hover{color:var(--ink)}\n@media (max-width:600px){.mlx-a-fab{right:14px;bottom:14px;padding:9px 14px 9px 10px;font-size:14px}.mlx-a-panel{right:0;bottom:0;width:100vw;max-width:100vw;max-height:88vh;border-radius:18px 18px 0 0}}\n@media print{.mlx-a{display:none}}\n<\/style>\n<button type=\"button\" class=\"mlx-a-fab\" aria-haspopup=\"dialog\" aria-controls=\"mlx-a-panel\" aria-expanded=\"false\">\n<svg viewBox=\"0 0 48 48\" aria-hidden=\"true\"><circle cx=\"24\" cy=\"24\" r=\"24\" fill=\"#d4a24c\"\/><path d=\"M9 45c1.5-8.5 7.5-13 15-13s13.5 4.5 15 13a24 24 0 0 1-30 0z\" fill=\"#1b1530\"\/><path d=\"M20.5 32.5 24 37l3.5-4.5\" fill=\"#fff\"\/><circle cx=\"24\" cy=\"21\" r=\"8.5\" fill=\"#f3d9b8\"\/><path d=\"M15.5 20.5c0-6 3.8-9.5 8.5-9.5s8.5 3.5 8.5 9.5c-1.6-2.9-4.4-4.6-8.5-4.6s-6.9 1.7-8.5 4.6z\" fill=\"#3a2a1e\"\/><path d=\"M14.2 22a9.8 9.8 0 0 1 19.6 0\" fill=\"none\" stroke=\"#1b1530\" stroke-width=\"1.8\" stroke-linecap=\"round\"\/><rect x=\"12.4\" y=\"20\" width=\"3.4\" height=\"6\" rx=\"1.6\" fill=\"#1b1530\"\/><rect x=\"32.2\" y=\"20\" width=\"3.4\" height=\"6\" rx=\"1.6\" fill=\"#1b1530\"\/><path d=\"M14.4 26c0 3.2 2.6 5 6.1 5\" fill=\"none\" stroke=\"#1b1530\" stroke-width=\"1.5\" stroke-linecap=\"round\"\/><circle cx=\"21\" cy=\"31\" r=\"1.4\" fill=\"#1b1530\"\/><\/svg>\n<span class=\"mlx-a-lbl\"><b>Live Chat<\/b><small>Mo\u2013Fr 9\u201318<\/small><\/span><span class=\"mlx-a-dot\" aria-hidden=\"true\"><\/span>\n<\/button>\n<div class=\"mlx-a-panel\" id=\"mlx-a-panel\" role=\"dialog\" aria-modal=\"false\" aria-labelledby=\"mlx-a-title\">\n<div class=\"mlx-a-head\"><div class=\"mlx-a-av\" aria-hidden=\"true\"><svg viewBox=\"0 0 48 48\" aria-hidden=\"true\"><circle cx=\"24\" cy=\"24\" r=\"24\" fill=\"#d4a24c\"\/><path d=\"M9 45c1.5-8.5 7.5-13 15-13s13.5 4.5 15 13a24 24 0 0 1-30 0z\" fill=\"#1b1530\"\/><path d=\"M20.5 32.5 24 37l3.5-4.5\" fill=\"#fff\"\/><circle cx=\"24\" cy=\"21\" r=\"8.5\" fill=\"#f3d9b8\"\/><path d=\"M15.5 20.5c0-6 3.8-9.5 8.5-9.5s8.5 3.5 8.5 9.5c-1.6-2.9-4.4-4.6-8.5-4.6s-6.9 1.7-8.5 4.6z\" fill=\"#3a2a1e\"\/><path d=\"M14.2 22a9.8 9.8 0 0 1 19.6 0\" fill=\"none\" stroke=\"#1b1530\" stroke-width=\"1.8\" stroke-linecap=\"round\"\/><rect x=\"12.4\" y=\"20\" width=\"3.4\" height=\"6\" rx=\"1.6\" fill=\"#1b1530\"\/><rect x=\"32.2\" y=\"20\" width=\"3.4\" height=\"6\" rx=\"1.6\" fill=\"#1b1530\"\/><path d=\"M14.4 26c0 3.2 2.6 5 6.1 5\" fill=\"none\" stroke=\"#1b1530\" stroke-width=\"1.5\" stroke-linecap=\"round\"\/><circle cx=\"21\" cy=\"31\" r=\"1.4\" fill=\"#1b1530\"\/><\/svg><\/div><div><strong id=\"mlx-a-title\">MedLuxLife Live Chat<\/strong><small class=\"mlx-a-status\">Mo\u2013Fr 9:00\u201318:00 \u00b7 DE \u00b7 EN \u00b7 TR \u00b7 UK \u00b7 RU<\/small><\/div><button type=\"button\" class=\"mlx-a-x\" aria-label=\"Close\">\u00d7<\/button><\/div>\n<div class=\"mlx-a-body\" aria-live=\"polite\">\n<div class=\"mlx-a-step on\" data-step=\"1\">\n<p class=\"mlx-a-msg\">Hello and welcome to MedLuxLife!<\/p>\n<p class=\"mlx-a-msg mlx-a-off\" hidden>Our team is currently offline. Leave us a message and we will get back to you on the next working day.<\/p>\n<p class=\"mlx-a-msg\">What can we help you with today?<\/p>\n<div class=\"mlx-a-opts mlx-a-big\"><button type=\"button\" class=\"mlx-a-opt\" data-area=\"Health\">Health<\/button><button type=\"button\" class=\"mlx-a-opt\" data-area=\"Travel\">Travel<\/button><\/div>\n<\/div>\n<div class=\"mlx-a-step\" data-step=\"2h\">\n<p class=\"mlx-a-msg mlx-a-you\">Health<\/p>\n<p class=\"mlx-a-msg\">Which area are you interested in?<\/p>\n<div class=\"mlx-a-opts\"><button type=\"button\" class=\"mlx-a-opt\" data-topic=\"Dental treatment\">Dental treatment<\/button><button type=\"button\" class=\"mlx-a-opt\" data-topic=\"Hair transplantation\">Hair transplantation<\/button><button type=\"button\" class=\"mlx-a-opt\" data-topic=\"Plastic surgery\">Plastic surgery<\/button><button type=\"button\" class=\"mlx-a-opt\" data-topic=\"Medical aesthetics\">Medical aesthetics<\/button><button type=\"button\" class=\"mlx-a-opt\" data-topic=\"Bariatric surgery\">Bariatric surgery<\/button><button type=\"button\" class=\"mlx-a-opt\" data-topic=\"Check-up\">Check-up<\/button><button type=\"button\" class=\"mlx-a-opt\" data-topic=\"IV treatments\">IV treatments<\/button><button type=\"button\" class=\"mlx-a-opt\" data-topic=\"Hospital &amp; specialist treatment\">Hospital &amp; specialist treatment<\/button><button type=\"button\" class=\"mlx-a-opt\" data-topic=\"Other\">Other<\/button><\/div>\n<button type=\"button\" class=\"mlx-a-back\" data-go=\"1\">\u2190 Back<\/button>\n<\/div>\n<div class=\"mlx-a-step\" data-step=\"2t\">\n<p class=\"mlx-a-msg mlx-a-you\">Travel<\/p>\n<p class=\"mlx-a-msg\">Which travel service are you interested in?<\/p>\n<div class=\"mlx-a-opts\"><button type=\"button\" class=\"mlx-a-opt\" data-topic=\"Holiday packages\">Holiday packages<\/button><button type=\"button\" class=\"mlx-a-opt\" data-topic=\"Hotel reservation\">Hotel reservation<\/button><button type=\"button\" class=\"mlx-a-opt\" data-topic=\"Flight tickets\">Flight tickets<\/button><button type=\"button\" class=\"mlx-a-opt\" data-topic=\"Airport transfer\">Airport transfer<\/button><button type=\"button\" class=\"mlx-a-opt\" data-topic=\"Hajj &amp; Umrah\">Hajj &amp; Umrah<\/button><button type=\"button\" class=\"mlx-a-opt\" data-topic=\"Other\">Other<\/button><\/div>\n<button type=\"button\" class=\"mlx-a-back\" data-go=\"1\">\u2190 Back<\/button>\n<\/div>\n<div class=\"mlx-a-step\" data-step=\"3\">\n<p class=\"mlx-a-msg mlx-a-you\" data-out=\"choice\"><\/p>\n<p class=\"mlx-a-msg\">Thank you! Before we connect you with our team, please confirm the following:<\/p>\n<label class=\"mlx-a-consent\"><input type=\"checkbox\" class=\"mlx-a-ok\"><span>I have read the <a href=\"\/privacy-policy\/\" target=\"_blank\" rel=\"noopener\">Privacy Policy (Datenschutzerkl\u00e4rung)<\/a> and agree that MedLuxLife processes my contact details and message to answer my enquiry. I can withdraw my consent at any time.<\/span><\/label>\n<p class=\"mlx-a-note mlx-a-hnote\">Please do not send detailed medical information or documents at this stage. If they are needed, we will ask you for them separately and only with your explicit consent.<\/p>\n<button type=\"button\" class=\"mlx-a-next\" disabled>Continue<\/button>\n<button type=\"button\" class=\"mlx-a-back\" data-go=\"2\">\u2190 Back<\/button>\n<\/div>\n<div class=\"mlx-a-step\" data-step=\"4\">\n<p class=\"mlx-a-msg\">How would you like to reach us?<\/p>\n<a class=\"mlx-a-ch\" data-ch=\"wa\" href=\"#\" target=\"_blank\" rel=\"noopener\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path fill=\"#25d366\" d=\"M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2z\"\/><path fill=\"#fff\" d=\"M17.3 14.3c-.3-.1-1.7-.8-1.9-.9-.3-.1-.5-.1-.7.1l-.9 1.1c-.2.2-.3.2-.6.1a7 7 0 0 1-3.5-3c-.3-.5.3-.4.8-1.4.1-.2 0-.3 0-.5l-.9-2c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2c.2-.6.2-1 .1-1.2l-.5-.5z\"\/><\/svg><span>WhatsApp<small>Chat with our team. WhatsApp (Meta) processes your data according to its own privacy policy.<\/small><\/span><\/a>\n<a class=\"mlx-a-ch\" data-ch=\"form\" href=\"\/contact\/\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" fill=\"none\" stroke=\"#0b0620\" stroke-width=\"1.7\"><rect x=\"4\" y=\"3\" width=\"16\" height=\"18\" rx=\"2\"\/><path d=\"M8 8h8M8 12h8M8 16h5\"\/><\/svg><span>Contact form<small>Your topic is filled in automatically.<\/small><\/span><\/a>\n<a class=\"mlx-a-ch\" data-ch=\"tel\" href=\"tel:+4916093448714\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" fill=\"none\" stroke=\"#0b0620\" stroke-width=\"1.7\"><path d=\"M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z\"\/><\/svg><span>Call us<small>+49 160 93 44 87 14<\/small><\/span><\/a>\n<a class=\"mlx-a-ch\" data-ch=\"mail\" href=\"mailto:info@medluxlife.de\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" fill=\"none\" stroke=\"#0b0620\" stroke-width=\"1.7\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"\/><path d=\"m3 7 9 6 9-6\"\/><\/svg><span>Email<small>info@medluxlife.de<\/small><\/span><\/a>\n<button type=\"button\" class=\"mlx-a-back\" data-go=\"1\">\u21ba Start over<\/button>\n<\/div>\n<\/div>\n<\/div>\n<script>\n(function(){\n  var root=document.getElementById('mlx-assistant'); if(!root||root.dataset.ready) return; root.dataset.ready='1';\n  var fab=root.querySelector('.mlx-a-fab'), x=root.querySelector('.mlx-a-x'), ok=root.querySelector('.mlx-a-ok'), next=root.querySelector('.mlx-a-next');\n  var st={area:'',topic:''};\n  function isLive(){ try{ var p=new Intl.DateTimeFormat('en-GB',{timeZone:'Europe\/Berlin',weekday:'short',hour:'numeric',hourCycle:'h23'}).formatToParts(new Date()); var d='',h=0; p.forEach(function(x){ if(x.type==='weekday') d=x.value; if(x.type==='hour') h=+x.value; }); if(d==='Sat'||d==='Sun') return false; return h>=9 ? h<18 : false; }catch(e){ return true; } }\n  function setLive(){ var l=isLive(); root.dataset.live=l?'1':'0'; root.querySelector('.mlx-a-off').hidden=l; }\n  setLive(); setInterval(setLive,60000);\n  function base(){ var m=location.pathname.match(\/^\\\/(de|tr|uk|ru)(\\\/|$)\/); return m?'\/'+m[1]:''; }\n  function show(id){ root.querySelectorAll('.mlx-a-step').forEach(function(s){ s.classList.toggle('on', s.dataset.step===id); }); var b=root.querySelector('.mlx-a-body'); b.scrollTop=0; }\n  function open(v){ root.dataset.open=v?'1':''; fab.setAttribute('aria-expanded', v?'true':'false'); if(v) show(root.querySelector('.mlx-a-step.on').dataset.step); else fab.focus(); }\n  fab.addEventListener('click',function(){ open(true); });\n  x.addEventListener('click',function(){ open(false); });\n  document.addEventListener('keydown',function(e){ if(e.key==='Escape'){ if(root.dataset.open) open(false); } });\n  root.querySelectorAll('[data-area]').forEach(function(b){ b.addEventListener('click',function(){ st.area=b.dataset.area; show(st.area==='Health'?'2h':'2t'); }); });\n  root.querySelectorAll('[data-topic]').forEach(function(b){ b.addEventListener('click',function(){\n    st.topic=b.dataset.topic; root.querySelector('[data-out=\"choice\"]').textContent=b.textContent.trim();\n    root.querySelector('.mlx-a-hnote').style.display = st.area==='Health'?'':'none'; show('3'); }); });\n  root.querySelectorAll('[data-go]').forEach(function(b){ b.addEventListener('click',function(){ var g=b.dataset.go; if(g==='2') g=st.area==='Health'?'2h':'2t'; if(g==='1'){ ok.checked=false; next.disabled=true; } show(g); }); });\n  ok.addEventListener('change',function(){ next.disabled=!ok.checked; });\n  next.addEventListener('click',function(){\n    if(!ok.checked) return;\n    var label=st.area+' \u2013 '+st.topic;\n    var wa='https:\/\/wa.me\/'+root.dataset.wa+'?text='+encodeURIComponent('Hello MedLuxLife, I am interested in: '+label+'.');\n    root.querySelector('[data-ch=\"wa\"]').href=wa;\n    root.querySelector('[data-ch=\"form\"]').href=base()+'\/contact\/?enquiry='+encodeURIComponent(st.area)+String.fromCharCode(38)+'topic='+encodeURIComponent(st.topic)+'#contact';\n    root.querySelector('[data-ch=\"mail\"]').href='mailto:info@medluxlife.de?subject='+encodeURIComponent('Enquiry: '+label);\n    show('4'); });\n  root.querySelectorAll('.mlx-a-consent a').forEach(function(a){ a.setAttribute('href', base()+a.getAttribute('href')); });\n  \/\/ Prefill the contact form when arriving from the assistant\n  var q=new URLSearchParams(location.search), area=q.get('enquiry'), topic=q.get('topic');\n  if(area){ var tries=0; (function fill(){ var sel=document.querySelector('form.wpcf7-form select[name=\"your-subject\"]');\n    if(!sel){ if(++tries<20) setTimeout(fill,250); return; }\n    if(area==='Health'||area==='Travel'){ sel.value=area; sel.dispatchEvent(new Event('change',{bubbles:true})); }\n    var msg=document.querySelector('form.wpcf7-form textarea[name=\"your-message\"]');\n    if(msg){ if(!msg.value){ if(topic){ msg.value='I am interested in: '+topic+String.fromCharCode(10,10); } } } })(); }\n})();\n<\/script>\n<\/div>\n\n<!-- \/wp:html -->\n","block_version":1},"slug":"footer","source":"custom","origin":"theme","type":"wp_template_part","description":"Added by Launch","title":{"raw":"Footer","rendered":"Footer"},"status":"publish","wp_id":19,"has_theme_file":true,"author":1,"area":"footer","modified":"2026-10-07T17:11:34","date":"2026-09-23T13:29:40","author_text":"Extendable","original_source":"theme","_links":{"self":[{"href":"https:\/\/medluxlife.de\/wp-json\/wp\/v2\/template-parts\/extendable\/\/footer","targetHints":{"allow":["GET","POST","PUT","PATCH","DELETE"]}}],"collection":[{"href":"https:\/\/medluxlife.de\/wp-json\/wp\/v2\/template-parts"}],"about":[{"href":"https:\/\/medluxlife.de\/wp-json\/wp\/v2\/types\/wp_template_part"}],"version-history":[{"count":11,"href":"https:\/\/medluxlife.de\/wp-json\/wp\/v2\/template-parts\/extendable\/\/footer\/revisions"}],"predecessor-version":[{"id":636,"href":"https:\/\/medluxlife.de\/wp-json\/wp\/v2\/template-parts\/extendable\/\/footer\/revisions\/636"}],"wp:action-publish":[{"href":"https:\/\/medluxlife.de\/wp-json\/wp\/v2\/template-parts\/extendable\/\/footer"}],"wp:action-unfiltered-html":[{"href":"https:\/\/medluxlife.de\/wp-json\/wp\/v2\/template-parts\/extendable\/\/footer"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}